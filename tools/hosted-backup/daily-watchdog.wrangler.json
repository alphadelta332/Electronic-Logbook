{
  "name": "flightlogx-backup-watchdog",
  "main": "daily-watchdog-worker.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "WATCHDOG_ENABLED": "false" },
  "durable_objects": { "bindings": [{ "name": "MISSING_MONITOR", "class_name": "MissingMonitorGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MissingMonitorGuard"] }],
  "observability": { "enabled": false }
}
