<Window x:Class="ElectronicLogbook.Updater.Wizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Electronic Logbook Updater"
        Height="540"
        Width="760"
        MinHeight="520"
        MinWidth="720"
        Icon="Assets/icon.png"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#D0D7DE" Padding="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Electronic Logbook Update Wizard" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="StepHeaderText" Margin="0,6,0,0" FontSize="14" Foreground="#4B5563" Text="Step 1 of 6" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" x:Name="WelcomePanel">
                <TextBlock Text="Welcome" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="This wizard creates a separate updated workbook. Your source workbook is never overwritten." />
                <TextBlock Margin="0,16,0,0" x:Name="InstalledVersionText" Text="Installed version: unknown" />
                <TextBlock Margin="0,6,0,0" x:Name="LatestVersionText" Text="Update channel: checking..." />
                <TextBlock Margin="0,6,0,0" x:Name="LastCheckedText" Text="Last checked: never" />
                <TextBlock Margin="0,6,0,0" x:Name="PortableLogbookStatusText" Text="Portable logbook: checking..." />
                <TextBlock Margin="0,16,0,0" Text="Portable logbook actions" FontWeight="SemiBold" />
                <UniformGrid Margin="0,8,0,0" Rows="2" Columns="4">
                    <Button Margin="0,0,8,8"
                            x:Name="PortableEnableButton"
                            Content="Enable"
                            Click="PortableEnableButton_OnClick" />
                    <Button Margin="0,0,8,8"
                            x:Name="PortableExportButton"
                            Content="Export Package"
                            Click="PortableExportButton_OnClick" />
                    <Button Margin="0,0,8,8"
                            x:Name="PortableImportButton"
                            Content="Import Package"
                            Click="PortableImportButton_OnClick" />
                    <Button Margin="0,0,0,8"
                            x:Name="PortablePrintedCopyButton"
                            Content="Printed Copy"
                            Click="PortablePrintedCopyButton_OnClick" />
                    <Button Margin="0,0,8,0"
                            x:Name="PortableRevisionHistoryButton"
                            Content="Revision History"
                            Click="PortableRevisionHistoryButton_OnClick" />
                    <Button Margin="0,0,8,0"
                            x:Name="PortableResolveConflictButton"
                            Content="Resolve Conflict"
                            Click="PortableResolveConflictButton_OnClick" />
                    <Button Margin="0,0,8,0"
                            x:Name="PortableRefreshStatusButton"
                            Content="Refresh Status"
                            Click="PortableRefreshStatusButton_OnClick" />
                </UniformGrid>
            </StackPanel>

            <StackPanel Grid.Row="0" x:Name="AvailablePanel" Visibility="Collapsed">
                <TextBlock Text="Update Available" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" x:Name="AvailableVersionText" Text="A newer version is available." />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="The updater will create a separate updated workbook and keep your original workbook unchanged." />
                <ScrollViewer Margin="0,12,0,0"
                              MaxHeight="250"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ReleaseSummaryText"
                               TextWrapping="Wrap"
                               Text="Release notes unavailable." />
                </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Row="0" x:Name="PreflightPanel" Visibility="Collapsed">
                <TextBlock Text="Preflight Checks" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="All checks must pass before update starts." />
                <UniformGrid Margin="0,14,0,0" Rows="4" Columns="1">
                    <TextBlock x:Name="CheckSourcePathText" Text="[ ] Source workbook path" />
                    <TextBlock x:Name="CheckOutputPathText" Text="[ ] Output path and write access" />
                    <TextBlock x:Name="CheckMasterOrRepoText" Text="[ ] Update channel availability" />
                    <TextBlock x:Name="CheckDiskText" Text="[ ] Disk space" />
                </UniformGrid>
                <TextBlock Margin="0,8,0,0" x:Name="PreflightSummaryText" Text="Checks have not run yet." />
            </StackPanel>

            <StackPanel Grid.Row="0" x:Name="ReadyPanel" Visibility="Collapsed">
                <TextBlock Text="Ready to Update" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Click Start to begin the update." />
                <CheckBox Margin="0,12,0,0" x:Name="DetailedLoggingCheckBox" Content="Write local redacted diagnostic report beside output workbook" IsChecked="False" />
            </StackPanel>

            <StackPanel Grid.Row="0" x:Name="UpdatingPanel" Visibility="Collapsed">
                <TextBlock Text="Updating" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" x:Name="UpdatingPhaseText" Text="Waiting to start..." />
                <Border Margin="0,10,0,0" Padding="10" CornerRadius="4" Background="#FFF8E1" BorderBrush="#EAB308" BorderThickness="1">
                    <TextBlock TextWrapping="Wrap" Foreground="#7C2D12" FontWeight="SemiBold"
                               Text="Warning: Do not use the clipboard while the logbook is updating." />
                </Border>
                <ProgressBar Margin="0,12,0,0" Height="16" x:Name="UpdateProgressBar" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0" />
                <TextBox Margin="0,12,0,0" x:Name="UpdateLogTextBox" Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True" />
            </StackPanel>

            <StackPanel Grid.Row="0" x:Name="CompletePanel" Visibility="Collapsed">
                <TextBlock Text="Complete" FontSize="20" FontWeight="SemiBold" x:Name="CompleteTitleText" />
                <TextBlock Margin="0,8,0,0" x:Name="CompleteSummaryText" TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,0" x:Name="CompleteOutputPathText" TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0" x:Name="CompleteBackupPathText" TextWrapping="Wrap" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button Width="140"
                            x:Name="RestoreBackupButton"
                            Content="Restore Backup"
                            IsEnabled="False"
                            Click="RestoreBackupButton_OnClick" />
                    <Button Width="160"
                            Margin="10,0,0,0"
                            x:Name="OpenDiagnosticReportButton"
                            Content="Open Redacted Report"
                            IsEnabled="False"
                            Click="OpenDiagnosticReportButton_OnClick" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0"
                           x:Name="DiagnosticReportNoticeText"
                           TextWrapping="Wrap"
                           Text="Diagnostic reports stay on this device. Open and review the exact redacted report before sharing it." />
                <CheckBox Margin="0,14,0,0" x:Name="OpenUpdatedCheckBox" Content="Open updated workbook when I click Finish" IsChecked="True" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,20,0,0" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" />

        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" x:Name="FooterStatusText" Text="Ready" />
            <Button Grid.Column="1" Width="100" Margin="10,0,0,0" x:Name="BackButton" Content="Back" Click="BackButton_OnClick" />
            <Button Grid.Column="2" Width="100" Margin="10,0,0,0" x:Name="NextButton" Content="Next" Click="NextButton_OnClick" />
            <Button Grid.Column="3" Width="100" Margin="10,0,0,0" x:Name="CancelButton" Content="Cancel" Click="CancelButton_OnClick" />
        </Grid>
    </Grid>
</Window>
