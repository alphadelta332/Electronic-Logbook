# Keep the default Graphify map focused on hand-authored product architecture.
# Syntax matches .gitignore; Graphify also respects .gitignore automatically.

# Graphify output and local agent state
graphify-out/
.graphify-memory/
.codex/
.claude/

# Build, package, and dependency output
**/bin/
**/obj/
**/TestResults/
mobile/node_modules/
mobile/artifacts/
updater/dist/

# Generated mobile runtime and publish/sync output
mobile/android/app/src/main/assets/public/
mobile/src/ElectronicLogbook.Mobile/wwwroot/_framework/
mobile/src/ElectronicLogbook.Mobile/wwwroot/service-worker.published.js
*.min.js

# Tests are useful for validation, but they dominate the architecture graph and
# tend to steer planning toward hardening instead of product gates.
**/tests/
*Tests.cs
*.Tests.csproj
*.sln

# Operational automation is maintained source, but it obscures the product's
# runtime boundaries in the default architecture map.
.github/
tools/
mobile/scripts/
updater/*.ps1
/PrepareForRelease.ps1
/PrepareForTesting.ps1

# Keep prose and local launch profiles out of the default code-only map. The
# architecture workflow remains tracked guidance rather than graph input.
*.md
**/Properties/launchSettings.json

# Binary and rendered artifacts are not useful architecture inputs.
*.xlsm
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.zip
*.jar

# Large/generated package metadata
mobile/package-lock.json
