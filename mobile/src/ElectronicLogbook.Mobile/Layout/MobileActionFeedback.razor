@implements IAsyncDisposable
@inject MobileLogbookSession Session
@inject NavigationManager Navigation

@if (AnimationState != ActionFeedbackAnimation.Hidden && !string.IsNullOrWhiteSpace(DisplayedMessage))
{
    <section @key="FeedbackVersion"
             class="action-feedback-message @AnimationClass @(ShowCelebration ? "action-feedback-message-success" : null)"
             role="status"
             aria-live="polite"
             aria-atomic="true">
        <div class="action-feedback-content">
            @if (ShowCelebration)
            {
                <span class="action-feedback-confirmation" aria-hidden="true">
                    <span class="action-feedback-confirmation-ring"></span>
                    <svg viewBox="0 0 40 40" focusable="false">
                        <circle class="action-feedback-confirmation-disc" cx="20" cy="20" r="18" />
                        <path class="action-feedback-confirmation-check" d="M12 20.5 17.2 26 28.5 14.5" />
                    </svg>
                    <span class="action-feedback-confirmation-spark action-feedback-confirmation-spark-one"></span>
                    <span class="action-feedback-confirmation-spark action-feedback-confirmation-spark-two"></span>
                    <span class="action-feedback-confirmation-spark action-feedback-confirmation-spark-three"></span>
                </span>
            }
            <span class="action-feedback-copy">@DisplayedMessage</span>
        </div>
        @if (ShowUndo)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       OnClick="UndoAsync"
                       Disabled="@(IsUndoPending || AnimationState == ActionFeedbackAnimation.Exiting)">
                Undo
            </MudButton>
        }
        else if (!string.IsNullOrWhiteSpace(DisplayedActionLabel) && !string.IsNullOrWhiteSpace(DisplayedActionDestination))
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="FollowAction">
                @DisplayedActionLabel
            </MudButton>
        }
    </section>
}

@code {
    private CancellationTokenSource? feedbackCancellation;
    private ActionFeedbackAnimation AnimationState { get; set; } = ActionFeedbackAnimation.Hidden;
    private string? DisplayedMessage { get; set; }
    private bool ShowUndo { get; set; }
    private bool ShowCelebration { get; set; }
    private string? DisplayedActionLabel { get; set; }
    private string? DisplayedActionDestination { get; set; }
    private bool IsUndoPending { get; set; }
    private int FeedbackVersion { get; set; }
    private string AnimationClass => AnimationState == ActionFeedbackAnimation.Exiting
        ? "action-feedback-message-exit"
        : "action-feedback-message-enter";

    protected override void OnInitialized()
    {
        Session.ActionFeedbackChanged += OnActionFeedbackChanged;
        Session.ExpireActionFeedback();
        ShowLatestFeedback();
    }

    private void OnActionFeedbackChanged()
    {
        _ = InvokeAsync(() =>
        {
            ShowLatestFeedback();
            StateHasChanged();
        });
    }

    private void ShowLatestFeedback()
    {
        feedbackCancellation?.Cancel();
        feedbackCancellation?.Dispose();
        feedbackCancellation = null;

        if (!Session.HasPendingActionFeedback || string.IsNullOrWhiteSpace(Session.ActionFeedbackMessage))
        {
            AnimationState = ActionFeedbackAnimation.Hidden;
            DisplayedMessage = null;
            ShowUndo = false;
            ShowCelebration = false;
            DisplayedActionLabel = null;
            DisplayedActionDestination = null;
            return;
        }

        DisplayedMessage = Session.ActionFeedbackMessage;
        ShowUndo = Session.CanUndoLastWorkbookAction;
        ShowCelebration = Session.ShouldCelebrateActionFeedback;
        DisplayedActionLabel = Session.ActionFeedbackActionLabel;
        DisplayedActionDestination = Session.ActionFeedbackActionDestination;
        AnimationState = ActionFeedbackAnimation.Shown;
        FeedbackVersion++;
        feedbackCancellation = new CancellationTokenSource();
        _ = ExpireFeedbackAsync(feedbackCancellation.Token);
    }

    private async Task UndoAsync()
    {
        if (IsUndoPending)
        {
            return;
        }

        IsUndoPending = true;
        try
        {
            if (await Session.UndoLastWorkbookActionAsync())
            {
                feedbackCancellation?.Cancel();
                await PlayExitAsync(expireFeedback: false, CancellationToken.None);
                Navigation.NavigateTo("/flights?view=entries", replace: true);
            }
        }
        finally
        {
            IsUndoPending = false;
        }
    }

    private void FollowAction()
    {
        if (string.IsNullOrWhiteSpace(DisplayedActionDestination))
        {
            return;
        }

        feedbackCancellation?.Cancel();
        var destination = DisplayedActionDestination;
        Session.DismissActionFeedback();
        Navigation.NavigateTo(destination);
    }

    private async Task ExpireFeedbackAsync(CancellationToken cancellationToken)
    {
        var remaining = Session.ActionFeedbackRemaining;
        if (remaining is null)
        {
            return;
        }

        if (remaining.Value > TimeSpan.Zero)
        {
            try
            {
                await Task.Delay(remaining.Value, cancellationToken);
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }

        await PlayExitAsync(expireFeedback: true, cancellationToken);
    }

    private async Task PlayExitAsync(bool expireFeedback, CancellationToken cancellationToken)
    {
        await InvokeAsync(() =>
        {
            AnimationState = ActionFeedbackAnimation.Exiting;
            StateHasChanged();
        });

        try
        {
            await Task.Delay(240, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            if (expireFeedback)
            {
                Session.ExpireActionFeedback();
            }

            AnimationState = ActionFeedbackAnimation.Hidden;
            DisplayedMessage = null;
            ShowUndo = false;
            ShowCelebration = false;
            DisplayedActionLabel = null;
            DisplayedActionDestination = null;
            StateHasChanged();
        });
    }

    public ValueTask DisposeAsync()
    {
        Session.ActionFeedbackChanged -= OnActionFeedbackChanged;
        feedbackCancellation?.Cancel();
        feedbackCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }

    private enum ActionFeedbackAnimation
    {
        Hidden,
        Shown,
        Exiting
    }
}
