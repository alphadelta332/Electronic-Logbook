@inherits LayoutComponentBase
@implements IDisposable
@inject MobileUiPreferenceState UiPreferences

<MudThemeProvider Theme="@Theme" IsDarkMode="@UiPreferences.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <header class="app-topbar">
        <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Size="Size.Medium" />
        <div class="brand-lockup">
            <strong>LogbookOne</strong>
            <span>Portable operations</span>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <nav class="bottom-nav" aria-label="Primary">
        <NavLink href="/" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" />
            <span>Dashboard</span>
        </NavLink>
        <NavLink href="/flights">
            <MudIcon Icon="@Icons.Material.Filled.ListAlt" />
            <span>Logbook</span>
        </NavLink>
        <NavLink href="/settings">
            <MudIcon Icon="@Icons.Material.Filled.Settings" />
            <span>Settings</span>
        </NavLink>
    </nav>
</div>

@code {
    private readonly MudTheme Theme = MobileTheme.Create();

    protected override async Task OnInitializedAsync()
    {
        UiPreferences.Changed += OnUiPreferencesChanged;
        await UiPreferences.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        UiPreferences.Changed -= OnUiPreferencesChanged;
    }

    private void OnUiPreferencesChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
