@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject MobileLogbookSession Session
@inject MobileUiPreferenceState UiPreferences

<MudThemeProvider Theme="@Theme" IsDarkMode="@UiPreferences.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<PreviewChangelogDialog />

<div class="app-shell">
    <header class="app-topbar">
        <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Size="Size.Medium" />
        <div class="brand-lockup">
            <strong>FlightLogX</strong>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <MobileActionFeedback />

    <nav class="bottom-nav" aria-label="Primary" aria-busy="@IsNavigationPending">
        <NavLink href="/" Match="NavLinkMatch.All" aria-label="Dashboard" class="@NavPendingClass(DashboardNavigationLabel)" @onclick="ShowDashboardNavigationPending">
            <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" />
            <span>Home</span>
        </NavLink>
        <PathOnlyNavLink Href="/flights" aria-label="Logbook" Class="@NavPendingClass(LogbookNavigationLabel)" @onclick="ShowLogbookNavigationPending">
            <MudIcon Icon="@Icons.Material.Filled.ListAlt" />
            <span>Logbook</span>
        </PathOnlyNavLink>
        <NavLink href="/flights/new" class="@NavPendingClass(NewFlightNavigationLabel, AddNavigationClass)" aria-label="New flight" @onclick="ShowNewFlightNavigationPending">
            <span class="bottom-nav-add-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Add" />
            </span>
            <span>New</span>
        </NavLink>
        <NavLink href="/currency" aria-label="Currency" class="@NavPendingClass(CurrencyNavigationLabel)" @onclick="ShowCurrencyNavigationPending">
            <MudIcon Icon="@Icons.Material.Filled.FactCheck" />
            <span>Currency</span>
        </NavLink>
        <NavLink href="/more" aria-label="More" aria-current="@(IsMoreSelected ? "page" : null)" class="@NavPendingClass(MoreNavigationLabel, IsMoreSelected ? "active" : null)" @onclick="ShowMoreNavigationPending">
            <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" />
            <span>More</span>
        </NavLink>
        @if (IsNavigationPending)
        {
            <span class="visually-hidden" role="status" aria-live="polite">Opening @PendingNavigationLabel</span>
        }
    </nav>
</div>

@code {
    private const string DashboardNavigationLabel = "Dashboard";
    private const string LogbookNavigationLabel = "Logbook";
    private const string NewFlightNavigationLabel = "New flight";
    private const string CurrencyNavigationLabel = "Currency";
    private const string MoreNavigationLabel = "More";
    private const string AddNavigationClass = "bottom-nav-add";

    private static readonly string[] MoreNavigationPaths = ["/more", "/settings", "/charts", "/routes"];

    private readonly MudTheme Theme = MobileTheme.Create();
    private CancellationTokenSource? navigationFeedbackCancellation;
    private DotNetObjectReference<MainLayout>? networkRestoredCallback;
    private int? networkRestoredSubscriptionId;
    private bool IsNavigationPending { get; set; }
    private string PendingNavigationLabel { get; set; } = "page";

    protected override async Task OnInitializedAsync()
    {
        UiPreferences.Changed += OnUiPreferencesChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Session.WorkbookStateChanged += OnWorkbookStateChanged;
        await UiPreferences.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        networkRestoredCallback = DotNetObjectReference.Create(this);
        try
        {
            networkRestoredSubscriptionId = await JS.InvokeAsync<int>(
                "electronicLogbookNetwork.subscribe",
                networkRestoredCallback);
        }
        catch (JSException)
        {
            networkRestoredCallback.Dispose();
            networkRestoredCallback = null;
        }
    }

    [JSInvokable]
    public async Task HandleNetworkRestoredAsync()
    {
        if (!Session.IsLoaded)
        {
            return;
        }

        await Session.SyncHostedAfterNetworkRestoredAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        navigationFeedbackCancellation?.Cancel();
        navigationFeedbackCancellation?.Dispose();
        UiPreferences.Changed -= OnUiPreferencesChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        Session.WorkbookStateChanged -= OnWorkbookStateChanged;

        if (networkRestoredSubscriptionId is int subscriptionId)
        {
            try
            {
                await JS.InvokeVoidAsync("electronicLogbookNetwork.unsubscribe", subscriptionId);
            }
            catch (JSException)
            {
            }
        }

        networkRestoredCallback?.Dispose();
    }

    private void OnUiPreferencesChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnWorkbookStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ShowNavigationPending(string label, string targetPath)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        var normalizedTarget = targetPath.Trim('/');
        if (string.Equals(currentPath, normalizedTarget, StringComparison.OrdinalIgnoreCase))
        {
            IsNavigationPending = false;
            return;
        }

        PendingNavigationLabel = label;
        IsNavigationPending = true;
    }

    private void ShowDashboardNavigationPending() => ShowNavigationPending(DashboardNavigationLabel, "/");

    private void ShowLogbookNavigationPending() => ShowNavigationPending(LogbookNavigationLabel, "/flights");

    private void ShowNewFlightNavigationPending() => ShowNavigationPending(NewFlightNavigationLabel, "/flights/new");

    private void ShowCurrencyNavigationPending() => ShowNavigationPending(CurrencyNavigationLabel, "/currency");

    private void ShowMoreNavigationPending() => ShowNavigationPending(MoreNavigationLabel, "/more");

    private bool IsMoreSelected => MoreNavigationPaths.Contains(
        Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/'),
        StringComparer.OrdinalIgnoreCase);

    private string? NavPendingClass(string label, string? baseClass = null)
    {
        var pendingClass = IsNavigationPending && string.Equals(PendingNavigationLabel, label, StringComparison.Ordinal)
            ? "nav-pending-link"
            : null;

        return string.Join(" ", new[] { baseClass, pendingClass }.Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = ScrollMainToTopAsync();

        if (!IsNavigationPending)
        {
            return;
        }

        navigationFeedbackCancellation?.Cancel();
        navigationFeedbackCancellation?.Dispose();
        navigationFeedbackCancellation = new CancellationTokenSource();
        _ = CompleteNavigationFeedbackAsync(navigationFeedbackCancellation.Token);
    }

    private async Task ScrollMainToTopAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("electronicLogbookNavigation.scrollMainToTop");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task CompleteNavigationFeedbackAsync(CancellationToken cancellationToken)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Delay(250, cancellationToken);
            IsNavigationPending = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }
}
