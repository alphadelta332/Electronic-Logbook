<section class="analytics-chart" aria-label="@Title">
    <h2>@Title</h2>
    @if (Values.Count == 0)
    {
        <p>No resolved airports in this selection.</p>
    }
    else
    {
        <AnalyticsPlot Title="@Title" Data="plot" Height="@(Math.Max(120, Values.Count * 48 + 20))" />
        <ol class="visually-hidden" aria-label="@Title">
            @foreach (var value in Values)
            {
                <li>
                    <div><span>@value.Name</span><strong>@Format(value.Value)@(Counts ? " visits" : "")</strong></div>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<MobileAnalyticsValue> Values { get; set; } = [];
    [Parameter] public bool Counts { get; set; }
    private MobileAnalyticsPlotData plot = new("ranking", [], []);
    protected override void OnParametersSet() => plot = new("ranking", Values.Select(value => value.Name).ToArray(),
        [new(Title, Values.Select(value => value.Value).ToArray(), "")], Counts);
    private string Format(decimal value) => Counts ? value.ToString("0") : MobileLogbookSession.FormatHours(value);
}
