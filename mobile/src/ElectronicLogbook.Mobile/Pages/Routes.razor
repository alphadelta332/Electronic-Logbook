@page "/routes"

<PageTitle>Routes | LogbookOne</PageTitle>

<section class="future-feature-page" aria-labelledby="routes-heading">
    <header class="entry-header">
        <div>
            <span class="eyebrow">Future feature</span>
            <h1 id="routes-heading">Route map</h1>
        </div>
        <span class="draft-pill">Coming soon</span>
    </header>

    <section class="future-feature-hero" aria-label="Route map preview">
        <span class="future-feature-icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Route" />
        </span>
        <div>
            <strong>Your flying, mapped</strong>
            <p>Explore the routes and airports in your logbook on an interactive map.</p>
        </div>
    </section>

    <section class="notice-panel">
        <MudIcon Icon="@Icons.Material.Filled.Schedule" />
        <div>
            <strong>Planned after the first release</strong>
            <span>This page reserves a home for route mapping without presenting the feature as available today.</span>
        </div>
    </section>
</section>
