@page "/routes"
@inject MobileLogbookSession Session
@inject TimeProvider Clock
@implements IDisposable

<PageTitle>Route Map | FlightLogX</PageTitle>

<section class="routes-page" aria-labelledby="routes-heading">
    <div class="routes-heading">
        <h1 id="routes-heading">Route map</h1>
        @if (Session.IsLoaded && !Session.IsStorageBlocked)
        {
            <FilterToggleButton Count="@FilterCount" @bind-Expanded="showFilters" />
        }
    </div>
    @if (!Session.IsLoaded)
    {
        <section class="ui-state" role="status"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>Loading route map</span></section>
    }
    else if (Session.IsStorageBlocked)
    {
        <MudAlert Severity="Severity.Error">@Session.StorageError</MudAlert>
    }
    else
    {
        <div class="routes-filter-panel" hidden="@(!showFilters)">
            <div class="routes-filters" aria-label="Route map filters">
                <div class="date-range-fields">
                    <label>Start date<input id="routes-from" type="date" max="@to?.ToString("yyyy-MM-dd")" @bind="from" @bind:after="Recalculate" /></label>
                    <label>End date<input id="routes-to" type="date" min="@from?.ToString("yyyy-MM-dd")" @bind="to" @bind:after="Recalculate" /></label>
                </div>
                <MudSelect T="string" Label="Aircraft type" Placeholder="All types" MultiSelection="true" SelectAll="true" Clearable="true"
                           Variant="Variant.Outlined" SelectedValues="aircraftTypes" SelectedValuesChanged="SetAircraftTypes" Comparer="StringComparer.OrdinalIgnoreCase">
                    @foreach (var value in types) { <MudSelectItem T="string" Value="@value">@value</MudSelectItem> }
                </MudSelect>
                <MudSelect T="string" Label="Registration" Placeholder="All registrations" MultiSelection="true" SelectAll="true" Clearable="true"
                           Variant="Variant.Outlined" SelectedValues="selectedRegistrations" SelectedValuesChanged="SetRegistrations" Comparer="StringComparer.OrdinalIgnoreCase">
                    @foreach (var value in registrations) { <MudSelectItem T="string" Value="@value">@value</MudSelectItem> }
                </MudSelect>
            </div>
        </div>
        @if (FilterCount > 0)
        {
            <div class="routes-filter-summary" role="status">
                <span>@(aircraftTypes.Length == 0 ? "All types" : string.Join(", ", aircraftTypes)) · @(selectedRegistrations.Length == 0 ? "All registrations" : string.Join(", ", selectedRegistrations))
                    @if (from is not null) { <span> · From @from.Value.ToString("d MMM yyyy")</span> }
                    @if (to is not null) { <span> · To @to.Value.ToString("d MMM yyyy")</span> }
                </span>
                <MudButton OnClick="ClearFilters" Variant="Variant.Text" Color="Color.Primary">Clear filters</MudButton>
            </div>
        }
        @if (filterError is not null)
        {
            <MudAlert Severity="Severity.Error" role="alert">@filterError</MudAlert>
        }
        else if (map is not null)
        {
            @if (map.Markers.Count > 0)
            {
                <div class="route-map-panel">
                    <div class="route-map-toolbar"><MudIconButton OnClick="ShowAllAsync" Icon="@Icons.Material.Filled.ZoomOutMap" Variant="Variant.Outlined" aria-label="Show all routes" /></div>
                    <RouteMapCanvas @ref="canvas" Data="map" />
                </div>
            }
            else
            {
                <p class="ui-state">@(map.Flights.Count == 0 ? "No flights match this selection." : "No recognised airports in this selection.")</p>
            }
        }
    }
</section>

@code {
    private DateOnly? from;
    private DateOnly? to;
    private string[] aircraftTypes = [], selectedRegistrations = [], types = [], registrations = [];
    private bool showFilters, disposed;
    private string? filterError;
    private MobileRouteMap? map;
    private RouteMapCanvas? canvas;
    private ITimer? dateTimer;
    private DateOnly calculatedDate;
    private DateOnly LocalToday => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
    private int FilterCount => (from is not null || to is not null ? 1 : 0) + (aircraftTypes.Length > 0 ? 1 : 0) + (selectedRegistrations.Length > 0 ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
        if (disposed) return;
        Session.WorkbookStateChanged += OnWorkbookStateChanged;
        MobileAirportCatalog.Default.Changed += OnWorkbookStateChanged;
        Refresh();
        dateTimer = Clock.CreateTimer(_ => OnDateTick(), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private void OnWorkbookStateChanged() => _ = InvokeAsync(() => { if (!disposed) { Refresh(); StateHasChanged(); } });
    private void OnDateTick() => _ = InvokeAsync(() => { if (!disposed && calculatedDate != LocalToday) { Recalculate(); StateHasChanged(); } });
    private void Refresh()
    {
        types = Choices(entry => entry.Type, aircraftTypes);
        registrations = Choices(entry => entry.Reg, selectedRegistrations);
        Recalculate();
    }
    private string[] Choices(Func<PortableLogbookWorkbookEntry, string?> select, string[] selected) => Session.CurrentEntriesV2
        .Where(item => item.Entry is not null).Select(item => select(item.Entry!)).Concat(selected)
        .Where(value => !string.IsNullOrWhiteSpace(value)).Select(value => value!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();
    private void SetAircraftTypes(IEnumerable<string> values) { aircraftTypes = values.ToArray(); Recalculate(); }
    private void SetRegistrations(IEnumerable<string> values) { selectedRegistrations = values.ToArray(); Recalculate(); }
    private void ClearFilters() { from = to = null; aircraftTypes = selectedRegistrations = []; Recalculate(); }
    private void Recalculate()
    {
        map = null;
        filterError = null;
        calculatedDate = LocalToday;
        if (Session.IsStorageBlocked) return;
        if (from > to) { filterError = "Choose a Start date on or before the End date."; return; }
        map = MobileRouteMap.Create(Session.CurrentEntriesV2, new(from, to, aircraftTypes, selectedRegistrations), calculatedDate, MobileAirportCatalog.Default);
    }
    private Task ShowAllAsync() => canvas?.ShowAllAsync() ?? Task.CompletedTask;

    public void Dispose()
    {
        disposed = true;
        Session.WorkbookStateChanged -= OnWorkbookStateChanged;
        MobileAirportCatalog.Default.Changed -= OnWorkbookStateChanged;
        dateTimer?.Dispose();
    }
}
