@page "/"
@inject MobileLogbookSession Session

<PageTitle>LogbookOne</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading device copy</span>
    </section>
}
else
{
    <section class="dashboard-page">
        @if (!string.IsNullOrWhiteSpace(Session.StorageError))
        {
            <section class="state-banner state-banner-error" role="alert">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
                <span>@Session.StorageError</span>
            </section>
        }

        <section class="status-strip dashboard-metrics" aria-label="Flight activity">
            <article class="status-metric dashboard-total-hours">
                <span>Total hours</span>
                <strong>@MobileLogbookSession.FormatHours(TotalFlyingHours)</strong>
                <small>logged</small>
            </article>
            <article class="status-metric">
                <span>Last 90 days</span>
                <strong>@RecentFlightCount</strong>
                <small>@RecentHoursDetail</small>
            </article>
        </section>

        <section class="notice-panel dashboard-last-flight" aria-label="Last flight context">
            <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" />
            <div>
                <strong>Last flight</strong>
                @if (LastFlight is null)
                {
                    <span>Import a package or add a flight to build the device record.</span>
                }
                else
                {
                    <LogbookFlightRow Entry="@LastFlight" />
                }
                <span>@RecentSnapshotDetail</span>
            </div>
        </section>

        <section class="dashboard-section dashboard-currency" aria-label="VFR and IFR Currency + Recency">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Currency + Recency</span>
                    <h2>VFR and IFR status</h2>
                </div>
                <MudButton Href="/currency" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward">Currency</MudButton>
            </div>

            <div class="dashboard-currency-grid">
                <section class="dashboard-currency-card" aria-label="VFR currency status">
                    <strong>VFR</strong>
                    <CurrencyRowList Rows="@VfrCurrencyRows" />
                    <MudButton Href="/currency" Variant="Variant.Text">View VFR Currency + Recency</MudButton>
                </section>
                <section class="dashboard-currency-card" aria-label="IFR currency status">
                    <strong>IFR</strong>
                    <CurrencyRowList Rows="@IfrCurrencyRows" />
                    <MudButton Href="/currency" Variant="Variant.Text">View IFR Currency + Recency</MudButton>
                </section>
            </div>
        </section>

        @if (Session.CurrentEntriesV2.Count == 0)
        {
            <section class="empty-state dashboard-empty-state" aria-label="No flights yet">
                <MudIcon Icon="@Icons.Material.Filled.Flight" />
                <strong>Your device logbook is ready</strong>
                <span>Add the first flight or import an encrypted workbook package from Settings.</span>
                <div class="action-buttons">
                    <MudButton Href="/flights/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Add first flight</MudButton>
                    <MudButton Href="/settings" Variant="Variant.Outlined">Open Settings</MudButton>
                </div>
            </section>
        }
    </section>
}

@code {
    private DateOnly RecentCutoff => DateOnly.FromDateTime(DateTime.Today.AddDays(-90));

    private PortableLogbookMaterializedEntryV2? LastFlight => Session.CurrentEntriesV2.FirstOrDefault();

    private decimal TotalFlyingHours =>
        Session.CurrentEntriesV2.Sum(entry => MobileLogbookSession.WorkbookLoggedTime(entry.Entry!));

    private IReadOnlyList<PortableLogbookMaterializedEntryV2> RecentEntries =>
        Session.CurrentEntriesV2
            .Where(entry => entry.Entry!.Date >= RecentCutoff)
            .ToArray();

    private int RecentFlightCount => RecentEntries.Count;

    private decimal RecentFlyingHours =>
        RecentEntries.Sum(entry => MobileLogbookSession.WorkbookLoggedTime(entry.Entry!));

    private string RecentHoursDetail =>
        $"{MobileLogbookSession.FormatHours(RecentFlyingHours)} hr";

    private string RecentSnapshotDetail =>
        Session.CurrentEntriesV2.Count == 0
            ? "90-day snapshot will appear after the first dated entry."
            : $"{FormatCount(RecentFlightCount, "flight")}, {MobileLogbookSession.FormatHours(RecentFlyingHours)} hr in the last 90 days.";

    private static string FormatCount(int count, string singular) =>
        $"{count} {singular}{(count == 1 ? string.Empty : "s")}";

    private MobileCurrencyRecencySummary CurrencySummary => MobileCurrencyRecencySummary.Create(
        Session.CurrentEntriesV2.Select(materialized => materialized.Entry!),
        Session.DocumentV2.CurrencyOverrideDates,
        DateOnly.FromDateTime(DateTime.Today));

    private IReadOnlyList<PortableLogbookCurrencyRow> VfrCurrencyRows =>
        CurrencySummary.SingleEngineRows
            .Where(row => row.Requirement == "Passenger Carrying")
            .ToArray();

    private IReadOnlyList<PortableLogbookCurrencyRow> IfrCurrencyRows =>
        CurrencySummary.SingleEngineRows
            .Where(row => row.Category is "IFR (Apps)" or "Single Pilot IFR")
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
    }

}
