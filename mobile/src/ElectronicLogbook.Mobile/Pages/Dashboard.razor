@page "/"
@inject MobileLogbookSession Session
@inject NavigationManager Navigation

<PageTitle>LogbookOne</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading device copy</span>
    </section>
}
else
{
    <section class="dashboard-page">
        @if (!string.IsNullOrWhiteSpace(Session.StorageError))
        {
            <section class="state-banner state-banner-error" role="alert">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
                <span>@Session.StorageError</span>
            </section>
        }

        <section class="hero-panel">
            <div>
                <span class="eyebrow">Next action</span>
                <h1>Add today's flight</h1>
                <p>@NextActionDetail</p>
            </div>
            <MudButton Href="/flights/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                Add flight
            </MudButton>
        </section>

        <section class="status-strip" aria-label="Operational status">
            <StatusMetric Label="Total hours" Value="@MobileLogbookSession.FormatHours(TotalFlyingHours)" Detail="logged" />
            <StatusMetric Label="Last 90 days" Value="@RecentFlightCount.ToString()" Detail="@RecentHoursDetail" />
            <StatusMetric Label="Entries" Value="@Session.CurrentEntriesV2.Count.ToString()" Detail="current record" />
            <StatusMetric Label="Package key" Value="@Session.PackageKeyStatus" Detail="device readiness" Attention="@(Session.PackageKeyStatus != "Ready")" />
        </section>

        <section class="notice-panel dashboard-last-flight" aria-label="Last flight context">
            <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" />
            <div>
                <strong>@LastFlightTitle</strong>
                <span>@LastFlightDetail</span>
                <span>@RecentSnapshotDetail</span>
            </div>
        </section>

        <section class="notice-panel dashboard-record-health" aria-label="Record health">
            <MudIcon Icon="@RecordHealthIcon" />
            <div>
                <strong>@RecordHealthTitle</strong>
                <span>@RecordHealthReason</span>
            </div>
        </section>

        <section class="notice-panel">
            <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" />
            <div>
                <strong>Package health</strong>
                <span>@Session.ExchangeStatus.BackupNotice</span>
                <span>@Session.PackageKeyNotice</span>
            </div>
        </section>

        <section class="dashboard-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Recent flights</span>
                    <h2>Current record</h2>
                </div>
                <MudButton Href="/flights" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward">Logbook</MudButton>
            </div>

            @if (Session.CurrentEntriesV2.Count == 0)
            {
                <section class="empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.Flight" />
                    <strong>No flights on this device yet</strong>
                    <span>Import a package or start with a new local entry.</span>
                </section>
            }
            else
            {
                <div class="flight-row-list">
                    @foreach (var entry in Session.CurrentEntriesV2.Take(5))
                    {
                        <article class="flight-row">
                            <div class="route-code">
                                <strong>@Session.FormatRoute(entry.Entry!)</strong>
                                <span>@MobileLogbookSession.FormatDate(entry.Entry!.Date)</span>
                            </div>
                            <div>
                                <strong>@Session.FormatAircraft(entry.Entry!)</strong>
                                <span>@MobileLogbookSession.FormatHours(MobileLogbookSession.WorkbookLoggedTime(entry.Entry!)) hr total</span>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary" OnClick="@(() => CloneEntry(entry.Entry!))" aria-label="Clone flight" />
                        </article>
                    }
                </div>
            }
        </section>

        <section class="exchange-summary">
            <span>Last import: @MobileLogbookSession.FormatTimestamp(Session.ExchangeStatus.LastSuccessfulImportAt)</span>
            <span>Last export: @MobileLogbookSession.FormatTimestamp(Session.ExchangeStatus.LastSuccessfulExportAt)</span>
        </section>
    </section>
}

@code {
    private DateOnly RecentCutoff => DateOnly.FromDateTime(DateTime.Today.AddDays(-90));

    private PortableLogbookMaterializedEntryV2? LastFlight => Session.CurrentEntriesV2.FirstOrDefault();

    private decimal TotalFlyingHours =>
        Session.CurrentEntriesV2.Sum(entry => MobileLogbookSession.WorkbookLoggedTime(entry.Entry!));

    private IReadOnlyList<PortableLogbookMaterializedEntryV2> RecentEntries =>
        Session.CurrentEntriesV2
            .Where(entry => entry.Entry!.Date >= RecentCutoff)
            .ToArray();

    private int RecentFlightCount => RecentEntries.Count;

    private decimal RecentFlyingHours =>
        RecentEntries.Sum(entry => MobileLogbookSession.WorkbookLoggedTime(entry.Entry!));

    private string RecentHoursDetail =>
        $"{MobileLogbookSession.FormatHours(RecentFlyingHours)} hr";

    private string LastFlightTitle =>
        LastFlight?.Entry is null
            ? "No last flight yet"
            : $"{Session.FormatRoute(LastFlight.Entry)} on {MobileLogbookSession.FormatDate(LastFlight.Entry.Date)}";

    private string LastFlightDetail =>
        LastFlight?.Entry is null
            ? "Import a package or add a flight to build the device record."
            : $"{Session.FormatAircraft(LastFlight.Entry)} | {MobileLogbookSession.FormatHours(MobileLogbookSession.WorkbookLoggedTime(LastFlight.Entry))} hr";

    private string RecentSnapshotDetail =>
        Session.CurrentEntriesV2.Count == 0
            ? "90-day snapshot will appear after the first dated entry."
            : $"{FormatCount(RecentFlightCount, "flight")}, {MobileLogbookSession.FormatHours(RecentFlyingHours)} hr in the last 90 days.";

    private string RecordHealthIcon =>
        Session.MergeResultV2.Conflicts.Count > 0
            ? Icons.Material.Filled.ReportProblem
            : Icons.Material.Filled.HealthAndSafety;

    private string RecordHealthTitle =>
        Session.MergeResultV2.Conflicts.Count > 0
            ? "Record needs review"
            : RecentFlightCount > 0
                ? "Recent activity recorded"
                : "No recent activity on this device";

    private string RecordHealthReason
    {
        get
        {
            if (Session.MergeResultV2.Conflicts.Count > 0)
            {
                return $"{FormatCount(Session.MergeResultV2.Conflicts.Count, "conflict")} need review before the device copy is clean.";
            }

            if (LastFlight?.Entry is null)
            {
                return "No active entries are stored locally yet.";
            }

            if (RecentFlightCount == 0)
            {
                return $"Last dated entry is {MobileLogbookSession.FormatDate(LastFlight.Entry.Date)}; none are within the last 90 days.";
            }

            return $"Last dated entry is {MobileLogbookSession.FormatDate(LastFlight.Entry.Date)}; {FormatCount(RecentFlightCount, "entry")} are within the last 90 days.";
        }
    }

    private string NextActionDetail =>
        Session.CurrentEntriesV2.Count == 0
            ? "Create the first device entry or import an encrypted package from the workbook."
            : $"{FormatCount(Session.CurrentEntriesV2.Count, "flight")} available on this device.";

    private static string FormatCount(int count, string singular) =>
        $"{count} {singular}{(count == 1 ? string.Empty : "s")}";

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
    }

    private void CloneEntry(PortableLogbookWorkbookEntry entry)
    {
        Session.CloneWorkbookEntry(entry);
        Navigation.NavigateTo("/flights/new");
    }

}
