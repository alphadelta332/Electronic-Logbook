@page "/"
@inject MobileLogbookSession Session

<PageTitle>FlightLogX</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading device copy</span>
    </section>
}
else
{
    <section class="dashboard-page">
        @if (!string.IsNullOrWhiteSpace(Session.StorageError))
        {
            <section class="state-banner state-banner-error" role="alert">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
                <span>@Session.StorageError</span>
            </section>
        }

        <section class="dashboard-hours-hero" aria-labelledby="dashboard-total-hours-heading">
            <NavLink class="dashboard-hours-total" href="/flights?view=totals" aria-label="Open logbook totals">
                <h1 id="dashboard-total-hours-heading">Total flying hours</h1>
                <strong>@MobileLogbookSession.FormatHours(TotalFlyingHours)</strong>
                <small>Total aeronautical experience <strong>@MobileLogbookSession.FormatHours(TotalAeronauticalExperience)</strong></small>
            </NavLink>
            <div class="dashboard-hours-periods" aria-label="Recent flying hours">
                <NavLink class="dashboard-hours-period" href="/flights?view=entries" aria-label="Open logbook entries from the last 28 days">
                    <span>@MobileLogbookSession.FormatHours(HoursLast28Days)</span>
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" aria-hidden="true" />
                    <strong>Last 28 days</strong>
                </NavLink>
                <NavLink class="dashboard-hours-period" href="/flights?view=entries" aria-label="Open logbook entries from the last 365 days">
                    <span>@MobileLogbookSession.FormatHours(HoursLast365Days)</span>
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" aria-hidden="true" />
                    <strong>Last 365 days</strong>
                </NavLink>
            </div>

            @if (Session.CurrentEntriesV2.Count > 0)
            {
                <DashboardExperienceSnapshot Summary="@ExperienceSummary" />
            }
        </section>

        <div class="dashboard-side-column">
            <DashboardLastFlight Entry="@LastFlight" />

            <NavLink class="dashboard-section dashboard-currency" href="/currency" aria-label="Open currency and recency status">
                <DashboardCurrencyOverview Summary="@CurrencySummary" />
            </NavLink>
        </div>

        @if (Session.CurrentEntriesV2.Count == 0)
        {
            <section class="empty-state dashboard-empty-state" aria-label="No flights yet">
                <MudIcon Icon="@Icons.Material.Filled.Flight" />
                <strong>Your device logbook is ready</strong>
                <span>Add the first flight or import an encrypted workbook package from Settings.</span>
                <div class="action-buttons">
                    <MudButton Href="/flights/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Add first flight</MudButton>
                    <MudButton Href="/settings" Variant="Variant.Outlined">Open Settings</MudButton>
                </div>
            </section>
        }
    </section>
}

@code {
    private DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private PortableLogbookMaterializedEntryV2? LastFlight => Session.CurrentEntriesV2.FirstOrDefault();

    private decimal TotalFlyingHours =>
        Session.CurrentEntriesV2.Sum(entry => MobileLogbookSession.WorkbookFlightTime(entry.Entry!));

    private decimal TotalAeronauticalExperience =>
        Session.CurrentEntriesV2.Sum(entry => MobileLogbookSession.WorkbookLoggedTime(entry.Entry!));

    private decimal HoursLast28Days =>
        MobileDashboardFlightActivity.HoursWithinDays(
            Session.CurrentEntriesV2.Select(entry => entry.Entry!),
            Today,
            28);

    private decimal HoursLast365Days =>
        MobileDashboardFlightActivity.HoursWithinDays(
            Session.CurrentEntriesV2.Select(entry => entry.Entry!),
            Today,
            365);

    private MobileDashboardExperienceSummary? experienceSummary;

    private MobileDashboardExperienceSummary ExperienceSummary =>
        experienceSummary ??= MobileDashboardExperienceSummary.Create(
            Session.CurrentEntriesV2.Select(entry => entry.Entry!));

    private MobileCurrencyRecencySummary? currencySummary;

    private MobileCurrencyRecencySummary CurrencySummary =>
        currencySummary ??= Session.GetCurrencyRecencySummary(DateOnly.FromDateTime(DateTime.Today));

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
        experienceSummary = MobileDashboardExperienceSummary.Create(
            Session.CurrentEntriesV2.Select(entry => entry.Entry!));
        currencySummary = Session.GetCurrencyRecencySummary(DateOnly.FromDateTime(DateTime.Today));
    }

}
