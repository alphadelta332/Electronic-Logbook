@page "/"
@inject BrowserLogbookStore LogbookStore
@inject BrowserPackageKeyStore PackageKeyStore
@inject BrowserFileStore FileStore

<PageTitle>Electronic Logbook</PageTitle>

<section class="status-band">
    <div>
        <span class="label">Logbook</span>
        <strong>@Document.LogbookId.Value</strong>
    </div>
    <div>
        <span class="label">Current entries</span>
        <strong>@CurrentEntries.Count</strong>
    </div>
    <div>
        <span class="label">Unexported</span>
        <strong>@ExchangeStatus.PendingOperationCount</strong>
    </div>
    <div>
        <span class="label">Conflicts</span>
        <strong>@MergeResult.Conflicts.Count</strong>
    </div>
    <div>
        <span class="label">Package key</span>
        <strong>@PackageKeyStatus</strong>
    </div>
</section>

<section class="notice">
    @ExchangeStatus.BackupNotice
</section>

<section class="exchange-status">
    <span>Last import: @FormatTimestamp(ExchangeStatus.LastSuccessfulImportAt)</span>
    <span>Imported package: @FormatTimestamp(ExchangeStatus.LastImportedPackageCreatedAt)</span>
    <span>Last export: @FormatTimestamp(ExchangeStatus.LastSuccessfulExportAt)</span>
</section>

@if (!string.IsNullOrWhiteSpace(StorageError))
{
    <section class="storage-block" role="alert">
        @StorageError
    </section>
}

<div class="workspace">
    <section class="panel entry-panel">
        <div class="section-heading">
            <h1>@(EditingEntryId is null ? "New Flight" : "Edit Flight")</h1>
            <span>@Draft.Date.ToString("dd MMM yyyy")</span>
        </div>

        <div class="form-grid" @oninput="MarkDraftEdited" @onchange="MarkDraftEdited">
            <label>
                Date
                <input type="date" max="@TodayIso" @bind="Draft.Date" />
            </label>
            <label>
                Aircraft type
                <input @bind="Draft.AircraftType" list="aircraft-types" autocapitalize="characters" spellcheck="false" />
            </label>
            <label>
                Registration
                <input @bind="Draft.Registration" list="registrations" autocapitalize="characters" spellcheck="false" />
            </label>
            <label>
                Flight number
                <input @bind="Draft.FlightNumber" list="flight-numbers" autocapitalize="characters" spellcheck="false" />
            </label>
            <label>
                From
                <input @bind="Draft.From" list="airports" autocapitalize="characters" spellcheck="false" />
            </label>
            <label>
                To
                <input @bind="Draft.To" list="airports" autocapitalize="characters" spellcheck="false" />
            </label>
            <label>
                Route
                <input @bind="Draft.Route" list="routes" autocapitalize="characters" spellcheck="false" />
                <button class="field-action" type="button" @onclick="UseDirectRoute" disabled="@IsStorageBlocked">Direct</button>
            </label>
            <label>
                PIC
                <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Draft.PilotInCommand" />
            </label>
            <label>
                Multi-pilot
                <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Draft.MultiPilot" />
            </label>
            <label>
                Co-pilot
                <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Draft.CoPilot" />
            </label>
            <label>
                Dual
                <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Draft.Dual" />
            </label>
            <label>
                Instructor
                <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Draft.Instructor" />
            </label>
            <label>
                Day
                <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Draft.Day" />
            </label>
            <label>
                Night
                <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Draft.Night" />
            </label>
            <label>
                Instrument actual
                <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Draft.InstrumentActual" />
            </label>
            <label>
                Instrument sim
                <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Draft.InstrumentSimulated" />
            </label>
            <label>
                Takeoffs day
                <input type="number" min="0" inputmode="numeric" @bind="Draft.TakeoffsDay" />
            </label>
            <label>
                Takeoffs night
                <input type="number" min="0" inputmode="numeric" @bind="Draft.TakeoffsNight" />
            </label>
            <label>
                Landings day
                <input type="number" min="0" inputmode="numeric" @bind="Draft.LandingsDay" />
            </label>
            <label>
                Landings night
                <input type="number" min="0" inputmode="numeric" @bind="Draft.LandingsNight" />
            </label>
            <label>
                IFR approaches
                <input type="number" min="0" inputmode="numeric" @bind="Draft.IfrApproaches" />
            </label>
            <label>
                Holding
                <input type="number" min="0" inputmode="numeric" @bind="Draft.Holding" />
            </label>
            <label>
                RNAV
                <input type="number" min="0" inputmode="numeric" @bind="Draft.Rnav" />
            </label>
            <label>
                Circling
                <input type="number" min="0" inputmode="numeric" @bind="Draft.Circling" />
            </label>
        </div>

        <datalist id="aircraft-types">
            @foreach (var value in RecentValues(entry => entry.AircraftType))
            {
                <option value="@value"></option>
            }
        </datalist>
        <datalist id="registrations">
            @foreach (var value in RecentValues(entry => entry.Registration))
            {
                <option value="@value"></option>
            }
        </datalist>
        <datalist id="airports">
            @foreach (var value in RecentAirportValues())
            {
                <option value="@value"></option>
            }
        </datalist>
        <datalist id="flight-numbers">
            @foreach (var value in RecentValues(entry => entry.FlightNumber))
            {
                <option value="@value"></option>
            }
        </datalist>
        <datalist id="routes">
            @foreach (var value in RecentValues(entry => entry.Route))
            {
                <option value="@value"></option>
            }
        </datalist>
        <label class="wide-field">
            Remarks
            <textarea @bind="Draft.Remarks"></textarea>
        </label>
        <select class="wide-field recent-remarks" @onchange="UseRecentRemark" disabled="@IsStorageBlocked">
            <option value="">Recent remarks</option>
            @foreach (var value in RecentValues(entry => entry.Details))
            {
                <option value="@value">@value</option>
            }
        </select>

        <div class="calculated-total">
            <span>
                Logged time
                <strong>@FormatHours(Draft.LoggedTime) hr</strong>
            </span>
            <span>
                Takeoffs
                <strong>@Draft.TotalTakeoffs</strong>
            </span>
            <span>
                Landings
                <strong>@Draft.TotalLandings</strong>
            </span>
            <span>
                Approaches
                <strong>@Draft.TotalApproaches</strong>
            </span>
            <button type="button" @onclick="UseFlightTimeAsDay" disabled="@IsStorageBlocked">Use flight time as day</button>
            <button type="button" @onclick="MatchTakeoffsToLandings" disabled="@IsStorageBlocked">Match takeoffs</button>
        </div>

        <div class="custom-fields">
            @foreach (var field in CustomFields)
            {
                <label>
                    @field.Label
                    <input @bind="Draft.CustomValues[field.Id]" />
                </label>
            }
        </div>

        @if (ShouldShowDraftErrors)
        {
            <div class="validation-summary" role="alert" aria-live="polite">
                @foreach (var error in DraftErrors)
                {
                    <span>@error</span>
                }
            </div>
        }
        else if (DraftWarnings.Count > 0)
        {
            <div class="validation-summary warning-summary" role="status">
                @foreach (var warning in DraftWarnings)
                {
                    <span>@warning</span>
                }
            </div>
        }

        <div class="actions">
            <button type="button" class="primary" @onclick="SaveEntryAsync" disabled="@IsStorageBlocked">@(EditingEntryId is null ? "Add entry" : "Save correction")</button>
            <button type="button" @onclick="ResetDraft" disabled="@IsStorageBlocked">Clear</button>
        </div>
    </section>

    <section class="panel list-panel">
        <div class="section-heading">
            <h2>Current Record</h2>
            <span>@Document.Operations.Count operation(s)</span>
        </div>

        @if (CurrentEntries.Count == 0)
        {
            <p class="empty">No portable entries in this device copy yet.</p>
        }
        else
        {
            <div class="entry-list">
                @foreach (var entry in CurrentEntries)
                {
                    <article class="entry-row">
                        <div>
                            <strong>@FormatDate(entry.Entry!.Date)</strong>
                            <span>@entry.Entry.AircraftType @entry.Entry.Registration</span>
                        </div>
                        <div>
                            <strong>@entry.Entry.From - @entry.Entry.To</strong>
                            <span>@FormatHours(PortableLogbookEntryRules.LoggedTime(entry.Entry)) hr total</span>
                        </div>
                        <div class="row-actions">
                            <button type="button" @onclick="() => EditEntry(entry)">Edit</button>
                            <button type="button" @onclick="() => CloneEntry(entry.Entry)">Clone</button>
                            <button type="button" @onclick="() => ShowHistory(entry)">History</button>
                            <button type="button" @onclick="() => DeleteEntryAsync(entry)">Delete</button>
                        </div>
                    </article>
                }
            </div>
        }

        @if (HistoryEntry is not null)
        {
            <div class="history-panel">
                <div class="section-heading">
                    <h2>Revision History</h2>
                    <button type="button" @onclick="() => HistoryEntry = null">Close</button>
                </div>
                @foreach (var revisionId in HistoryEntry.RevisionHistory)
                {
                    var operation = Document.Operations.First(operation => operation.RevisionId == revisionId);
                    <div class="history-row">
                        <strong>@operation.Kind</strong>
                        <span>@operation.RevisionId.Value</span>
                    </div>
                }
            </div>
        }

        @if (MergeResult.Conflicts.Count > 0)
        {
            <div class="history-panel" role="alert">
                <div class="section-heading">
                    <h2>Conflicts</h2>
                    <span>@MergeResult.Conflicts.Count unresolved</span>
                </div>
                @foreach (var conflict in MergeResult.Conflicts)
                {
                    <div class="history-row">
                        <strong>@conflict.EntryId.Value</strong>
                        <span>@string.Join(", ", conflict.HeadRevisionIds.Select(revision => revision.Value))</span>
                    </div>
                    <div class="entry-list">
                        @foreach (var revisionId in conflict.HeadRevisionIds)
                        {
                            var operation = FindOperation(revisionId);
                            <article class="entry-row">
                                <div>
                                    <strong>@operation.Kind</strong>
                                    <span>@revisionId.Value</span>
                                </div>
                                <div>
                                    <strong>@FormatConflictRoute(operation)</strong>
                                    <span>@FormatConflictAircraft(operation)</span>
                                </div>
                                <div class="row-actions">
                                    <button type="button" @onclick="() => ResolveConflictAsync(conflict, revisionId)" disabled="@IsStorageBlocked">Keep</button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        }

        <div class="exchange-box">
            @if (PackageKeyStatus == "Not set")
            {
                <button type="button" @onclick="SetupPackageKeyAsync" disabled="@IsStorageBlocked" title="Create this device's browser-held package key.">Set up key</button>
            }
            <button type="button" @onclick="ExportSupportSummaryAsync" disabled="@IsStorageBlocked" title="Download a redacted local JSON summary for support or pilot feedback.">Support summary</button>
            <button type="button" @onclick="PreviewPackageAsync" disabled="@IsStorageBlocked" title="Read package manifest without changing this device copy.">Preview package</button>
            <button type="button" @onclick="ApplyPackageAsync" disabled="@IsPackageImportDisabled" title="@PackageImportTitle">Import package</button>
            <button type="button" class="primary" @onclick="ExportPackageAsync" disabled="@IsPackageExportDisabled" title="@PackageExchangeTitle">Export package</button>
        </div>
        <div class="key-notice" role="status">
            @PackageKeyNotice
        </div>
        @if (!string.IsNullOrWhiteSpace(PackageExchangeError))
        {
            <div class="validation-summary" role="alert">
                <span>@PackageExchangeError</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(PackageExchangeMessage))
        {
            <div class="exchange-message" role="status">
                <span>@PackageExchangeMessage</span>
            </div>
        }
        @if (ImportPlan is not null)
        {
            <div class="exchange-preview" role="status">
                <strong>@ImportPlan.FileName</strong>
                <span>@ImportPlan.OperationCount operation(s)</span>
                <span>Created @FormatTimestamp(ImportPlan.PackageCreatedAt)</span>
                <span>@FormatPackageCompatibility(ImportCompatibility)</span>
                @if (ImportExchangePlan is not null)
                {
                    <span>@FormatImportStatus(ImportExchangePlan.Status)</span>
                    <span>@ImportExchangePlan.Preview.NewOperations.Count new / @ImportExchangePlan.Preview.DuplicateOperationCount duplicate</span>
                    <div class="import-summary">
                        @foreach (var summary in ImportExchangePlan.Preview.NewOperationSummaries.Take(8))
                        {
                            <span>@FormatImportSummary(summary)</span>
                        }
                        @foreach (var summary in ImportExchangePlan.Preview.DuplicateOperationSummaries.Take(4))
                        {
                            <span>Duplicate: @FormatImportSummary(summary)</span>
                        }
                    </div>
                }
                @if (ImportExchangePlan?.Status == PortableLogbookImportPlanStatus.RequiresCustomFieldResolution)
                {
                    <div class="custom-field-conflicts">
                        @foreach (var conflict in ImportExchangePlan.Preview.CustomFieldDefinitions.Conflicts)
                        {
                            <div>
                                <strong>@conflict.Id.Value</strong>
                                <span>Local: @conflict.LocalDefinition.Label</span>
                                <span>Imported: @conflict.IncomingDefinition.Label</span>
                            </div>
                        }
                        <div class="row-actions">
                            <button type="button" @onclick="() => ResolveCustomFieldsAsync(PortableLogbookCustomFieldDefinitionChoice.KeepLocal)" disabled="@IsPackageImportDisabled">Keep local labels</button>
                            <button type="button" @onclick="() => ResolveCustomFieldsAsync(PortableLogbookCustomFieldDefinitionChoice.UseIncoming)" disabled="@IsPackageImportDisabled">Use imported labels</button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private readonly DeviceId DeviceId = new("dev_mobile_preview");
    private static readonly CustomFieldDefinition[] CustomFields =
    [
        new(new CustomFieldId("cf_workbook_1"), "Custom 1", 1),
        new(new CustomFieldId("cf_workbook_2"), "Custom 2", 2),
        new(new CustomFieldId("cf_workbook_3"), "Custom 3", 3),
        new(new CustomFieldId("cf_workbook_4"), "Custom 4", 4)
    ];

    private PortableLogbookDocument Document { get; set; } =
        PortableLogbookDocument.CreateAustraliaFirst(new LogbookId("log_mobile_preview"), CustomFields, []);

    private IReadOnlyList<PortableLogbookPackageReceipt> ImportReceipts { get; set; } = [];

    private DateTimeOffset? LastSuccessfulExportAt { get; set; }

    private BrowserLogbookExportCheckpoint? LastSuccessfulExport { get; set; }

    private EntryDraft Draft { get; set; } = EntryDraft.Create();

    private bool HasAttemptedSubmit { get; set; }

    private bool HasEditedDraft { get; set; }

    private EntryId? EditingEntryId { get; set; }

    private RevisionId? EditingRevisionId { get; set; }

    private PortableLogbookMaterializedEntry? HistoryEntry { get; set; }

    private bool IsStorageBlocked { get; set; }

    private string? StorageError { get; set; }

    private string PackageKeyStatus { get; set; } = "Checking";

    private MobilePackageImportPlanResult? ImportPlan { get; set; }

    private MobilePackageImportCompatibility? ImportCompatibility { get; set; }

    private PortableLogbookImportPlan? ImportExchangePlan { get; set; }

    private BrowserFile? PendingImportFile { get; set; }

    private string? PackageExchangeError { get; set; }

    private string? PackageExchangeMessage { get; set; }

    private static string TodayIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private string PackageExchangeTitle =>
        PackageKeyStatus == "Unavailable"
            ? "This browser cannot hold a non-extractable package key."
            : PackageKeyStatus == "Not set"
            ? "Set up this device's package key before exporting."
            : "Export an encrypted portable logbook package.";

    private string PackageImportTitle =>
        PackageKeyStatus == "Unavailable"
            ? "This browser cannot hold a non-extractable package key."
            : PackageKeyStatus == "Not set"
            ? "Set up this device's package key before importing encrypted packages."
            : "Import a compatible package and apply it when it has no unresolved conflicts.";

    private string PackageKeyNotice => MobilePackageKeyNotice.Create(PackageKeyStatus);

    private bool IsPackageExportDisabled => IsStorageBlocked || PackageKeyStatus != "Ready";

    private bool IsPackageImportDisabled =>
        IsStorageBlocked ||
        PackageKeyStatus != "Ready" ||
        ImportCompatibility is MobilePackageImportCompatibility.WrongLogbook or MobilePackageImportCompatibility.UnsupportedSchema;

    private PortableLogbookMergeResult MergeResult =>
        PortableLogbookMerger.Merge(Document.Operations);

    private IReadOnlyList<PortableLogbookMaterializedEntry> CurrentEntries =>
        MergeResult
            .Entries
            .Values
            .Where(entry => !entry.IsDeleted && entry.Entry is not null)
            .OrderByDescending(entry => entry.Entry!.Date)
            .ToArray();

    private PortableLogbookExchangeStatusSnapshot ExchangeStatus =>
        PortableLogbookExchangeStatus.Create(
            new PortableLogbookWorkingCopyState(
                Document.Operations.Count > 0,
                Document.Operations.Count,
                Document.Operations.Count(operation => operation.Kind == PortableOperationKind.Create),
                Document.Operations.Count(operation => operation.Kind == PortableOperationKind.Correction),
                Document.Operations.Count(operation => operation.Kind == PortableOperationKind.Deletion),
                Document.Operations.Select(operation => operation.RevisionId).ToArray(),
                DateTimeOffset.UtcNow),
            ImportReceipts,
            LastSuccessfulExportAt);

    private IReadOnlyList<string> DraftErrors => ValidateDraft();

    private IReadOnlyList<string> DraftWarnings => ValidateDraftWarnings();

    private bool ShouldShowDraftErrors => DraftErrors.Count > 0 && (HasAttemptedSubmit || HasEditedDraft);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await LogbookStore.LoadStateAsync();
            if (state is not null)
            {
                Document = state.Document;
                ImportReceipts = state.ImportReceipts;
                LastSuccessfulExportAt = state.LastSuccessfulExportAt;
                LastSuccessfulExport = state.LastSuccessfulExport;
            }

            await RefreshPackageKeyStatusAsync();
            ResetDraft();
        }
        catch (BrowserLogbookStoreException ex)
        {
            StorageError = ex.Message + " Export a valid backup package from a compatible device before using this app version.";
            IsStorageBlocked = true;
        }
    }

    private async Task SaveEntryAsync()
    {
        if (IsStorageBlocked)
        {
            return;
        }

        HasAttemptedSubmit = true;
        if (DraftErrors.Count > 0)
        {
            return;
        }

        PortableLogbookOperation operation = EditingEntryId is null || EditingRevisionId is null
            ? new CreateEntryOperation(
                Document.LogbookId,
                EntryId.New(),
                RevisionId.New(),
                DeviceId,
                DateTimeOffset.UtcNow,
                Draft.ToEntry(CustomFields))
            : new CorrectEntryOperation(
                Document.LogbookId,
                EditingEntryId.Value,
                RevisionId.New(),
                new HashSet<RevisionId> { EditingRevisionId.Value },
                DeviceId,
                DateTimeOffset.UtcNow,
                Draft.ToEntry(CustomFields));

        Document = MobileLogbookDocument.AppendOperation(Document, CustomFields, operation);
        await SaveStateAsync();
        ResetDraft();
    }

    private async Task RefreshPackageKeyStatusAsync()
    {
        try
        {
            if (!await PackageKeyStore.IsSupportedAsync())
            {
                PackageKeyStatus = "Unavailable";
                return;
            }

            PackageKeyStatus = await PackageKeyStore.HasPackageKeyAsync(Document.LogbookId)
                ? "Ready"
                : "Not set";
        }
        catch (JSException)
        {
            PackageKeyStatus = "Unavailable";
        }
    }

    private async Task PreviewPackageAsync()
    {
        if (IsStorageBlocked)
        {
            return;
        }

        PackageExchangeError = null;
        PackageExchangeMessage = null;
        ImportPlan = null;
        ImportCompatibility = null;
        ImportExchangePlan = null;
        PendingImportFile = null;
        try
        {
            var file = await FileStore.PickElogbookAsync();
            if (file is null)
            {
                return;
            }

            PendingImportFile = file;
            ImportPlan = MobilePackageImportPlan.Inspect(file);
            ImportCompatibility = MobilePackageImportPlan.CheckCompatibility(ImportPlan, Document.LogbookId);
            PackageExchangeMessage = "Package manifest previewed.";
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or PortableLogbookPackageException)
        {
            PackageExchangeError = ex.Message;
        }
    }

    private async Task SetupPackageKeyAsync()
    {
        if (IsStorageBlocked)
        {
            return;
        }

        PackageExchangeError = null;
        PackageExchangeMessage = null;
        try
        {
            if (!await PackageKeyStore.IsSupportedAsync())
            {
                PackageKeyStatus = "Unavailable";
                return;
            }

            await PackageKeyStore.EnsurePackageKeyAsync(Document.LogbookId);
            PackageKeyStatus = await PackageKeyStore.HasPackageKeyAsync(Document.LogbookId)
                ? "Ready"
                : "Not set";
            PackageExchangeMessage = PackageKeyStatus == "Ready"
                ? "Package key is ready on this device."
                : "Package key was not created.";
        }
        catch (JSException ex)
        {
            PackageKeyStatus = "Unavailable";
            PackageExchangeError = ex.Message;
        }
    }

    private async Task ExportPackageAsync()
    {
        if (IsPackageExportDisabled)
        {
            return;
        }

        PackageExchangeError = null;
        PackageExchangeMessage = null;
        try
        {
            var exportedAt = DateTimeOffset.UtcNow;
            var result = await MobilePackageExportWorkflow.ExportAsync(Document, PackageKeyStore, FileStore, exportedAt);
            LastSuccessfulExportAt = result.ExportedAt;
            LastSuccessfulExport = BrowserLogbookExportCheckpoint.Create(Document, result);
            await SaveStateAsync();
            PackageExchangeMessage = $"Exported {result.FileName}.";
        }
        catch (Exception ex) when (ex is MobilePackageExportPlanException or BrowserFileStoreException or JSException)
        {
            PackageExchangeError = ex.Message;
            await RefreshPackageKeyStatusAsync();
        }
    }

    private async Task ExportSupportSummaryAsync()
    {
        if (IsStorageBlocked)
        {
            return;
        }

        PackageExchangeError = null;
        PackageExchangeMessage = null;
        try
        {
            var exportedAt = DateTimeOffset.UtcNow;
            var result = await MobileSupportSummaryExportWorkflow.ExportAsync(Document, FileStore, exportedAt);
            PackageExchangeMessage = $"Exported {result.FileName}.";
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or JSException)
        {
            PackageExchangeError = ex.Message;
        }
    }

    private async Task ApplyPackageAsync()
    {
        if (IsPackageImportDisabled)
        {
            return;
        }

        PackageExchangeError = null;
        PackageExchangeMessage = null;
        ImportExchangePlan = null;
        try
        {
            var file = PendingImportFile ?? await FileStore.PickElogbookAsync();
            if (file is null)
            {
                return;
            }

            PendingImportFile = file;
            ImportPlan = MobilePackageImportPlan.Inspect(file);
            ImportCompatibility = MobilePackageImportPlan.CheckCompatibility(ImportPlan, Document.LogbookId);
            var result = await MobilePackageImportApplyWorkflow.ApplyIfReadyAsync(
                Document,
                file,
                PackageKeyStore,
                ImportReceipts,
                DateTimeOffset.UtcNow);
            ImportExchangePlan = result.Plan;
            if (result.Status == MobilePackageImportApplyStatus.RequiresResolution)
            {
                PackageExchangeError = "Package needs custom field resolution before imported changes can be applied.";
                return;
            }

            Document = result.Document;
            ImportReceipts = result.ImportReceipts;
            await SaveStateAsync();
            PackageExchangeMessage = FormatApplyStatus(result.Status);
            ResetDraft();
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or PortableLogbookPackageException or MobilePackageImportWorkflowException or PortableLogbookImportException or JSException)
        {
            PackageExchangeError = ex.Message;
            await RefreshPackageKeyStatusAsync();
        }
    }

    private async Task ResolveCustomFieldsAsync(PortableLogbookCustomFieldDefinitionChoice choice)
    {
        if (IsPackageImportDisabled)
        {
            return;
        }

        PackageExchangeError = null;
        PackageExchangeMessage = null;
        if (PendingImportFile is null || ImportExchangePlan is null)
        {
            PackageExchangeError = "Pick and inspect a package before resolving custom field labels.";
            return;
        }

        try
        {
            var resolutions = ImportExchangePlan
                .Preview
                .CustomFieldDefinitions
                .Conflicts
                .Select(conflict => new PortableLogbookCustomFieldDefinitionResolution(conflict.Id, choice))
                .ToArray();
            var result = await MobilePackageImportApplyWorkflow.ApplyWithCustomFieldResolutionsAsync(
                Document,
                PendingImportFile,
                PackageKeyStore,
                ImportReceipts,
                resolutions,
                DateTimeOffset.UtcNow);
            ImportExchangePlan = result.Plan;
            Document = result.Document;
            ImportReceipts = result.ImportReceipts;
            await SaveStateAsync();
            PackageExchangeMessage = FormatApplyStatus(result.Status);
            ClearPendingImportPreview();
            ResetDraft();
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or PortableLogbookPackageException or MobilePackageImportWorkflowException or ArgumentException or JSException)
        {
            PackageExchangeError = ex.Message;
            await RefreshPackageKeyStatusAsync();
        }
    }

    private void ResetDraft()
    {
        if (IsStorageBlocked)
        {
            return;
        }

        Draft = EntryDraft.Create(FindDraftDefaults());
        HasAttemptedSubmit = false;
        HasEditedDraft = false;
        EditingEntryId = null;
        EditingRevisionId = null;
    }

    private void CloneEntry(PortableLogbookEntry entry)
    {
        if (IsStorageBlocked)
        {
            return;
        }

        Draft = EntryDraft.FromEntry(entry);
        HasAttemptedSubmit = false;
        HasEditedDraft = false;
    }

    private void EditEntry(PortableLogbookMaterializedEntry entry)
    {
        if (IsStorageBlocked)
        {
            return;
        }

        if (entry.Entry is null)
        {
            return;
        }

        Draft = EntryDraft.FromEntry(entry.Entry);
        EditingEntryId = entry.EntryId;
        EditingRevisionId = entry.CurrentRevisionId;
        HasAttemptedSubmit = false;
        HasEditedDraft = false;
    }

    private void MarkDraftEdited()
    {
        HasEditedDraft = true;
    }

    private void UseFlightTimeAsDay()
    {
        if (IsStorageBlocked)
        {
            return;
        }

        Draft.Day = Draft.FlightTime;
        Draft.Night = 0;
        MarkDraftEdited();
    }

    private void UseRecentRemark(ChangeEventArgs args)
    {
        if (IsStorageBlocked)
        {
            return;
        }

        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        Draft.Remarks = value;
        MarkDraftEdited();
    }

    private void MatchTakeoffsToLandings()
    {
        if (IsStorageBlocked)
        {
            return;
        }

        Draft.TakeoffsDay = Draft.LandingsDay;
        Draft.TakeoffsNight = Draft.LandingsNight;
        MarkDraftEdited();
    }

    private void UseDirectRoute()
    {
        if (IsStorageBlocked)
        {
            return;
        }

        var from = Draft.From.Trim();
        var to = Draft.To.Trim();
        if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to))
        {
            return;
        }

        Draft.Route = string.Equals(from, to, StringComparison.OrdinalIgnoreCase)
            ? from
            : $"{from} {to}";
        MarkDraftEdited();
    }

    private async Task DeleteEntryAsync(PortableLogbookMaterializedEntry entry)
    {
        if (IsStorageBlocked)
        {
            return;
        }

        var operation = new DeleteEntryOperation(
            Document.LogbookId,
            entry.EntryId,
            RevisionId.New(),
            new HashSet<RevisionId> { entry.CurrentRevisionId },
            DeviceId,
            DateTimeOffset.UtcNow);

        Document = MobileLogbookDocument.AppendOperation(Document, CustomFields, operation);
        HistoryEntry = null;
        await SaveStateAsync();
        if (EditingEntryId == entry.EntryId)
        {
            ResetDraft();
        }
    }

    private async Task ResolveConflictAsync(PortableLogbookConflict conflict, RevisionId selectedRevisionId)
    {
        if (IsStorageBlocked)
        {
            return;
        }

        var selectedOperation = FindOperation(selectedRevisionId);
        var selectedEntry = EntryPayload(selectedOperation);
        PortableLogbookOperation resolution = selectedEntry is null
            ? new DeleteEntryOperation(
                Document.LogbookId,
                conflict.EntryId,
                RevisionId.New(),
                conflict.HeadRevisionIds.ToHashSet(),
                DeviceId,
                DateTimeOffset.UtcNow)
            : PortableLogbookConflictResolution.CreateResolution(
                conflict,
                Document.LogbookId,
                DeviceId,
                RevisionId.New(),
                DateTimeOffset.UtcNow,
                selectedEntry,
                $"Kept revision {selectedRevisionId.Value} in the mobile app.");

        Document = MobileLogbookDocument.AppendOperation(Document, CustomFields, resolution);
        HistoryEntry = null;
        await SaveStateAsync();
    }

    private ValueTask SaveStateAsync() =>
        LogbookStore.SaveStateAsync(new BrowserLogbookState(Document, ImportReceipts, LastSuccessfulExportAt, LastSuccessfulExport));

    private void ShowHistory(PortableLogbookMaterializedEntry entry)
    {
        HistoryEntry = entry;
    }

    private void ClearPendingImportPreview()
    {
        ImportPlan = null;
        ImportCompatibility = null;
        ImportExchangePlan = null;
        PendingImportFile = null;
    }

    private static string FormatHours(decimal hours) => hours.ToString("0.0");

    private static string FormatDate(DateOnly? date) => date?.ToString("dd MMM yyyy") ?? "No date";

    private static string FormatTimestamp(DateTimeOffset? timestamp) =>
        timestamp?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Never";

    private static string FormatPackageCompatibility(MobilePackageImportCompatibility? compatibility) =>
        compatibility switch
        {
            MobilePackageImportCompatibility.Compatible => "Compatible",
            MobilePackageImportCompatibility.WrongLogbook => "Wrong logbook",
            MobilePackageImportCompatibility.UnsupportedSchema => "Unsupported schema",
            _ => "Not checked"
        };

    private static string FormatImportStatus(PortableLogbookImportPlanStatus status) =>
        status switch
        {
            PortableLogbookImportPlanStatus.ReadyToApply => "Ready to apply",
            PortableLogbookImportPlanStatus.DuplicateOnly => "Duplicate operations only",
            PortableLogbookImportPlanStatus.RequiresConflictResolution => "Conflict resolution required",
            PortableLogbookImportPlanStatus.RequiresCustomFieldResolution => "Custom field resolution required",
            _ => "Not checked"
        };

    private static string FormatApplyStatus(MobilePackageImportApplyStatus status) =>
        status switch
        {
            MobilePackageImportApplyStatus.Applied => "Imported package changes.",
            MobilePackageImportApplyStatus.AppliedWithConflicts => "Imported package changes. Resolve the highlighted conflicts before relying on current entries.",
            MobilePackageImportApplyStatus.DuplicateOperationsRecorded => "Recorded package receipt; no new operations were needed.",
            MobilePackageImportApplyStatus.PackageReplay => "Package was already imported on this device.",
            MobilePackageImportApplyStatus.RequiresResolution => "Package requires resolution before import.",
            _ => "Package import finished."
        };

    private static string FormatImportSummary(PortableLogbookImportChangeSummary summary)
    {
        var date = summary.Date?.ToString("dd MMM yyyy") ?? "No date";
        var aircraft = $"{summary.AircraftType} {summary.Registration}".Trim();
        var route = $"{summary.From} - {summary.To}".Trim();
        var detail = summary.Kind == PortableOperationKind.Deletion
            ? summary.DeletionReason ?? "Deleted entry"
            : FirstNonBlank(aircraft, route, summary.Details, summary.EntryId.Value);
        return $"{summary.Kind}: {date} {detail}".Trim();
    }

    private PortableLogbookOperation FindOperation(RevisionId revisionId) =>
        Document.Operations.First(operation => operation.RevisionId == revisionId);

    private static PortableLogbookEntry? EntryPayload(PortableLogbookOperation operation) =>
        operation switch
        {
            CreateEntryOperation create => create.Entry,
            CorrectEntryOperation correction => correction.Entry,
            ResolveConflictOperation resolution => resolution.Entry,
            DeleteEntryOperation => null,
            _ => throw new InvalidOperationException($"Unsupported operation type {operation.GetType().Name}.")
        };

    private static string FormatConflictRoute(PortableLogbookOperation operation)
    {
        var entry = EntryPayload(operation);
        return entry is null
            ? "Deleted entry"
            : $"{entry.From} - {entry.To}".Trim();
    }

    private static string FormatConflictAircraft(PortableLogbookOperation operation)
    {
        var entry = EntryPayload(operation);
        return entry is null
            ? "Tombstone"
            : $"{entry.AircraftType} {entry.Registration}".Trim();
    }

    private IEnumerable<string> RecentValues(Func<PortableLogbookEntry, string?> selector) =>
        MobileRecentValues.Create(CurrentEntries, selector);

    private IEnumerable<string> RecentAirportValues() =>
        MobileAirportSuggestions.Create(CurrentEntries);

    private string[] ValidateDraft()
    {
        return PortableLogbookEntryRules
            .Validate(Draft.ToEntry(CustomFields), DateOnly.FromDateTime(DateTime.Today))
            .Errors
            .Select(error => error.Message)
            .ToArray();
    }

    private string[] ValidateDraftWarnings()
    {
        return MobileLogbookEntryWarnings
            .Create(Draft.ToEntry(CustomFields), CurrentEntries, EditingEntryId)
            .ToArray();
    }

    private MobileEntryDraftDefaults FindDraftDefaults() =>
        MobileEntryDraftDefaultPlanner.Create(CurrentEntries);

    private static string FirstNonBlank(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private sealed class EntryDraft
    {
        public DateOnly Date { get; set; }
        public string AircraftType { get; set; } = string.Empty;
        public string Registration { get; set; } = string.Empty;
        public string FlightNumber { get; set; } = string.Empty;
        public string From { get; set; } = string.Empty;
        public string To { get; set; } = string.Empty;
        public string Route { get; set; } = string.Empty;
        public decimal MultiPilot { get; set; }
        public decimal PilotInCommand { get; set; }
        public decimal CoPilot { get; set; }
        public decimal Dual { get; set; }
        public decimal Instructor { get; set; }
        public decimal Day { get; set; }
        public decimal Night { get; set; }
        public decimal InstrumentActual { get; set; }
        public decimal InstrumentSimulated { get; set; }
        public int? TakeoffsDay { get; set; }
        public int? TakeoffsNight { get; set; }
        public int? LandingsDay { get; set; }
        public int? LandingsNight { get; set; }
        public int? IfrApproaches { get; set; }
        public int? Holding { get; set; }
        public int? Rnav { get; set; }
        public int? Circling { get; set; }
        public string Remarks { get; set; } = string.Empty;
        public Dictionary<CustomFieldId, string> CustomValues { get; } = [];

        public decimal FlightTime =>
            MultiPilot + PilotInCommand + CoPilot + Dual + Instructor;

        public decimal LoggedTime => FlightTime + InstrumentSimulated;

        public int TotalTakeoffs => TakeoffsDay.GetValueOrDefault() + TakeoffsNight.GetValueOrDefault();

        public int TotalLandings => LandingsDay.GetValueOrDefault() + LandingsNight.GetValueOrDefault();

        public int TotalApproaches =>
            IfrApproaches.GetValueOrDefault() +
            Holding.GetValueOrDefault() +
            Rnav.GetValueOrDefault() +
            Circling.GetValueOrDefault();

        public static EntryDraft Create(MobileEntryDraftDefaults? defaults = null)
        {
            defaults ??= MobileEntryDraftDefaults.Empty;
            var draft = new EntryDraft
            {
                Date = DateOnly.FromDateTime(DateTime.Today),
                AircraftType = defaults.AircraftType,
                Registration = defaults.Registration,
                From = defaults.From,
                To = defaults.To,
                Route = defaults.Route
            };
            foreach (var field in PortableLogbookCustomFieldSet.CreateWorkbookCustomFields(["Custom 1", "Custom 2", "Custom 3", "Custom 4"]))
            {
                draft.CustomValues[field.Id] = string.Empty;
            }

            return draft;
        }

        public static EntryDraft FromEntry(PortableLogbookEntry entry)
        {
            var draft = Create();
            draft.Date = DateOnly.FromDateTime(DateTime.Today);
            draft.AircraftType = entry.AircraftType ?? string.Empty;
            draft.Registration = entry.Registration ?? string.Empty;
            draft.FlightNumber = entry.FlightNumber ?? string.Empty;
            draft.From = entry.From ?? string.Empty;
            draft.To = entry.To ?? string.Empty;
            draft.Route = entry.Route ?? string.Empty;
            draft.MultiPilot = entry.MultiPilot ?? 0;
            draft.PilotInCommand = entry.PilotInCommand ?? 0;
            draft.CoPilot = entry.CoPilot ?? 0;
            draft.Dual = entry.Dual ?? 0;
            draft.Instructor = entry.Instructor ?? 0;
            draft.Day = entry.Day ?? 0;
            draft.Night = entry.Night ?? 0;
            draft.InstrumentActual = entry.InstrumentActual ?? 0;
            draft.InstrumentSimulated = entry.InstrumentSimulated ?? 0;
            draft.TakeoffsDay = entry.TakeoffsDay;
            draft.TakeoffsNight = entry.TakeoffsNight;
            draft.LandingsDay = entry.LandingsDay;
            draft.LandingsNight = entry.LandingsNight;
            draft.IfrApproaches = entry.IfrApproaches;
            draft.Holding = entry.Holding;
            draft.Rnav = entry.Rnav;
            draft.Circling = entry.Circling;
            draft.Remarks = entry.Details ?? string.Empty;
            foreach (var customField in entry.CustomFields)
            {
                draft.CustomValues[customField.Key] = customField.Value ?? string.Empty;
            }

            return draft;
        }

        public PortableLogbookEntry ToEntry(IEnumerable<CustomFieldDefinition> fields)
        {
            IReadOnlyDictionary<CustomFieldId, string?> customValues = fields
                .Select(field => new KeyValuePair<CustomFieldId, string>(field.Id, CustomValues.GetValueOrDefault(field.Id, string.Empty)))
                .Where(pair => !string.IsNullOrWhiteSpace(pair.Value))
                .ToDictionary(pair => pair.Key, pair => (string?)pair.Value);

            return PortableLogbookEntry.Empty with
            {
                Date = Date,
                AircraftType = AircraftType.Trim(),
                Registration = Registration.Trim(),
                FlightNumber = FlightNumber.Trim(),
                From = From.Trim(),
                To = To.Trim(),
                Route = Route.Trim(),
                Details = Remarks.Trim(),
                MultiPilot = MultiPilot,
                PilotInCommand = PilotInCommand,
                CoPilot = CoPilot,
                Dual = Dual,
                Instructor = Instructor,
                Day = Day,
                Night = Night,
                InstrumentActual = InstrumentActual,
                InstrumentSimulated = InstrumentSimulated,
                TakeoffsDay = TakeoffsDay,
                TakeoffsNight = TakeoffsNight,
                LandingsDay = LandingsDay,
                LandingsNight = LandingsNight,
                IfrApproaches = IfrApproaches,
                Holding = Holding,
                Rnav = Rnav,
                Circling = Circling,
                CustomFields = customValues
            };
        }
    }
}
