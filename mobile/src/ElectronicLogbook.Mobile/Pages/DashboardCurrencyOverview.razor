@implements IAsyncDisposable
@inject IJSRuntime JS

<section @ref="overview" class="currency-overview dashboard-currency-overview" aria-label="Currency status overview">
    <div class="currency-overview-item currency-overview-current">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" aria-hidden="true" />
        <strong>@Summary.CurrentCount</strong>
        <span>Current</span>
    </div>
    <div class="currency-overview-item currency-overview-warning">
        <MudIcon Icon="@Icons.Material.Filled.Schedule" aria-hidden="true" />
        <strong>@Summary.DueSoonCount</strong>
        <span>Due soon</span>
    </div>
    <div class="currency-overview-item currency-overview-expired">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" aria-hidden="true" />
        <strong>@Summary.ExpiredCount</strong>
        <span>Expired</span>
    </div>
</section>

@code {
    private ElementReference overview;

    [Parameter, EditorRequired]
    public MobileCurrencyRecencySummary Summary { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("electronicLogbookCurrencyOverview.observe", overview);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("electronicLogbookCurrencyOverview.disconnect", overview);
        }
        catch (JSException)
        {
        }
    }
}
