<MudButton Class="logbook-filter-button" Variant="Variant.Outlined" Size="Size.Small"
           StartIcon="@Icons.Material.Filled.FilterList" aria-expanded="@Expanded.ToString().ToLowerInvariant()"
           OnClick="@(() => ExpandedChanged.InvokeAsync(!Expanded))">
    @(Count == 0 ? "Filters" : $"Filters ({Count})")
</MudButton>

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
}
