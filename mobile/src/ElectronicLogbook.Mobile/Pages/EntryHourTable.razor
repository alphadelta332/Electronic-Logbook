<div class="entry-hour-table">
    <div class="totals-table" role="table" aria-label="Hours by capacity">
        <div class="totals-table-row totals-table-header" role="row">
            <span role="columnheader">Capacity</span>
            <span class="totals-time-header" role="columnheader">
                <TimePeriodLabel Label="Day" />
            </span>
            <span class="totals-time-header" role="columnheader">
                <TimePeriodLabel Label="Night" />
            </span>
        </div>
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
