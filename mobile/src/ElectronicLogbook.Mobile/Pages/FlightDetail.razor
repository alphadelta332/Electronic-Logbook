@page "/flights/{EntryId}"
@implements IDisposable
@inject MobileLogbookSession Session
@inject NavigationManager Navigation

<PageTitle>Flight Detail</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading flight</span>
    </section>
}
else if (CurrentEntry?.Entry is null)
{
    @if (History?.IsDeleted == true)
    {
        <section class="flight-detail-page">
            <NavLink class="page-back-link" href="/flights?view=entries">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />
                <span>Back to Logbook</span>
            </NavLink>
            <header class="entry-header">
                <div>
                    <span class="eyebrow">Deleted entry</span>
                    <h1>Deleted flight</h1>
                </div>
                @if (HistoricalEntry is not null)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Restore"
                               OnClick="RestoreEntryAsync"
                               Disabled="@(Session.IsStorageBlocked || IsRestorePending)">
                        Restore flight
                    </MudButton>
                }
            </header>

            @if (HistoricalEntry is not null)
            {
                <section class="detail-hero deleted-detail-hero">
                    <div class="detail-primary-line">
                        <strong>@Session.FormatRegistration(HistoricalEntry)</strong>
                        <strong>@Session.FormatRoute(HistoricalEntry)</strong>
                        <strong>@MobileLogbookSession.FormatHours(MobileLogbookSession.WorkbookLoggedTime(HistoricalEntry))</strong>
                    </div>
                    <span>@MobileLogbookSession.FormatDate(HistoricalEntry.Date) | @Session.FormatAircraft(HistoricalEntry)</span>
                </section>
            }

            <section class="notice-panel" role="status">
                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" />
                <div>
                    <strong>Deleted flight</strong>
                    <span>This flight is no longer active. Restore it to return it to your logbook.</span>
                </div>
            </section>
        </section>
    }
    else
    {
        <section class="empty-state">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" />
            <strong>Flight not found</strong>
            <span>This entry may belong to another device copy.</span>
            <MudButton Href="/flights" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">Logbook</MudButton>
        </section>
    }
}
else
{
    @if (ShowDeleteConfirmation)
    {
        <div class="entry-action-dialog-backdrop" @onclick="DismissDeleteConfirmation">
            <section class="entry-action-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="delete-flight-dialog-title"
                     @onclick:stopPropagation="true">
                <header class="entry-action-dialog-header">
                    <span class="entry-action-dialog-icon entry-action-dialog-icon-warning">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                    </span>
                    <div>
                        <span class="eyebrow">Confirm deletion</span>
                        <h2 id="delete-flight-dialog-title">Delete this flight?</h2>
                        <p>The flight will move to Deleted flights, where you can restore it later. You can also undo this deletion for about five seconds.</p>
                    </div>
                </header>
                <footer class="entry-action-dialog-actions">
                    <MudButton Variant="Variant.Text" OnClick="DismissDeleteConfirmation" Disabled="@IsDeletePending">
                        Keep flight
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteEntryAsync" Disabled="@IsDeletePending" StartIcon="@Icons.Material.Filled.DeleteOutline">
                        Delete flight
                    </MudButton>
                </footer>
            </section>
        </div>
    }

    <section class="flight-detail-page">
        <NavLink class="page-back-link" href="/flights?view=entries">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />
            <span>Back to Logbook</span>
        </NavLink>
        <header class="entry-header entry-action-header">
            <div class="entry-action-context">
                <h1>Flight details</h1>
                <span class="entry-draft-status">
                    <span class="entry-draft-status-dot" aria-hidden="true"></span>
                    @MobileLogbookSession.FormatHours(MobileLogbookSession.WorkbookLoggedTime(CurrentEntry.Entry)) hr
                </span>
            </div>
            <div class="entry-header-actions" role="group" aria-label="Flight entry actions">
                <MudButton Class="entry-delete-action" Variant="Variant.Filled" Color="Color.Error" OnClick="RequestDeleteEntry" Disabled="@Session.IsStorageBlocked" aria-label="Delete flight" title="Delete flight">
                    Delete
                </MudButton>
                <MudButton Class="entry-save-action" Variant="Variant.Filled" Color="Color.Primary" OnClick="CloneEntry" aria-label="Clone flight" title="Clone flight">
                    Clone
                </MudButton>
            </div>
        </header>

        <section class="detail-hero">
            <div class="detail-primary-line">
                <strong>@Session.FormatRegistration(CurrentEntry.Entry)</strong>
                <strong>@Session.FormatRoute(CurrentEntry.Entry)</strong>
                <strong>@MobileLogbookSession.FormatHours(MobileLogbookSession.WorkbookLoggedTime(CurrentEntry.Entry))</strong>
            </div>
            <span>@MobileLogbookSession.FormatDate(CurrentEntry.Entry.Date) | @Session.FormatAircraft(CurrentEntry.Entry)</span>
        </section>

        <div class="entry-detail-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditEntry">Edit entry</MudButton>
        </div>
        <EntryFieldsLayout ShowCustom="@(Session.WorkbookCustomFields.Count > 0)" Context="section">
            @{ var details = SectionDetails(section); }
            @if (section is EntryFieldsLayout.Subsection.SingleEngine or EntryFieldsLayout.Subsection.MultiEngine)
            {
                <EntryHourTable>
                    @foreach (var pair in details.Chunk(2))
                    {
                        <div class="totals-table-row" role="row">
                            <strong role="rowheader">@CapacityLabel(pair[0].Field)</strong>
                            @foreach (var detail in pair)
                            {
                                <HourValueCell Period="@(detail.Field?.EndsWith("Day", StringComparison.Ordinal) == true ? "Day" : "Night")">
                                    <dl class="record-field @(IsEmptyDetailValue(detail.Value) ? "record-field-empty" : null)">
                                        <dt class="visually-hidden">@detail.Label</dt>
                                        <dd>@detail.Value</dd>
                                    </dl>
                                </HourValueCell>
                            }
                        </div>
                    }
                </EntryHourTable>
            }
            else if (section == EntryFieldsLayout.Subsection.OtherTime)
            {
                <div class="entry-other-time">
                    <div class="totals-pair-list">
                        @foreach (var pair in details.Chunk(2))
                        {
                            <div class="totals-pair-row">
                                <strong>@(pair[0].Field == nameof(PortableLogbookWorkbookEntry.CopilotDay) ? "Copilot" : "Instrument")</strong>
                                <div class="time-period-values">
                                @foreach (var detail in pair)
                                {
                                    <div>
                                        <small><TimePeriodLabel Label="@OtherTimePeriod(detail.Field)" /></small>
                                        <dl class="record-field @(IsEmptyDetailValue(detail.Value) ? "record-field-empty" : null)">
                                            <dt class="visually-hidden">@detail.Label</dt>
                                            <dd>@detail.Value</dd>
                                        </dl>
                                    </div>
                                }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                var fieldGroups = section == EntryFieldsLayout.Subsection.Crew
                    ? new[] { details.Take(2), details.Skip(2) }
                    : new[] { details.AsEnumerable() };
                <div class="@(section == EntryFieldsLayout.Subsection.Custom ? "record-custom-fields" : null)">
                    @foreach (var fields in fieldGroups)
                    {
                        var columns = section == EntryFieldsLayout.Subsection.Details ? 3 :
                            section == EntryFieldsLayout.Subsection.Crew && fields.Count() == 3 ? 1 : 2;
                        <dl class="record-field-list @(section == EntryFieldsLayout.Subsection.Custom ? null : "entry-responsive-grid")" style="--entry-field-columns: @columns">
                            @foreach (var detail in fields)
                            {
                                <div class="record-field @(IsEmptyDetailValue(detail.Value) ? "record-field-empty" : null) @(detail.Label is "Date" or "Via" or "Remarks" or "Circling" ? "field-span" : null)">
                                    <dt>@detail.Label</dt>
                                    <dd>@detail.Value</dd>
                                </div>
                            }
                        </dl>
                    }
                </div>
            }
        </EntryFieldsLayout>

    </section>
}

@code {
    [Parameter]
    public string? EntryId { get; set; }

    private bool ShowDeleteConfirmation { get; set; }

    private bool IsDeletePending { get; set; }

    private bool IsRestorePending { get; set; }

    private PortableLogbookMaterializedEntryV2? CurrentEntry => Session.FindCurrentEntryV2(EntryId);

    private PortableLogbookMaterializedEntryV2? History => CurrentEntry;

    private PortableLogbookWorkbookEntry? HistoricalEntry => History is null
        ? null
        : Session.FindLatestWorkbookEntryPayload(History);

    private IReadOnlyList<EntryDetail> SectionDetails(EntryFieldsLayout.Subsection section)
    {
        if (CurrentEntry?.Entry is null) return [];
        return Session.EntryDetails(CurrentEntry.Entry).Where(detail => section switch
        {
            EntryFieldsLayout.Subsection.Details => detail.Group == EntryDetailGroup.Flight,
            EntryFieldsLayout.Subsection.Crew => detail.Group == EntryDetailGroup.Crew,
            EntryFieldsLayout.Subsection.Route => detail.Group == EntryDetailGroup.Route,
            EntryFieldsLayout.Subsection.SingleEngine => HourGroup(detail) == "se",
            EntryFieldsLayout.Subsection.MultiEngine => HourGroup(detail) == "me",
            EntryFieldsLayout.Subsection.OtherTime => HourGroup(detail) == "other",
            EntryFieldsLayout.Subsection.Custom => detail.Group == EntryDetailGroup.CustomFields,
            EntryFieldsLayout.Subsection.Landings => detail.Group == EntryDetailGroup.Landings,
            EntryFieldsLayout.Subsection.InstrumentApproaches => detail.Group == EntryDetailGroup.InstrumentApproaches,
            _ => false
        }).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        Session.WorkbookStateChanged += OnWorkbookStateChanged;
        await Session.EnsureLoadedWorkbookAsync();
    }

    private void OnWorkbookStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.WorkbookStateChanged -= OnWorkbookStateChanged;
    }

    private static string HourGroup(EntryDetail detail) => detail.Group != EntryDetailGroup.LoggedTime
        ? "fields"
        : detail.Field switch
        {
            nameof(PortableLogbookWorkbookEntry.SeIcusDay) or nameof(PortableLogbookWorkbookEntry.SeIcusNight)
                or nameof(PortableLogbookWorkbookEntry.SeDualDay) or nameof(PortableLogbookWorkbookEntry.SeDualNight)
                or nameof(PortableLogbookWorkbookEntry.SeCommandDay) or nameof(PortableLogbookWorkbookEntry.SeCommandNight) => "se",
            nameof(PortableLogbookWorkbookEntry.MeIcusDay) or nameof(PortableLogbookWorkbookEntry.MeIcusNight)
                or nameof(PortableLogbookWorkbookEntry.MeDualDay) or nameof(PortableLogbookWorkbookEntry.MeDualNight)
                or nameof(PortableLogbookWorkbookEntry.MeCommandDay) or nameof(PortableLogbookWorkbookEntry.MeCommandNight) => "me",
            nameof(PortableLogbookWorkbookEntry.CopilotDay) or nameof(PortableLogbookWorkbookEntry.CopilotNight)
                or nameof(PortableLogbookWorkbookEntry.IfrIf) or nameof(PortableLogbookWorkbookEntry.IfrSim) => "other",
            _ => "fields"
        };

    private static bool IsEmptyDetailValue(string value) =>
        value == "-";

    private static string OtherTimePeriod(string? field) => field switch
    {
        nameof(PortableLogbookWorkbookEntry.CopilotDay) => "Day",
        nameof(PortableLogbookWorkbookEntry.CopilotNight) => "Night",
        nameof(PortableLogbookWorkbookEntry.IfrIf) => "In Flight",
        _ => "Simulator"
    };

    private static string CapacityLabel(string? field) => field switch
    {
        nameof(PortableLogbookWorkbookEntry.SeIcusDay) or nameof(PortableLogbookWorkbookEntry.MeIcusDay) => "ICUS",
        nameof(PortableLogbookWorkbookEntry.SeDualDay) or nameof(PortableLogbookWorkbookEntry.MeDualDay) => "Dual",
        nameof(PortableLogbookWorkbookEntry.SeCommandDay) or nameof(PortableLogbookWorkbookEntry.MeCommandDay) => "Command",
        _ => "Copilot"
    };

    private void EditEntry()
    {
        if (CurrentEntry is null)
        {
            return;
        }

        Navigation.NavigateTo($"/flights/{CurrentEntry.EntryId.Value}/edit");
    }

    private void CloneEntry()
    {
        if (CurrentEntry?.Entry is null)
        {
            return;
        }

        Session.CloneWorkbookEntry(CurrentEntry.Entry);
        Navigation.NavigateTo("/flights/new");
    }

    private void RequestDeleteEntry()
    {
        if (CurrentEntry is not null && !Session.IsStorageBlocked)
        {
            ShowDeleteConfirmation = true;
        }
    }

    private void DismissDeleteConfirmation()
    {
        if (!IsDeletePending)
        {
            ShowDeleteConfirmation = false;
        }
    }

    private async Task ConfirmDeleteEntryAsync()
    {
        if (CurrentEntry is null || IsDeletePending || Session.IsStorageBlocked)
        {
            return;
        }

        IsDeletePending = true;
        try
        {
            var deleteTask = Session.DeleteWorkbookEntryAsync(CurrentEntry);
            Navigation.NavigateTo("/flights?view=entries", replace: true);
            await deleteTask;
        }
        finally
        {
            IsDeletePending = false;
        }
    }

    private async Task RestoreEntryAsync()
    {
        if (History is null || !History.IsDeleted || IsRestorePending || Session.IsStorageBlocked)
        {
            return;
        }

        IsRestorePending = true;
        var entryToRestore = History;
        try
        {
            Navigation.NavigateTo("/flights?view=entries", replace: true);
            await Task.Yield();
            if (!await Session.RestoreWorkbookEntryAsync(entryToRestore))
            {
                Navigation.NavigateTo($"/flights/{entryToRestore.EntryId.Value}", replace: true);
            }
        }
        finally
        {
            IsRestorePending = false;
        }
    }

}
