@page "/flights/{EntryId}"
@inject MobileLogbookSession Session
@inject NavigationManager Navigation

<PageTitle>Flight Detail</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading flight</span>
    </section>
}
else if (CurrentEntry?.Entry is null)
{
    @if (History?.IsDeleted == true)
    {
        <section class="flight-detail-page">
            <NavLink class="page-back-link" href="/flights?view=entries">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />
                <span>Back to Logbook</span>
            </NavLink>
            <header class="entry-header">
                <div>
                    <span class="eyebrow">Deleted entry</span>
                    <h1>Deleted flight</h1>
                </div>
                <span class="draft-pill">Deleted</span>
            </header>

            <section class="notice-panel" role="status">
                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" />
                <div>
                    <strong>Deletion history</strong>
                    <span>This entry is no longer active, but its revisions remain in the portable audit trail.</span>
                </div>
            </section>

            <section class="form-section">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Immutable history</span>
                        <h2>Revisions</h2>
                    </div>
                </div>
                @foreach (var revisionId in History.RevisionHistory)
                {
                    var revision = Session.FindOperationV2(revisionId);
                    <div class="history-row">
                        <div>
                            <strong>@revision.Kind</strong>
                            <span>@MobileLogbookSession.FormatTimestamp(revision.CreatedAt)</span>
                        </div>
                        <span>@revision.RevisionId.Value</span>
                    </div>
                }
                <MudButton Href="/flights" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">Logbook</MudButton>
            </section>
        </section>
    }
    else
    {
        <section class="empty-state">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" />
            <strong>Flight not found</strong>
            <span>This entry may belong to another device copy.</span>
            <MudButton Href="/flights" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">Logbook</MudButton>
        </section>
    }
}
else
{
    @if (ShowDeleteConfirmation)
    {
        <div class="entry-action-dialog-backdrop" @onclick="DismissDeleteConfirmation">
            <section class="entry-action-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="delete-flight-dialog-title"
                     @onclick:stopPropagation="true">
                <header class="entry-action-dialog-header">
                    <span class="entry-action-dialog-icon entry-action-dialog-icon-warning">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                    </span>
                    <div>
                        <span class="eyebrow">Confirm deletion</span>
                        <h2 id="delete-flight-dialog-title">Delete this flight?</h2>
                        <p>The flight will leave your active logbook. Its audit history will remain, and you can undo this deletion for about five seconds.</p>
                    </div>
                </header>
                <footer class="entry-action-dialog-actions">
                    <MudButton Variant="Variant.Text" OnClick="DismissDeleteConfirmation" Disabled="@IsDeletePending">
                        Keep flight
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteEntryAsync" Disabled="@IsDeletePending" StartIcon="@Icons.Material.Filled.DeleteOutline">
                        Delete flight
                    </MudButton>
                </footer>
            </section>
        </div>
    }

    <section class="flight-detail-page">
        <NavLink class="page-back-link" href="/flights?view=entries">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />
            <span>Back to Logbook</span>
        </NavLink>
        <header class="entry-header entry-action-header">
            <div class="entry-action-context">
                <h1>Flight details</h1>
                <span class="entry-draft-status">
                    <span class="entry-draft-status-dot" aria-hidden="true"></span>
                    @MobileLogbookSession.FormatHours(MobileLogbookSession.WorkbookLoggedTime(CurrentEntry.Entry)) hr
                </span>
            </div>
            <div class="entry-header-actions" role="group" aria-label="Flight entry actions">
                <MudButton Class="entry-delete-action" Variant="Variant.Filled" Color="Color.Error" OnClick="RequestDeleteEntry" Disabled="@Session.IsStorageBlocked" aria-label="Delete flight" title="Delete flight">
                    Delete
                </MudButton>
                <MudButton Class="entry-save-action" Variant="Variant.Filled" Color="Color.Primary" OnClick="CloneEntry" aria-label="Clone flight" title="Clone flight">
                    Clone
                </MudButton>
            </div>
        </header>

        <section class="detail-hero">
            <div class="detail-primary-line">
                <strong>@Session.FormatRegistration(CurrentEntry.Entry)</strong>
                <strong>@Session.FormatRoute(CurrentEntry.Entry)</strong>
                <strong>@MobileLogbookSession.FormatHours(MobileLogbookSession.WorkbookLoggedTime(CurrentEntry.Entry))</strong>
            </div>
            <span>@MobileLogbookSession.FormatDate(CurrentEntry.Entry.Date) | @Session.FormatAircraft(CurrentEntry.Entry)</span>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Read first</span>
                    <h2>Record fields</h2>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditEntry">
                    Edit entry
                </MudButton>
            </div>
            <div class="record-field-groups" aria-label="Flight entry details">
                @foreach (var group in DetailGroups)
                {
                    <section class="record-field-group" aria-labelledby="@group.HeadingId">
                        <header class="record-field-group-heading">
                            <MudIcon Icon="@group.Icon" />
                            <h3 id="@group.HeadingId">@group.Heading</h3>
                        </header>
                        <dl class="record-field-list">
                            @foreach (var detail in group.Details)
                            {
                                <div class="record-field @(IsEmptyDetailValue(detail.Value) ? "record-field-empty" : null)">
                                    <dt>@detail.Label</dt>
                                    <dd>@detail.Value</dd>
                                </div>
                            }
                        </dl>
                    </section>
                }
            </div>
        </section>

        @if (History is not null)
        {
            <section class="form-section">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Immutable history</span>
                        <h2>Revisions</h2>
                    </div>
                </div>
                @foreach (var revisionId in History.RevisionHistory)
                {
                    var revision = Session.FindOperationV2(revisionId);
                    <div class="history-row">
                        <div>
                            <strong>@revision.Kind</strong>
                            <span>@MobileLogbookSession.FormatTimestamp(revision.CreatedAt)</span>
                        </div>
                        <span>@revision.RevisionId.Value</span>
                    </div>
                }
            </section>
        }
    </section>
}

@code {
    [Parameter]
    public string? EntryId { get; set; }

    private bool ShowDeleteConfirmation { get; set; }

    private bool IsDeletePending { get; set; }

    private PortableLogbookMaterializedEntryV2? CurrentEntry => Session.FindCurrentEntryV2(EntryId);

    private PortableLogbookMaterializedEntryV2? History => CurrentEntry;

    private IReadOnlyList<DetailGroup> DetailGroups
    {
        get
        {
            if (CurrentEntry?.Entry is null)
            {
                return [];
            }

            var details = Session.EntryDetails(CurrentEntry.Entry).ToList();
            return
            [
                CreateDetailGroup("flight-summary-heading", "Flight", Icons.Material.Filled.Flight, EntryDetailGroup.Flight, details),
                CreateDetailGroup("crew-route-heading", "Crew and route", Icons.Material.Filled.Route, EntryDetailGroup.CrewAndRoute, details),
                CreateDetailGroup("checks-heading", "Checks", Icons.Material.Filled.FactCheck, EntryDetailGroup.Checks, details),
                CreateDetailGroup("logged-time-heading", "Logged time", Icons.Material.Filled.Schedule, EntryDetailGroup.LoggedTime, details),
                CreateDetailGroup("custom-fields-heading", "Custom fields", Icons.Material.Filled.Tune, EntryDetailGroup.CustomFields, details),
                CreateDetailGroup("landings-approaches-heading", "Landings and approaches", Icons.Material.Filled.FlightLand, EntryDetailGroup.LandingsAndApproaches, details)
            ];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
    }

    private static DetailGroup CreateDetailGroup(
        string headingId,
        string heading,
        string icon,
        EntryDetailGroup group,
        IReadOnlyList<EntryDetail> details) =>
        new(headingId, heading, icon, details.Where(detail => detail.Group == group).ToList());

    private static bool IsEmptyDetailValue(string value) =>
        value == "-";

    private void EditEntry()
    {
        if (CurrentEntry is null)
        {
            return;
        }

        Navigation.NavigateTo($"/flights/{CurrentEntry.EntryId.Value}/edit");
    }

    private void CloneEntry()
    {
        if (CurrentEntry?.Entry is null)
        {
            return;
        }

        Session.CloneWorkbookEntry(CurrentEntry.Entry);
        Navigation.NavigateTo("/flights/new");
    }

    private void RequestDeleteEntry()
    {
        if (CurrentEntry is not null && !Session.IsStorageBlocked)
        {
            ShowDeleteConfirmation = true;
        }
    }

    private void DismissDeleteConfirmation()
    {
        if (!IsDeletePending)
        {
            ShowDeleteConfirmation = false;
        }
    }

    private async Task ConfirmDeleteEntryAsync()
    {
        if (CurrentEntry is null || IsDeletePending || Session.IsStorageBlocked)
        {
            return;
        }

        IsDeletePending = true;
        try
        {
            await Session.DeleteWorkbookEntryAsync(CurrentEntry);
            Navigation.NavigateTo("/flights?view=entries", replace: true);
        }
        finally
        {
            IsDeletePending = false;
        }
    }

    private sealed record DetailGroup(
        string HeadingId,
        string Heading,
        string Icon,
        IReadOnlyList<EntryDetail> Details);
}
