@page "/charts"
@inject MobileLogbookSession Session
@inject BrowserLogbookStore Store
@inject TimeProvider Clock
@implements IDisposable

<PageTitle>Charts &amp; Stats | FlightLogX</PageTitle>

<section class="analytics-page" aria-labelledby="charts-heading">
    <div class="analytics-heading">
    <h1 id="charts-heading">Charts &amp; Stats</h1>
    @if (Session.IsLoaded && !Session.IsStorageBlocked)
    {
        <FilterToggleButton Count="@FilterCount" @bind-Expanded="showFilters" />
    }
    </div>
    @if (Session.IsLoaded && !Session.IsStorageBlocked)
    {
        <div class="analytics-filter-panel" hidden="@(!showFilters)">
        <div class="analytics-filters" aria-label="Charts and statistics filters">
            <div class="date-range-fields">
                <label>Start date
                    <input id="analytics-from" type="date" max="@to?.ToString("yyyy-MM-dd")" @bind="from" @bind:after="Recalculate" />
                </label>
                <label>End date
                    <input id="analytics-to" type="date" min="@from?.ToString("yyyy-MM-dd")" @bind="to" @bind:after="Recalculate" />
                </label>
            </div>
            <MudSelect T="string" Label="Aircraft type" Placeholder="All types" MultiSelection="true" SelectAll="true"
                       Clearable="true" Variant="Variant.Outlined" SelectedValues="aircraftTypes" SelectedValuesChanged="SetAircraftTypes"
                       Comparer="StringComparer.OrdinalIgnoreCase" Class="analytics-type-filter">
                @foreach (var value in types) { <MudSelectItem T="string" Value="@value">@value</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" Label="Registration" Placeholder="All registrations" MultiSelection="true" SelectAll="true"
                       Clearable="true" Variant="Variant.Outlined" SelectedValues="selectedRegistrations" SelectedValuesChanged="SetRegistrations"
                       Comparer="StringComparer.OrdinalIgnoreCase" Class="analytics-registration-filter">
                @foreach (var value in registrations) { <MudSelectItem T="string" Value="@value">@value</MudSelectItem> }
            </MudSelect>
        </div>
        </div>
    }
    @if (!Session.IsLoaded)
    {
        <section class="ui-state" role="status">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <span>Loading Charts &amp; Stats</span>
        </section>
    }
    else if (Session.IsStorageBlocked)
    {
        <MudAlert Severity="Severity.Error">@Session.StorageError</MudAlert>
    }
    else
    {
        @if (HasFilters)
        {
        <div class="analytics-filter-summary" role="status">
            <span>@PeriodLabel · @(aircraftTypes.Length == 0 ? "All types" : string.Join(", ", aircraftTypes)) · @(selectedRegistrations.Length == 0 ? "All registrations" : string.Join(", ", selectedRegistrations))
                @if (from is not null) { <span> · From @from.Value.ToString("d MMM yyyy")</span> }
                @if (to is not null) { <span> · To @to.Value.ToString("d MMM yyyy")</span> }
            </span>
            @if (HasFilters) { <MudButton OnClick="ClearFilters" Variant="Variant.Text" Color="Color.Primary">Clear filters</MudButton> }
        </div>
        }
        @if (filterError is not null)
        {
            <MudAlert Severity="Severity.Error" role="alert">@filterError</MudAlert>
        }
        <MudTabs Class="analytics-tabs segmented-tabs" KeepPanelsAlive="true" MinimumTabWidth="0">
            <MudTabPanel Text="Charts">
                @if (analytics is not null)
                {
                    @if (analytics.MissingDateEntries > 0)
                    {
                        <MudAlert Severity="Severity.Warning">@analytics.MissingDateEntries entries have no valid date and are excluded.</MudAlert>
                    }
                    @if (analytics.FlightCount == 0)
                    {
                        <section class="ui-state" role="status">No flying entries in this selection. Change or clear filters to see your flying history.</section>
                    }
                    else
                    {
                        <section class="analytics-chart" aria-labelledby="hours-year-heading">
                            <h2 id="hours-year-heading">Hours by year</h2>
                            <p class="analytics-selection">@MobileLogbookSession.FormatHours(analytics.FlyingHours) flying hours · @analytics.FlightCount flights.</p>
                            <AnalyticsPlot Title="Hours by year" Data="yearPlot" Height="205" />
                            <ul class="analytics-year-legend" aria-label="Year chart categories">
                                @foreach (var series in yearPlot.Series)
                                {
                                    <li><span class="analytics-swatch" style="background: @series.Color" aria-hidden="true"></span>@series.Name</li>
                                }
                            </ul>
                            <div class="visually-hidden">
                                <table><caption>Hours by year and category</caption><thead><tr><th scope="col">Year / category</th><th scope="col">Hours</th></tr></thead><tbody>
                                    @foreach (var year in analytics.HoursByYear)
                                    {
                                        <tr><th scope="row">@year.Year total</th><td>@MobileLogbookSession.FormatHours(year.Categories.Sum(value => value.Value))</td></tr>
                                        @foreach (var category in year.Categories)
                                        {
                                            <tr><th scope="row">@year.Year · @category.Name</th><td>@MobileLogbookSession.FormatHours(category.Value)</td></tr>
                                        }
                                    }
                                </tbody></table>
                            </div>
                        </section>
                        <section class="analytics-chart" aria-labelledby="hours-total-heading">
                            <h2 id="hours-total-heading">Total hours over time</h2>
                            <p class="analytics-selection">@MobileLogbookSession.FormatHours(analytics.FlyingHours) total flying hours.</p>
                            <AnalyticsPlot Title="Total hours over time" Data="timePlot" Height="210" />
                            <div class="visually-hidden">
                                <table><caption>Cumulative flying hours</caption><thead><tr><th scope="col">Date</th><th scope="col">Hours</th></tr></thead><tbody>
                                    @foreach (var point in analytics.CumulativeHours)
                                    {
                                        <tr><th scope="row">@point.Date.ToString("d MMM yyyy")</th><td>@MobileLogbookSession.FormatHours(point.Hours)</td></tr>
                                    }
                                </tbody></table>
                            </div>
                        </section>
                        <section class="analytics-chart" aria-labelledby="hours-category-heading">
                            <h2 id="hours-category-heading">Hours by category</h2>
                            <AnalyticsPlot Title="Hours by category" Data="categoryPlot" Height="240" />
                            <ul class="analytics-legend" aria-label="Category and hours legend">
                                @foreach (var series in categoryPlot.Series)
                                {
                                    <li><span><span class="analytics-swatch" style="background: @series.Color" aria-hidden="true"></span>@series.Name</span><strong>@MobileLogbookSession.FormatHours(series.Values[0])</strong></li>
                                }
                            </ul>
                            <div class="visually-hidden">
                                <table><caption>Flying hours by category</caption><thead><tr><th scope="col">Category</th><th scope="col">Hours</th></tr></thead><tbody>
                                    @foreach (var category in analytics.HoursByCategory)
                                    {
                                        <tr><th scope="row">@category.Name</th><td>@MobileLogbookSession.FormatHours(category.Value)</td></tr>
                                    }
                                </tbody></table>
                            </div>
                        </section>
                        <AnalyticsRankingChart Title="Top five registrations" Values="analytics.TopRegistrations" />
                        <AnalyticsRankingChart Title="Top five aircraft types" Values="analytics.TopTypes" />
                        <AnalyticsRankingChart Title="Top ten airports" Values="airportValues" Counts="true" />
                    }
                }
            </MudTabPanel>
            <MudTabPanel Text="Stats">
                <details class="analytics-bases" aria-labelledby="analytics-bases-heading">
                    <summary id="analytics-bases-heading"><span>Base airports · @baseAirports.Length selected</span><MudIcon Icon="@Icons.Material.Filled.ExpandMore" aria-hidden="true" /></summary>
                    <p>Choose airports to exclude from the non-base visit record. Saved for this logbook on this device only.</p>
                    @if (basesError is not null)
                    {
                        <MudAlert Severity="Severity.Error" role="alert">@basesError</MudAlert>
                        @if (!basesAvailable) { <MudButton OnClick="LoadBasesAsync">Retry loading base airports</MudButton> }
                    }
                    <div class="analytics-base-controls">
                        <label class="totals-filter-field">Airport code
                            <input id="analytics-base-code" type="text" @bind="baseCode" list="analytics-base-suggestions" disabled="@(!basesAvailable || savingBases)" />
                        </label>
                        <datalist id="analytics-base-suggestions">
                            @foreach (var code in MobileAirportSuggestions.Create(Session.CurrentEntriesV2))
                            {
                                @if (MobileAirportCatalog.Default.TryFind(code, out var airport)) { <option value="@airport.Icao">@airport.Name</option> }
                            }
                        </datalist>
                        <MudButton OnClick="AddBaseAsync" Disabled="@(!basesAvailable || savingBases || string.IsNullOrWhiteSpace(baseCode))">Add base airport</MudButton>
                    </div>
                    <p>Enter a catalogue airport code, such as YSSY or SY. You can add more than one airport.</p>
                    <ul class="analytics-base-list" aria-label="Saved base airports">
                        @foreach (var code in baseAirports)
                        {
                            <li><span>@BaseLabel(code)</span><MudButton OnClick="@(() => SaveBasesAsync(baseAirports.Where(value => value != code).ToArray()))" Disabled="@savingBases" aria-label="@($"Remove base airport {code}")">Remove</MudButton></li>
                        }
                    </ul>
                </details>
                @if (analytics is not null)
                {
                    <p class="analytics-selection">@PeriodLabel · @MobileLogbookSession.FormatHours(analytics.FlyingHours) flying hours · @analytics.FlightCount flights.</p>
                    @if (analytics.MissingDateEntries > 0) { <MudAlert Severity="Severity.Warning">@analytics.MissingDateEntries entries have no valid date and are excluded.</MudAlert> }
                    <AnalyticsStatistics Analytics="analytics" PeriodLabel="@PeriodLabel" BasesAvailable="basesAvailable" />
                }
            </MudTabPanel>
        </MudTabs>
    }
</section>

@code {
    private DateOnly? from;
    private DateOnly? to;
    private string[] aircraftTypes = [];
    private string[] selectedRegistrations = [];
    private string[] types = [];
    private string[] registrations = [];
    private string? filterError;
    private bool showFilters;
    private MobileLogbookAnalytics? analytics;
    private string[] baseAirports = [];
    private string baseCode = "";
    private string? basesError;
    private bool basesAvailable;
    private bool savingBases;
    private LogbookId? basesLogbookId;
    private ITimer? dateTimer;
    private DateOnly calculatedDate;
    private bool disposed;
    private MobileAnalyticsPlotData yearPlot = new("year", [], []);
    private MobileAnalyticsPlotData timePlot = new("time", [], []);
    private MobileAnalyticsPlotData categoryPlot = new("pie", [], []);
    private MobileAnalyticsValue[] airportValues = [];
    private readonly string[] categoryPalette = ["#7b9ccb", "#a7b9d3", "#63b9bb", "#a29bc7", "#397e63", "#a4b98e", "#7897a8", "#aec2ca", "#e4b363", "#bb8fa4", "#6a9272", "#a7c3ad", "#ba8e80", "#d7b3a7"];
    private bool HasFilters => from is not null || to is not null || aircraftTypes.Length > 0 || selectedRegistrations.Length > 0;
    private int FilterCount => (from is not null || to is not null ? 1 : 0) + (aircraftTypes.Length > 0 ? 1 : 0) + (selectedRegistrations.Length > 0 ? 1 : 0);
    private string PeriodLabel => from is not null || to is not null ? "Selected period" : "All time";

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
        if (disposed) return;
        Session.WorkbookStateChanged += OnWorkbookStateChanged;
        await LoadBasesAsync();
        if (disposed) return;
        RefreshChoices();
        dateTimer = Clock.CreateTimer(_ => OnDateTick(), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private async Task LoadBasesAsync()
    {
        if (Session.IsStorageBlocked) return;
        var logbookId = Session.DocumentV2.LogbookId;
        basesLogbookId = logbookId;
        baseAirports = [];
        basesAvailable = false;
        basesError = null;
        Recalculate();
        StateHasChanged();
        try
        {
            var codes = await Store.LoadBaseAirportsAsync(logbookId);
            if (disposed || Session.DocumentV2.LogbookId != logbookId) return;
            baseAirports = codes;
            basesAvailable = true;
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or System.Text.Json.JsonException or FormatException)
        {
            if (disposed || Session.DocumentV2.LogbookId != logbookId) return;
            basesAvailable = false;
            basesError = "Saved base airports could not be loaded. Retry to use or change them.";
        }
        Recalculate();
    }

    private async Task AddBaseAsync()
    {
        if (!MobileAirportCatalog.Default.TryFind(baseCode, out var airport))
        {
            basesError = "Airport code not found. Choose a code from the airport catalogue.";
            return;
        }
        if (await SaveBasesAsync(baseAirports.Append(airport.Icao).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray()))
            baseCode = "";
    }

    private async Task<bool> SaveBasesAsync(string[] codes)
    {
        if (!basesAvailable || savingBases) return false;
        savingBases = true;
        basesError = null;
        var logbookId = Session.DocumentV2.LogbookId;
        try
        {
            await Store.SaveBaseAirportsAsync(logbookId, codes);
            if (disposed || Session.DocumentV2.LogbookId != logbookId) return false;
            baseAirports = codes;
            Recalculate();
            return true;
        }
        catch (Microsoft.JSInterop.JSException)
        {
            if (disposed || Session.DocumentV2.LogbookId != logbookId) return false;
            basesError = "Base airports could not be saved. Your previous selections are kept; try again.";
            return false;
        }
        finally { savingBases = false; }
    }

    private static string BaseLabel(string code) => MobileAirportCatalog.Default.TryFind(code, out var airport) ? $"{airport.Icao} · {airport.Name}" : code;

    private void RefreshChoices()
    {
        types = Choices(entry => entry.Type, aircraftTypes);
        registrations = Choices(entry => entry.Reg, selectedRegistrations);
    }

    private void OnWorkbookStateChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        RefreshChoices();
        if (basesLogbookId != Session.DocumentV2.LogbookId)
            await LoadBasesAsync();
        else
            Recalculate();
        if (!disposed) StateHasChanged();
    });

    private void OnDateTick() => _ = InvokeAsync(() =>
    {
        if (disposed || calculatedDate == LocalToday) return;
        Recalculate();
        StateHasChanged();
    });

    private DateOnly LocalToday => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    public void Dispose()
    {
        disposed = true;
        Session.WorkbookStateChanged -= OnWorkbookStateChanged;
        dateTimer?.Dispose();
    }

    private string[] Choices(Func<PortableLogbookWorkbookEntry, string?> select, string[] selected) => Session.CurrentEntriesV2
        .Select(item => select(item.Entry!)).Concat(selected).Where(value => !string.IsNullOrWhiteSpace(value)).Select(value => value!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();

    private void SetAircraftTypes(IEnumerable<string> values) { aircraftTypes = values.ToArray(); Recalculate(); }
    private void SetRegistrations(IEnumerable<string> values) { selectedRegistrations = values.ToArray(); Recalculate(); }

    private void Recalculate()
    {
        analytics = null;
        filterError = null;
        calculatedDate = LocalToday;
        if (Session.IsStorageBlocked) return;
        if (from > to)
        {
            filterError = "Choose a Start date on or before the End date.";
            return;
        }
        analytics = MobileLogbookAnalytics.Create(Session.CurrentEntriesV2, new(from, to, aircraftTypes, selectedRegistrations),
            calculatedDate, baseAirports, MobileAirportCatalog.Default);
        var activeCategories = analytics.HoursByCategory.Select((category, index) => (category, index))
            .Where(item => item.category.Value > 0).ToArray();
        yearPlot = new("year", analytics.HoursByYear.Select(year => year.Year.ToString()).ToArray(),
            activeCategories.Select(item => new MobileAnalyticsPlotSeries(item.category.Name,
                analytics.HoursByYear.Select(year => year.Categories[item.index].Value).ToArray(), categoryPalette[item.index])).ToArray());
        timePlot = new("time", analytics.CumulativeHours.Select(point => point.Date.ToString("yyyy-MM-dd")).ToArray(),
            [new("Flying hours", analytics.CumulativeHours.Select(point => point.Hours).ToArray(), "")]);
        categoryPlot = new("pie", activeCategories.Select(item => item.category.Name).ToArray(),
            activeCategories.Select(item => new MobileAnalyticsPlotSeries(item.category.Name, [item.category.Value], categoryPalette[item.index])).ToArray());
        airportValues = analytics.TopAirports.Select(value => new MobileAnalyticsValue($"{value.Airport.Icao} · {value.Airport.Name}", value.Visits)).ToArray();
    }

    private void ClearFilters()
    {
        from = to = null;
        aircraftTypes = selectedRegistrations = [];
        Recalculate();
    }
}
