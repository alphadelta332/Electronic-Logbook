@page "/charts"

<PageTitle>Charts | LogbookOne</PageTitle>

<section class="future-feature-page" aria-labelledby="charts-heading">
    <header class="entry-header">
        <div>
            <span class="eyebrow">Future feature</span>
            <h1 id="charts-heading">Charts</h1>
        </div>
        <span class="draft-pill">Coming soon</span>
    </header>

    <section class="future-feature-hero" aria-label="Charts preview">
        <span class="future-feature-icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.BarChart" />
        </span>
        <div>
            <strong>See your experience grow</strong>
            <p>Turn logbook totals into clear trends across time, aircraft and flying activity.</p>
        </div>
    </section>

    <section class="notice-panel">
        <MudIcon Icon="@Icons.Material.Filled.Schedule" />
        <div>
            <strong>Planned after the first release</strong>
            <span>This page reserves a home for visual reporting without presenting the feature as available today.</span>
        </div>
    </section>
</section>
