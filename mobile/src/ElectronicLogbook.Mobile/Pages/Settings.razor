@page "/settings"
@inject MobileLogbookSession Session
@inject MobileUiPreferenceState UiPreferences
@inject BrowserFileStore FileStore

<PageTitle>Settings</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading settings</span>
    </section>
}
else
{
    <section class="settings-page">
        <header class="entry-header">
            <div>
                <span class="eyebrow">Settings</span>
                <h1>Device copy</h1>
            </div>
            <span class="draft-pill">@Session.PackageKeyStatus</span>
        </header>

        <section class="notice-panel">
            <MudIcon Icon="@Icons.Material.Filled.SyncLock" />
            <div>
                <strong>Package exchange</strong>
                <span>@Session.ExchangeStatus.BackupNotice</span>
                <span>@Session.PackageKeyNotice</span>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Appearance</span>
                    <h2>Theme</h2>
                </div>
                <span class="draft-pill">@UiPreferences.ThemeMode</span>
            </div>
            <div class="segmented-control" aria-label="Appearance">
                <button type="button" class="@ThemeButtonClass("System")" @onclick="SetSystemThemeModeAsync">System</button>
                <button type="button" class="@ThemeButtonClass("Light")" @onclick="SetLightThemeModeAsync">Light</button>
                <button type="button" class="@ThemeButtonClass("Dark")" @onclick="SetDarkThemeModeAsync">Dark</button>
            </div>
            <div class="accent-picker" aria-label="Accent colour">
                @foreach (var accent in MobileUiPreferences.AccentOptions)
                {
                    <button type="button"
                            class="@AccentButtonClass(accent)"
                            title="@accent accent"
                            aria-label="@accent accent"
                            aria-pressed="@(UiPreferences.Accent == accent)"
                            data-accent="@accent.ToLowerInvariant()"
                            @onclick="() => SetAccentAsync(accent)">
                        <span aria-hidden="true"></span>
                        <span>@accent</span>
                    </button>
                }
            </div>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Device health</span>
                    <h2>Offline copy and backup</h2>
                </div>
                <span class="draft-pill">@DeviceHealthLabel</span>
            </div>
            <div class="device-health-grid">
                <article class="device-health-item">
                    <span>Local storage</span>
                    <strong>@(Session.IsStorageBlocked ? "Needs attention" : "Ready")</strong>
                    <small>@(Session.IsStorageBlocked ? Session.StorageError : "Workbook-faithful data is available offline on this device.")</small>
                </article>
                <article class="device-health-item">
                    <span>Recovery key</span>
                    <strong>@Session.PackageKeyStatus</strong>
                    <small>@Session.PackageKeyNotice</small>
                </article>
                <article class="device-health-item">
                    <span>Workbook backup</span>
                    <strong>@BackupHealthLabel</strong>
                    <small>@BackupHealthDetail</small>
                </article>
                <article class="device-health-item">
                    <span>Package history</span>
                    <strong>@Session.ImportReceipts.Count import(s)</strong>
                    <small>@ImportHealthDetail</small>
                </article>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Workbook data</span>
                    <h2>Import, export, recovery</h2>
                </div>
            </div>
            <MudButton Href="/exchange" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.IosShare">
                Open exchange workspace
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportDeviceStateAsync" Disabled="@(Session.IsStorageBlocked || IsDeviceStateExportBusy)">
                Export device state
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(DeviceStateExportMessage))
            {
                <span class="settings-status-line">@DeviceStateExportMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(DeviceStateExportError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@DeviceStateExportError</span>
            }
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Support</span>
                    <h2>Local summary</h2>
                </div>
            </div>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Summarize" OnClick="ExportSupportSummaryAsync" Disabled="@(Session.IsStorageBlocked || IsSupportSummaryBusy)">
                Support summary
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(SupportSummaryMessage))
            {
                <span class="settings-status-line">@SupportSummaryMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(SupportSummaryError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@SupportSummaryError</span>
            }
        </section>
    </section>
}

@code {
    private bool IsSupportSummaryBusy { get; set; }
    private bool IsDeviceStateExportBusy { get; set; }
    private string? SupportSummaryMessage { get; set; }
    private string? SupportSummaryError { get; set; }
    private string? DeviceStateExportMessage { get; set; }
    private string? DeviceStateExportError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
        await UiPreferences.EnsureLoadedAsync();
    }

    private Task SetSystemThemeModeAsync() => UiPreferences.SetThemeModeAsync("System");

    private Task SetLightThemeModeAsync() => UiPreferences.SetThemeModeAsync("Light");

    private Task SetDarkThemeModeAsync() => UiPreferences.SetThemeModeAsync("Dark");

    private Task SetAccentAsync(string accent) => UiPreferences.SetAccentAsync(accent);

    private string ThemeButtonClass(string themeMode) =>
        UiPreferences.ThemeMode == themeMode ? "active" : string.Empty;

    private string AccentButtonClass(string accent) =>
        UiPreferences.Accent == accent ? "accent-option active" : "accent-option";

    private string DeviceHealthLabel => Session.IsStorageBlocked || Session.PackageKeyStatus == "Unavailable"
        ? "Needs attention"
        : Session.ExchangeStatus.HasUnexportedChanges
            ? "Backup due"
            : "Ready";

    private string BackupHealthLabel => Session.ExchangeStatus.HasUnexportedChanges
        ? "Backup due"
        : Session.LastSuccessfulExportAt is null
            ? "No export yet"
            : "Up to date";

    private string BackupHealthDetail => Session.ExchangeStatus.HasUnexportedChanges
        ? $"{Session.ExchangeStatus.PendingOperationCount} operation(s) are ready to export."
        : Session.LastSuccessfulExportAt is DateTimeOffset exportedAt
            ? $"Last exported {FormatTimestamp(exportedAt)}."
            : "Import an authoritative workbook package before relying on this device copy.";

    private string ImportHealthDetail => Session.ExchangeStatus.LastSuccessfulImportAt is DateTimeOffset importedAt
        ? $"Last imported {FormatTimestamp(importedAt)}."
        : "No workbook package has been imported on this device yet.";

    private static string FormatTimestamp(DateTimeOffset value) => value.ToLocalTime().ToString("dd MMM yyyy, HH:mm");

    private async Task ExportSupportSummaryAsync()
    {
        if (Session.IsStorageBlocked || IsSupportSummaryBusy)
        {
            return;
        }

        IsSupportSummaryBusy = true;
        SupportSummaryMessage = null;
        SupportSummaryError = null;
        try
        {
            var result = await MobileSupportSummaryExportWorkflow.ExportAsync(
                Session.DocumentV2,
                FileStore,
                DateTimeOffset.UtcNow);
            SupportSummaryMessage = $"Exported {result.FileName}.";
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or JSException)
        {
            SupportSummaryError = ex.Message;
        }
        finally
        {
            IsSupportSummaryBusy = false;
        }
    }

    private async Task ExportDeviceStateAsync()
    {
        if (Session.IsStorageBlocked || IsDeviceStateExportBusy)
        {
            return;
        }

        IsDeviceStateExportBusy = true;
        DeviceStateExportMessage = null;
        DeviceStateExportError = null;
        try
        {
            var result = await MobileDeviceStateExportWorkflow.ExportAsync(
                new BrowserLogbookStateV2(
                    Session.DocumentV2,
                    Session.ImportReceipts,
                    Session.LastSuccessfulExportAt,
                    Session.LastSuccessfulExport),
                FileStore,
                DateTimeOffset.UtcNow);
            DeviceStateExportMessage = $"Exported {result.FileName}.";
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or JSException)
        {
            DeviceStateExportError = ex.Message;
        }
        finally
        {
            IsDeviceStateExportBusy = false;
        }
    }
}
