@page "/settings"
@implements IDisposable
@inject MobileLogbookSession Session
@inject MobileUiPreferenceState UiPreferences
@inject BrowserFileStore FileStore
@inject IJSRuntime JsRuntime

<PageTitle>Account and sync</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading settings</span>
    </section>
}
else
{
    <section class="settings-page">
        <section class="form-section settings-overview-card" aria-labelledby="settings-heading">
            <div class="section-title-row">
                <h1 id="settings-heading">Account and sync</h1>
                <span class="draft-pill">@Session.HostedSyncStatusLabel</span>
            </div>
            <div class="settings-connection-summary" role="status" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Filled.SyncLock" />
                <div>
                    <strong>@(Session.HasHostedSync ? "Connected" : "Sign in required")</strong>
                    <span>@Session.HostedSyncStatusDetail</span>
                    <span>@AttentionGuidance</span>
                </div>
            </div>
            @if (Session.ShouldOfferHostedAuthentication)
            {
                <div class="field-grid">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@(IsGoogleSignInBusy ? Icons.Material.Filled.Sync : Icons.Material.Filled.AccountCircle)"
                               OnClick="SignInWithGoogleAsync"
                               Disabled="@IsAccountBusy"
                               aria-busy="@IsGoogleSignInBusy">
                        @(IsGoogleSignInBusy
                            ? "Signing in with Google…"
                            : Session.HasHostedSync ? "Reauthenticate with Google" : "Sign in with Google")
                    </MudButton>
                    <MudText Typo="Typo.caption">@(Session.HasHostedSync
                        ? "Sign in again to repair the account connection without deleting the local logbook."
                        : "Use the same Google account used for the workbook migration.")</MudText>
                </div>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync" OnClick="SyncNowAsync" Disabled="@(!Session.HasHostedSync || Session.IsStorageBlocked || IsSyncBusy)">
                @(IsSyncBusy ? "Syncing…" : "Sync now")
            </MudButton>
            @if (IsGoogleSignInBusy)
            {
                <span class="settings-status-line" role="status" aria-live="polite">
                    Signing in with Google… This can take a moment.
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(AccountMessage))
            {
                <span class="settings-status-line" role="status">@AccountMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(AccountError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@AccountError</span>
            }
            @if (!string.IsNullOrWhiteSpace(SyncMessage))
            {
                <span class="settings-status-line" role="status">@SyncMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(SyncError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@SyncError</span>
            }
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <h2>Theme</h2>
                <span class="draft-pill">@UiPreferences.ThemeMode</span>
            </div>
            <div class="segmented-control" aria-label="Appearance">
                <button type="button" class="@ThemeButtonClass("System")" @onclick="SetSystemThemeModeAsync">System</button>
                <button type="button" class="@ThemeButtonClass("Light")" @onclick="SetLightThemeModeAsync">Light</button>
                <button type="button" class="@ThemeButtonClass("Dark")" @onclick="SetDarkThemeModeAsync">Dark</button>
            </div>
            <div class="accent-picker" aria-label="Accent colour">
                @foreach (var accent in MobileUiPreferences.AccentOptions)
                {
                    <button type="button"
                            class="@AccentButtonClass(accent)"
                            title="@accent accent"
                            aria-label="@accent accent"
                            aria-pressed="@(UiPreferences.Accent == accent)"
                            data-accent="@accent.ToLowerInvariant()"
                            @onclick="() => SetAccentAsync(accent)">
                        <span aria-hidden="true"></span>
                        <span>@accent</span>
                    </button>
                }
            </div>
        </section>

        <section class="form-section" aria-labelledby="custom-entry-settings-heading">
            <div class="section-title-row">
                <h2 id="custom-entry-settings-heading">Custom entries</h2>
                <span class="draft-pill">@Session.WorkbookCustomFields.Count / @MobileCustomFieldSettings.MaximumActiveFields</span>
            </div>
            <div class="custom-entry-settings-list">
                @foreach (var fieldTotal in Session.WorkbookCustomFieldTotals)
                {
                    var fieldId = fieldTotal.Definition.Id;
                    var editorId = $"custom-entry-{fieldId.Value}";
                    var removalLocked = fieldTotal.Total != 0m;
                    <article class="custom-entry-setting">
                        <div class="custom-entry-setting-primary">
                            <div class="custom-entry-setting-name">
                                <label for="@editorId">Entry @fieldTotal.Definition.Order name</label>
                                <input id="@editorId"
                                       value="@CustomFieldLabel(fieldId)"
                                       maxlength="@MobileCustomFieldSettings.MaximumLabelLength"
                                       disabled="@(IsCustomFieldBusy || PendingCustomFieldRenameRequest?.FieldId == fieldId)"
                                       @oninput="args => SetCustomFieldLabel(fieldId, args.Value?.ToString())" />
                            </div>
                            <div class="custom-entry-setting-hours">
                                <span id="@($"{editorId}-hours")">Hours total</span>
                                <output aria-labelledby="@($"{editorId}-hours")">@fieldTotal.FormattedTotal</output>
                            </div>
                        </div>
                        <div class="custom-entry-number-format">
                            <span>Number format</span>
                            @if (UseNumberFormatPillPreview)
                            {
                                <MudToggleGroup T="CustomFieldNumberFormat"
                                                Value="@fieldTotal.Definition.EffectiveNumberFormat"
                                                ValueChanged="@(value => RequestCustomFieldNumberFormatAsync(fieldTotal.Definition, value))"
                                                SelectionMode="SelectionMode.SingleSelection"
                                                Size="Size.Small"
                                                Color="Color.Primary"
                                                Disabled="@IsCustomFieldBusy"
                                                inert="@IsCustomFieldActionRunning"
                                                Class="custom-entry-number-format-toggle rounded-pill"
                                                aria-label="@($"Number format for {fieldTotal.Definition.Label}")">
                                    <MudToggleItem Value="@CustomFieldNumberFormat.WholeNumbers"
                                                   Text="0"
                                                   aria-label="Whole numbers" />
                                    <MudToggleItem Value="@CustomFieldNumberFormat.Decimals"
                                                   Text="0.0"
                                                   aria-label="Decimals" />
                                </MudToggleGroup>
                            }
                            else
                            {
                                <MudSwitch T="bool"
                                           Value="@(fieldTotal.Definition.EffectiveNumberFormat == CustomFieldNumberFormat.WholeNumbers)"
                                           ValueChanged="@(value => RequestCustomFieldNumberFormatAsync(
                                               fieldTotal.Definition,
                                               value ? CustomFieldNumberFormat.WholeNumbers : CustomFieldNumberFormat.Decimals))"
                                           Label="@(fieldTotal.Definition.EffectiveNumberFormat == CustomFieldNumberFormat.WholeNumbers ? "Whole numbers" : "Decimals")"
                                           LabelPlacement="Placement.Start"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           UncheckedColor="Color.Default"
                                           Disabled="@IsCustomFieldBusy"
                                           AriaLabel="@($"Use whole numbers for {fieldTotal.Definition.Label}")" />
                            }
                        </div>
                        @if (PendingCustomFieldNumberFormatRequest is { } numberFormatRequest && numberFormatRequest.FieldId == fieldId)
                        {
                            <div class="custom-entry-number-format-warning" role="alert">
                                <strong>Some recorded values have decimals.</strong>
                                <span>@FractionalValueWarning(numberFormatRequest.FractionalValueCount) They will display rounded as whole numbers. Exact values will stay saved.</span>
                            </div>
                        }
                        @if (PendingCustomFieldRenameRequest is { } renameRequest && renameRequest.FieldId == fieldId)
                        {
                            <div class="custom-entry-rename-warning" role="alert">
                                <strong>Check this name describes the existing values.</strong>
                                <span><strong>@renameRequest.CurrentLabel</strong> will become <strong>@renameRequest.ProposedLabel</strong>.</span>
                                <span>This field currently totals @renameRequest.FormattedTotal. The total and all recorded values will stay unchanged.</span>
                            </div>
                        }
                        @if (PendingCustomFieldRemoval == fieldId)
                        {
                            <p class="custom-entry-removal-warning">
                                This hides the field from new flights and totals. Its encrypted history is retained.
                            </p>
                        }
                        <div class="custom-entry-setting-actions">
                            @if (PendingCustomFieldNumberFormatRequest?.FieldId == fieldId)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ConfirmCustomFieldNumberFormatAsync" Disabled="@IsCustomFieldBusy">
                                    Use whole numbers
                                </MudButton>
                                <MudButton Variant="Variant.Text" OnClick="CancelCustomFieldNumberFormat" Disabled="@IsCustomFieldBusy">
                                    Keep decimals
                                </MudButton>
                            }
                            else if (PendingCustomFieldRenameRequest?.FieldId == fieldId)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ConfirmCustomFieldRenameAsync" Disabled="@IsCustomFieldBusy">
                                    Confirm rename
                                </MudButton>
                                <MudButton Variant="Variant.Text" OnClick="CancelCustomFieldRename" Disabled="@IsCustomFieldBusy">
                                    Keep current name
                                </MudButton>
                            }
                            else if (PendingCustomFieldRemoval == fieldId)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => RemoveCustomFieldAsync(fieldId))" Disabled="@IsCustomFieldBusy">
                                    Confirm remove
                                </MudButton>
                                <MudButton Variant="Variant.Text" OnClick="CancelCustomFieldRemoval" Disabled="@IsCustomFieldBusy">
                                    Cancel
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Success" Class="custom-entry-default-action custom-entry-save-action" StartIcon="@Icons.Material.Filled.Save" OnClick="@(() => RequestCustomFieldRenameAsync(fieldTotal))" Disabled="@(IsCustomFieldBusy || !CustomFieldLabelChanged(fieldTotal.Definition))">
                                    Save name
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Class="@CustomFieldRemoveButtonClass(removalLocked)"
                                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                                           Ripple="@(!removalLocked)"
                                           OnClick="@(() => HandleCustomFieldRemoval(fieldTotal))"
                                           Disabled="@IsCustomFieldBusy"
                                           aria-disabled="@removalLocked">
                                    Remove
                                </MudButton>
                            }
                        </div>
                    </article>
                }
            </div>
            @if (Session.WorkbookCustomFields.Count < MobileCustomFieldSettings.MaximumActiveFields)
            {
                <div class="custom-entry-add-row">
                    <label for="new-custom-entry">New custom entry</label>
                    <input id="new-custom-entry"
                           value="@NewCustomFieldLabel"
                           maxlength="@MobileCustomFieldSettings.MaximumLabelLength"
                           disabled="@IsCustomFieldBusy"
                           placeholder="e.g. Night vision"
                           @oninput="args => NewCustomFieldLabel = args.Value?.ToString() ?? string.Empty" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddCustomFieldAsync" Disabled="@(IsCustomFieldBusy || string.IsNullOrWhiteSpace(NewCustomFieldLabel))">
                        Add custom entry
                    </MudButton>
                </div>
            }
            @if (IsCustomFieldBusy)
            {
                <span class="settings-status-line" role="status" aria-live="polite">Saving custom entries…</span>
            }
            @if (!string.IsNullOrWhiteSpace(CustomFieldMessage))
            {
                <span class="settings-status-line" role="status" aria-live="polite">@CustomFieldMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(CustomFieldError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@CustomFieldError</span>
            }
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <h2>Export logbook</h2>
                <span class="draft-pill">New file</span>
            </div>
            <div class="settings-connection-summary">
                <MudIcon Icon="@Icons.Material.Filled.FileDownload" />
                <div>
                    <strong>XLSX or UTF-8 CSV</strong>
                    <span>Create a new dated file from this app logbook. Existing workbooks are never opened or changed.</span>
                </div>
            </div>
            <MudButton Href="/export" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload">
                Export logbook
            </MudButton>
        </section>

        <details class="settings-advanced">
            <summary>
                <span>
                    <strong>Advanced settings</strong>
                    <small>Diagnostics, recovery, backups and Preview tools</small>
                </span>
            </summary>

        @if (IsPreviewUpdateAvailable)
        {
            <section class="form-section">
                <div class="section-title-row">
                    <h2>FlightLogX updates</h2>
                    <span class="draft-pill">Preview only</span>
                </div>
                <MudText Typo="Typo.body2">FlightLogX Preview checks automatically when you open the app. Check again here if support asks you to.</MudText>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SystemUpdate" OnClick="CheckForPreviewUpdateAsync" Disabled="@IsPreviewUpdateBusy">
                    @(IsPreviewUpdateBusy ? "Checking for update…" : "Check for Preview update")
                </MudButton>
                @if (!string.IsNullOrWhiteSpace(PreviewUpdateMessage))
                {
                    <span class="settings-status-line" role="status">@PreviewUpdateMessage</span>
                }
                @if (!string.IsNullOrWhiteSpace(PreviewUpdateError))
                {
                    <span class="settings-status-line settings-status-error" role="alert">@PreviewUpdateError</span>
                }
            </section>
        }

        <section class="form-section">
            <div class="section-title-row">
                <h2>Device health</h2>
                <span class="draft-pill">@DeviceHealthLabel</span>
            </div>
            <div class="device-health-grid">
                <article class="device-health-item">
                    <span>Local storage</span>
                    <strong>@(Session.IsStorageBlocked ? "Needs attention" : "Ready")</strong>
                    <small>@(Session.IsStorageBlocked ? Session.StorageError : "Workbook-faithful data is available offline on this device.")</small>
                </article>
                <article class="device-health-item">
                    <span>Device encryption</span>
                    <strong>@Session.PackageKeyStatus</strong>
                    <small>@Session.PackageKeyNotice</small>
                </article>
                <article class="device-health-item">
                    <span>Offline changes</span>
                    <strong>@BackupHealthLabel</strong>
                    <small>@BackupHealthDetail</small>
                </article>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <h2>Hosted sync details</h2>
                <span class="draft-pill">@Session.HostedSyncStatusLabel</span>
            </div>
            <div class="device-health-grid">
                <article class="device-health-item">
                    <span>Workbook migration</span>
                    <strong>@MigrationStatus</strong>
                    <small>@MigrationDetail</small>
                </article>
            </div>
            @if (!Session.HasHostedSync || Session.HostedSyncStatusLabel == "Needs attention")
            {
                <div class="connection-diagnostic-actions">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="RunConnectionPreflightAsync" Disabled="@IsConnectionDiagnosticBusy">
                        Run connection preflight
                    </MudButton>
                    @if (!Session.HasHostedSync)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Restore" OnClick="RecoverConnectionAsync" Disabled="@(!CanRecoverConnection)">
                            Recover retained connection
                        </MudButton>
                    }
                </div>
            }
            @if (Session.LastConnectionDiagnostics is { } diagnostics)
            {
                <article class="connection-diagnostic-report" role="status">
                    <div>
                        <span>Stage</span>
                        <strong>@diagnostics.CurrentStage</strong>
                    </div>
                    <div>
                        <span>Error code</span>
                        <strong>@diagnostics.ErrorCode</strong>
                    </div>
                    <small>@ConnectionRecoveryGuidance(diagnostics)</small>
                    <details>
                        <summary>Technical details</summary>
                        <pre>@diagnostics.ToRedactedJson()</pre>
                    </details>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyConnectionDiagnosticsAsync">
                        Copy redacted diagnostics
                    </MudButton>
                    @if (!string.IsNullOrWhiteSpace(ConnectionDiagnosticMessage))
                    {
                        <small>@ConnectionDiagnosticMessage</small>
                    }
                </article>
            }
            @if (Session.HostedSync is { } hostedSync && Session.HostedSyncDiagnostics is { } syncDiagnostics)
            {
                <details class="sync-diagnostics">
                    <summary>Sync diagnostics</summary>
                    <div class="device-health-grid">
                        <article class="device-health-item">
                            <span>Pending uploads</span>
                            <strong>@syncDiagnostics.PendingUploadCount</strong>
                            <small>Operations created on this device that have not been uploaded.</small>
                        </article>
                        <article class="device-health-item">
                            <span>Hosted position</span>
                            <strong>Revision @hostedSync.LastAcknowledgedHostedRevision</strong>
                            <small>Last attempted @FormatOptionalTimestamp(hostedSync.LastAttemptedAt); last synced @FormatOptionalTimestamp(hostedSync.LastSyncedAt).</small>
                        </article>
                        <article class="device-health-item">
                            <span>Current-device history</span>
                            <strong>@FormatOperationCount(syncDiagnostics.CurrentDeviceOperationCount)</strong>
                            <small>@syncDiagnostics.UploadedCurrentDeviceOperationCount are recorded as uploaded by this device.</small>
                        </article>
                        <article class="device-health-item">
                            <span>Other-device history</span>
                            <strong>@FormatOperationCount(syncDiagnostics.OtherDeviceHistory.Count)</strong>
                            <small>Downloaded or imported history is kept locally but is not part of this device's upload queue.</small>
                        </article>
                    </div>

                    <section class="sync-diagnostic-group">
                        <h3>Pending upload details</h3>
                        @if (syncDiagnostics.PendingUploads.Count == 0)
                        {
                            <small>No operations are waiting to upload.</small>
                        }
                        else
                        {
                            @foreach (var operation in syncDiagnostics.PendingUploads)
                            {
                                <article class="sync-operation-detail">
                                    <strong>@operation.KindLabel · @operation.FlightId</strong>
                                    <span>@FormatTimestamp(operation.CreatedAt)</span>
                                    @if (!string.IsNullOrWhiteSpace(operation.Detail))
                                    {
                                        <span>@operation.Detail</span>
                                    }
                                    <code>Revision @operation.RevisionId</code>
                                    <code>Device @operation.DeviceId</code>
                                </article>
                            }
                        }
                    </section>

                    <section class="sync-diagnostic-group">
                        <h3>Other-device history excluded from uploads</h3>
                        @if (syncDiagnostics.OtherDeviceHistory.Count == 0)
                        {
                            <small>No other-device operations are stored locally.</small>
                        }
                        else
                        {
                            @foreach (var operation in syncDiagnostics.OtherDeviceHistory.Take(10))
                            {
                                <article class="sync-operation-detail">
                                    <strong>@operation.KindLabel · @operation.FlightId</strong>
                                    <span>@FormatTimestamp(operation.CreatedAt)</span>
                                    @if (!string.IsNullOrWhiteSpace(operation.Detail))
                                    {
                                        <span>@operation.Detail</span>
                                    }
                                    <code>Revision @operation.RevisionId</code>
                                    <code>Device @operation.DeviceId</code>
                                </article>
                            }
                            @if (syncDiagnostics.OtherDeviceHistory.Count > 10)
                            {
                                <small>Showing the 10 most recent of @syncDiagnostics.OtherDeviceHistory.Count operations.</small>
                            }
                        }
                    </section>
                </details>
            }
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <h2>Support and account data</h2>
            </div>
            <div class="device-health-grid">
                <article class="device-health-item">
                    <span>Manual Package Exchange</span>
                    <strong>@Session.ImportReceipts.Count import(s)</strong>
                    <small>@ImportHealthDetail</small>
                </article>
                <article class="device-health-item">
                    <span>Account export</span>
                    <strong>Local only</strong>
                    <small>Exports stay on this device until you choose where to store or share them.</small>
                </article>
                <article class="device-health-item">
                    <span>Account deletion</span>
                    <strong>Support assisted</strong>
                    <small>Use the support summary when requesting account deletion or revoked-device recovery.</small>
                </article>
            </div>
            <details class="sync-diagnostics">
                <summary>Account sign-in and recovery fallback</summary>
                <MudText Typo="Typo.caption">Open these controls only when FlightLogX support asks you to use the email-code or recovery-code fallback.</MudText>
                <div class="field-grid">
                    <MudTextField @bind-Value="HostedEmail" InputType="InputType.Email" Label="Invited account email" HelperText="Enter the email address that received the FlightLogX code." Immediate="true" Disabled="@IsAccountBusy" />
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MarkEmailRead" OnClick="StartHostedSignInAsync" Disabled="@(IsAccountBusy || string.IsNullOrWhiteSpace(HostedEmail))">
                        Send sign-in code
                    </MudButton>
                    <MudTextField @bind-Value="HostedVerificationCode"
                                  InputType="InputType.Text"
                                  Label="Six-digit sign-in code"
                                  HelperText="Enter the code from the latest FlightLogX email. It expires after 10 minutes. Check your junk or spam folder if it does not arrive."
                                  Immediate="true"
                                  Disabled="@IsAccountBusy" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Password" OnClick="CompleteHostedSignInAsync" Disabled="@(IsAccountBusy || string.IsNullOrWhiteSpace(HostedEmail) || string.IsNullOrWhiteSpace(HostedVerificationCode))">
                        @(Session.HasHostedSync ? "Reauthenticate account" : "Connect account")
                    </MudButton>
                    @if (!string.IsNullOrWhiteSpace(FallbackAccountMessage))
                    {
                        <span class="settings-status-line" role="status">@FallbackAccountMessage</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(FallbackAccountError))
                    {
                        <span class="settings-status-line settings-status-error" role="alert">@FallbackAccountError</span>
                    }
                    @if (Session.ShouldOfferHostedAuthentication)
                    {
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Restore" OnClick="ResumeHostedSignInAsync" Disabled="@IsAccountBusy">
                            Resume verified sign-in
                        </MudButton>
                        <MudText Typo="Typo.caption">Recovery only: use after support confirms that email verification succeeded but device setup was interrupted.</MudText>
                        <MudTextField @bind-Value="AccountRecoveryCode" InputType="InputType.Password" Label="Recovery code" Immediate="true" Disabled="@IsAccountBusy" />
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key" OnClick="RecoverWithCodeAsync" Disabled="@(IsAccountBusy || string.IsNullOrWhiteSpace(AccountRecoveryCode))">
                            Recover with code
                        </MudButton>
                        <MudText Typo="Typo.caption">Fallback only: sign in first, then use the code saved when this logbook was created.</MudText>
                    }
                    else if (Session.HostedSyncStatusLabel != "Needs attention")
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddModerator" OnClick="LinkGoogleIdentityAsync" Disabled="@IsAccountBusy">
                            Add Google sign-in
                        </MudButton>
                        <MudText Typo="Typo.caption">Use this only for an older account that support confirms was first connected by email code. It does not create another logbook.</MudText>
                    }
                    @if (Session.IsRecoveryCodeConfirmationPending)
                    {
                        <section class="notice-panel" role="status" aria-live="polite">
                            <MudIcon Icon="@Icons.Material.Filled.Key" />
                            <div>
                                <strong>Save your recovery code</strong>
                                <span class="recovery-code-value">@Session.PendingRecoveryCode</span>
                                <span>Store it away from this phone. Enter it below to prove the saved copy works.</span>
                            </div>
                        </section>
                        <MudTextField @bind-Value="RecoveryCodeConfirmation" InputType="InputType.Password" Label="Enter saved recovery code" Immediate="true" Disabled="@IsAccountBusy" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.VerifiedUser" OnClick="ConfirmRecoveryCodeAsync" Disabled="@(IsAccountBusy || string.IsNullOrWhiteSpace(RecoveryCodeConfirmation))">
                            Confirm recovery code
                        </MudButton>
                    }
                </div>
            </details>
            <MudButton Href="/exchange" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Construction">
                Advanced recovery workspace
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportDeviceStateAsync" Disabled="@(Session.IsStorageBlocked || IsDeviceStateExportBusy)">
                Export account backup
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(DeviceStateExportMessage))
            {
                <span class="settings-status-line">@DeviceStateExportMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(DeviceStateExportError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@DeviceStateExportError</span>
            }
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <h2>Local summary</h2>
            </div>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Summarize" OnClick="ExportSupportSummaryAsync" Disabled="@(Session.IsStorageBlocked || IsSupportSummaryBusy)">
                Support summary
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(SupportSummaryMessage))
            {
                <span class="settings-status-line">@SupportSummaryMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(SupportSummaryError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@SupportSummaryError</span>
            }
        </section>
        </details>
    </section>
}

@code {
    private static readonly bool UseNumberFormatPillPreview = true;
    private bool IsSupportSummaryBusy { get; set; }
    private bool IsDeviceStateExportBusy { get; set; }
    private bool IsSyncBusy { get; set; }
    private bool IsAccountBusy { get; set; }
    private bool IsGoogleSignInBusy { get; set; }
    private bool IsConnectionDiagnosticBusy { get; set; }
    private bool IsPreviewUpdateAvailable { get; set; }
    private bool IsPreviewUpdateBusy { get; set; }
    private bool IsCustomFieldBusy { get; set; }
    private bool IsCustomFieldActionRunning { get; set; }
    private string HostedEmail { get; set; } = string.Empty;
    private string HostedVerificationCode { get; set; } = string.Empty;
    private string AccountRecoveryCode { get; set; } = string.Empty;
    private string RecoveryCodeConfirmation { get; set; } = string.Empty;
    private string NewCustomFieldLabel { get; set; } = string.Empty;
    private Dictionary<CustomFieldId, string> CustomFieldLabels { get; } = [];
    private CustomFieldRenameConfirmation? PendingCustomFieldRenameRequest { get; set; }
    private CustomFieldNumberFormatConfirmation? PendingCustomFieldNumberFormatRequest { get; set; }
    private CustomFieldId? PendingCustomFieldRemoval { get; set; }
    private string? SupportSummaryMessage { get; set; }
    private string? SupportSummaryError { get; set; }
    private string? DeviceStateExportMessage { get; set; }
    private string? DeviceStateExportError { get; set; }
    private string? SyncMessage { get; set; }
    private string? SyncError { get; set; }
    private string? AccountMessage { get; set; }
    private string? AccountError { get; set; }
    private string? FallbackAccountMessage { get; set; }
    private string? FallbackAccountError { get; set; }
    private string? ConnectionDiagnosticMessage { get; set; }
    private string? PreviewUpdateMessage { get; set; }
    private string? PreviewUpdateError { get; set; }
    private string? CustomFieldMessage { get; set; }
    private string? CustomFieldError { get; set; }

    private bool CanRecoverConnection =>
        !IsConnectionDiagnosticBusy
        && Session.LastConnectionDiagnostics is { Passed: true, CurrentStage: MobileConnectionStage.LOCAL_PLAN_CREATE };

    protected override async Task OnInitializedAsync()
    {
        Session.HostedSyncChanged += OnHostedSyncChanged;
        await Session.EnsureLoadedWorkbookAsync();
        RefreshCustomFieldEditors();
        await UiPreferences.EnsureLoadedAsync();
        try
        {
            IsPreviewUpdateAvailable = await JsRuntime.InvokeAsync<bool>(
                "electronicLogbookPreviewUpdates.isAvailable");
        }
        catch (JSException)
        {
            IsPreviewUpdateAvailable = false;
        }
    }

    public void Dispose() => Session.HostedSyncChanged -= OnHostedSyncChanged;

    private void OnHostedSyncChanged() => _ = InvokeAsync(() =>
    {
        if (!IsCustomFieldActionRunning)
        {
            RefreshCustomFieldEditors();
        }
        StateHasChanged();
    });

    private string CustomFieldLabel(CustomFieldId fieldId) =>
        CustomFieldLabels.GetValueOrDefault(fieldId, string.Empty);

    private void SetCustomFieldLabel(CustomFieldId fieldId, string? label) =>
        CustomFieldLabels[fieldId] = label ?? string.Empty;

    private bool CustomFieldLabelChanged(CustomFieldDefinition definition) =>
        !string.Equals(CustomFieldLabel(definition.Id).Trim(), definition.Label, StringComparison.Ordinal);

    private static string CustomFieldRemoveButtonClass(bool removalLocked) =>
        removalLocked
            ? "custom-entry-default-action custom-entry-remove-action custom-entry-action-disabled"
            : "custom-entry-default-action custom-entry-remove-action";

    private void RefreshCustomFieldEditors()
    {
        foreach (var definition in Session.WorkbookCustomFields)
        {
            CustomFieldLabels[definition.Id] = definition.Label;
        }
    }

    private async Task RequestCustomFieldRenameAsync(MobileCustomFieldTotal fieldTotal)
    {
        if (IsCustomFieldActionRunning)
        {
            return;
        }

        var proposedLabel = CustomFieldLabel(fieldTotal.Definition.Id).Trim();
        CustomFieldMessage = null;
        CustomFieldError = null;
        try
        {
            _ = MobileCustomFieldSettings.Rename(
                Session.AllWorkbookCustomFields,
                fieldTotal.Definition.Id,
                proposedLabel);
        }
        catch (InvalidOperationException ex)
        {
            CustomFieldError = ex.Message;
            return;
        }

        if (!MobileCustomFieldSettings.RenameRequiresConfirmation(fieldTotal.Total))
        {
            await RenameCustomFieldAsync(fieldTotal.Definition.Id, proposedLabel);
            return;
        }

        PendingCustomFieldRemoval = null;
        PendingCustomFieldNumberFormatRequest = null;
        PendingCustomFieldRenameRequest = new(
            fieldTotal.Definition.Id,
            fieldTotal.Definition.Label,
            proposedLabel,
            fieldTotal.FormattedTotal);
    }

    private async Task ConfirmCustomFieldRenameAsync()
    {
        if (PendingCustomFieldRenameRequest is not { } request)
        {
            return;
        }

        await RenameCustomFieldAsync(request.FieldId, request.ProposedLabel);
        if (CustomFieldError is null)
        {
            PendingCustomFieldRenameRequest = null;
        }
    }

    private void CancelCustomFieldRename()
    {
        PendingCustomFieldRenameRequest = null;
        RefreshCustomFieldEditors();
    }

    private async Task RenameCustomFieldAsync(CustomFieldId fieldId, string label) =>
        await RunCustomFieldActionAsync(
            () => Session.RenameWorkbookCustomFieldAsync(fieldId, label),
            "Custom entry name saved.");

    private async Task RequestCustomFieldNumberFormatAsync(
        CustomFieldDefinition definition,
        CustomFieldNumberFormat numberFormat)
    {
        if (IsCustomFieldActionRunning || definition.EffectiveNumberFormat == numberFormat)
        {
            return;
        }

        CustomFieldMessage = null;
        CustomFieldError = null;
        PendingCustomFieldRenameRequest = null;
        PendingCustomFieldRemoval = null;
        PendingCustomFieldNumberFormatRequest = null;
        if (numberFormat == CustomFieldNumberFormat.WholeNumbers)
        {
            var fractionalValueCount = MobileCustomFieldSettings.FractionalValueCount(
                Session.CurrentEntriesV2.Select(entry => entry.Entry!),
                definition.Id);
            if (fractionalValueCount > 0)
            {
                PendingCustomFieldNumberFormatRequest = new(definition.Id, fractionalValueCount);
                return;
            }
        }

        await SetCustomFieldNumberFormatAsync(definition.Id, numberFormat);
    }

    private async Task ConfirmCustomFieldNumberFormatAsync()
    {
        if (PendingCustomFieldNumberFormatRequest is not { } request)
        {
            return;
        }

        await SetCustomFieldNumberFormatAsync(request.FieldId, CustomFieldNumberFormat.WholeNumbers);
        if (CustomFieldError is null)
        {
            PendingCustomFieldNumberFormatRequest = null;
        }
    }

    private void CancelCustomFieldNumberFormat() => PendingCustomFieldNumberFormatRequest = null;

    private async Task SetCustomFieldNumberFormatAsync(
        CustomFieldId fieldId,
        CustomFieldNumberFormat numberFormat) =>
        await RunCustomFieldActionAsync(
            () => Session.SetWorkbookCustomFieldNumberFormatAsync(fieldId, numberFormat),
            numberFormat == CustomFieldNumberFormat.WholeNumbers
                ? "Custom entry now displays whole numbers."
                : "Custom entry now displays decimals.",
            refreshEditors: false,
            showBusyState: false);

    private static string FractionalValueWarning(int count) =>
        $"{count} recorded {(count == 1 ? "value has" : "values have")} a decimal.";

    private async Task AddCustomFieldAsync()
    {
        var label = NewCustomFieldLabel;
        await RunCustomFieldActionAsync(
            () => Session.AddWorkbookCustomFieldAsync(label),
            "Custom entry added.");
        if (CustomFieldError is null)
        {
            NewCustomFieldLabel = string.Empty;
        }
    }

    private void HandleCustomFieldRemoval(MobileCustomFieldTotal fieldTotal)
    {
        if (fieldTotal.Total == 0m)
        {
            RequestCustomFieldRemoval(fieldTotal.Definition.Id);
            return;
        }

        var definition = fieldTotal.Definition;
        var flightCount = MobileCustomFieldSettings.NonZeroValueCount(
            Session.CurrentEntriesV2.Select(entry => entry.Entry!),
            definition.Id);
        var flightWord = flightCount == 1 ? "flight has" : "flights have";
        var timeSuffix = definition.EffectiveNumberFormat == CustomFieldNumberFormat.Decimals
            ? " time"
            : string.Empty;
        var message = $"Unable to remove {definition.Label} field — {flightCount} {flightWord} logged {definition.Label}{timeSuffix}.";
        var destination = $"/flights?view=entries&customField={Uri.EscapeDataString(definition.Id.Value)}";

        Session.ShowActionFeedback(message, "Show me", destination);
    }

    private void RequestCustomFieldRemoval(CustomFieldId fieldId)
    {
        PendingCustomFieldRenameRequest = null;
        PendingCustomFieldNumberFormatRequest = null;
        PendingCustomFieldRemoval = fieldId;
    }

    private void CancelCustomFieldRemoval() => PendingCustomFieldRemoval = null;

    private async Task RemoveCustomFieldAsync(CustomFieldId fieldId)
    {
        await RunCustomFieldActionAsync(
            () => Session.RemoveWorkbookCustomFieldAsync(fieldId),
            "Custom entry removed.");
        if (CustomFieldError is null)
        {
            PendingCustomFieldRemoval = null;
        }
    }

    private async Task RunCustomFieldActionAsync(
        Func<Task> action,
        string successMessage,
        bool refreshEditors = true,
        bool showBusyState = true)
    {
        if (IsCustomFieldActionRunning)
        {
            return;
        }

        IsCustomFieldActionRunning = true;
        IsCustomFieldBusy = showBusyState;
        CustomFieldMessage = null;
        CustomFieldError = null;
        try
        {
            await action();
            if (refreshEditors)
            {
                RefreshCustomFieldEditors();
            }
            CustomFieldMessage = Session.HostedSync?.PendingConfigurationRevisionId is null
                ? successMessage
                : $"{successMessage} Saved on this device and waiting to sync.";
        }
        catch (InvalidOperationException ex)
        {
            CustomFieldError = ex.Message;
        }
        finally
        {
            IsCustomFieldBusy = false;
            IsCustomFieldActionRunning = false;
        }
    }

    private Task SetSystemThemeModeAsync() => UiPreferences.SetThemeModeAsync("System");

    private Task SetLightThemeModeAsync() => UiPreferences.SetThemeModeAsync("Light");

    private Task SetDarkThemeModeAsync() => UiPreferences.SetThemeModeAsync("Dark");

    private Task SetAccentAsync(string accent) => UiPreferences.SetAccentAsync(accent);

    private string ThemeButtonClass(string themeMode) =>
        UiPreferences.ThemeMode == themeMode ? "active" : string.Empty;

    private string AccentButtonClass(string accent) =>
        UiPreferences.Accent == accent ? "accent-option active" : "accent-option";

    private sealed record CustomFieldRenameConfirmation(
        CustomFieldId FieldId,
        string CurrentLabel,
        string ProposedLabel,
        string FormattedTotal);

    private sealed record CustomFieldNumberFormatConfirmation(
        CustomFieldId FieldId,
        int FractionalValueCount);

    private string DeviceHealthLabel => Session.IsStorageBlocked || Session.PackageKeyStatus == "Unavailable"
        ? "Needs attention"
        : Session.ExchangeStatus.HasUnexportedChanges
            ? "Backup due"
            : "Ready";

    private string BackupHealthLabel => Session.ExchangeStatus.HasUnexportedChanges
        ? "Backup due"
        : Session.LastSuccessfulExportAt is null
            ? "No export yet"
            : "Up to date";

    private string BackupHealthDetail => Session.ExchangeStatus.HasUnexportedChanges
        ? $"{Session.ExchangeStatus.PendingOperationCount} operation(s) are ready to export."
        : Session.LastSuccessfulExportAt is DateTimeOffset exportedAt
            ? $"Last exported {FormatTimestamp(exportedAt)}."
            : "Local edits are saved on this device first and will sync after account connection.";

    private string ImportHealthDetail => Session.ExchangeStatus.LastSuccessfulImportAt is DateTimeOffset importedAt
        ? $"Last imported {FormatTimestamp(importedAt)}."
        : "No manual workbook package has been imported on this device yet.";

    private string MigrationStatus => Session.WorkbookMigration is not null
        ? "Verified"
        : Session.CanMigrateWorkbook
            ? "Ready"
            : Session.CanPreviewWorkbookMigration
                ? "Compare"
            : Session.HasHostedSync
                ? "Unavailable"
                : "Sign in first";

    private string MigrationDetail => Session.WorkbookMigration is { } receipt
        ? $"{receipt.EntryCount} entries from {receipt.SourceFileName} were saved and read back successfully."
        : Session.CanMigrateWorkbook
            ? "Select a disposable .xlsm or .xlsx copy, review its values and totals, then migrate it once."
            : Session.CanPreviewWorkbookMigration
                ? "Compare a disposable workbook copy with this populated app logbook. Comparison is read only; migration remains blocked."
            : Session.HasHostedSync
                ? "Migration must happen before flights or manual packages are added to this app logbook."
                : "Connect and initialize the invited account before selecting a workbook.";

    private string AttentionGuidance => Session.HostedSyncStatusLabel switch
    {
        "Needs attention" => "You can reauthenticate here, or open Advanced settings to restore a lost key or recover a revoked device.",
        "Signing in" => "Finish sign-in with the six-digit code sent to the invited email. Check your junk or spam folder if it does not arrive.",
        "Offline" => "You can keep working; queued edits sync when the network returns.",
        _ => "Sync is automatic. Recovery and support tools are in Advanced settings."
    };

    private async Task StartHostedSignInAsync()
    {
        if (IsAccountBusy || string.IsNullOrWhiteSpace(HostedEmail))
        {
            return;
        }

        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        FallbackAccountMessage = null;
        FallbackAccountError = null;
        try
        {
            var signIn = await Session.StartHostedInviteAcceptanceAsync(HostedEmail);
            AccountMessage = $"Sign-in code sent to {signIn.DeliveryHint}. It expires after 10 minutes. Check your junk or spam folder if it does not arrive.";
            FallbackAccountMessage = AccountMessage;
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
            FallbackAccountError = AccountError;
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task CompleteHostedSignInAsync()
    {
        if (IsAccountBusy || string.IsNullOrWhiteSpace(HostedEmail) || string.IsNullOrWhiteSpace(HostedVerificationCode))
        {
            return;
        }

        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        FallbackAccountMessage = null;
        FallbackAccountError = null;
        try
        {
            await Session.CompleteHostedInviteAcceptanceAsync(HostedEmail, HostedVerificationCode);
            HostedVerificationCode = string.Empty;
            AccountMessage = Session.LastActionMessage ?? "Account connected.";
            FallbackAccountMessage = AccountMessage;
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
            FallbackAccountError = AccountError;
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task ResumeHostedSignInAsync()
    {
        if (IsAccountBusy)
        {
            return;
        }

        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            await Session.ResumeHostedInviteAcceptanceAsync();
            HostedVerificationCode = string.Empty;
            AccountMessage = Session.LastActionMessage ?? "Account connected.";
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task SignInWithGoogleAsync()
    {
        if (IsAccountBusy)
        {
            return;
        }

        IsAccountBusy = true;
        IsGoogleSignInBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            await Session.SignInWithGoogleAsync();
            AccountMessage = Session.LastActionMessage ?? "Account connected with Google.";
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsGoogleSignInBusy = false;
            IsAccountBusy = false;
        }
    }

    private async Task LinkGoogleIdentityAsync()
    {
        if (IsAccountBusy)
        {
            return;
        }

        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            await Session.LinkGoogleIdentityAsync();
            AccountMessage = Session.LastActionMessage ?? "Google sign-in added.";
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task ConfirmRecoveryCodeAsync()
    {
        if (IsAccountBusy || string.IsNullOrWhiteSpace(RecoveryCodeConfirmation))
        {
            return;
        }
        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            if (!await Session.ConfirmRecoveryCodeAsync(RecoveryCodeConfirmation))
            {
                AccountError = "That recovery code did not unlock the test envelope. Check the saved code and try again.";
                return;
            }
            RecoveryCodeConfirmation = string.Empty;
            AccountMessage = Session.LastActionMessage;
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task RecoverWithCodeAsync()
    {
        if (IsAccountBusy || string.IsNullOrWhiteSpace(AccountRecoveryCode))
        {
            return;
        }
        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            await Session.RecoverReplacementDeviceWithCodeAsync(AccountRecoveryCode);
            AccountRecoveryCode = string.Empty;
            AccountMessage = Session.LastActionMessage;
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private static string AccountFailureMessage(Exception exception) => exception switch
    {
        InvalidOperationException or HostedSignInException or JSException => exception.Message,
        MobileHostedDiagnosticException diagnostic =>
            $"Account recovery could not finish, so no new logbook was created. Contact FlightLogX support and provide code {MobileDiagnosticRedactor.Redact(diagnostic.ErrorCode)}.",
        HostedLedgerException =>
            "Account verification reached hosted sync, but device registration could not be completed. Do not request another email; report this message for recovery.",
        HttpRequestException =>
            "Hosted sync could not be reached. Check the connection and try again; do not request another email.",
        _ => $"UNEXPECTED_{exception.GetType().Name}: {MobileDiagnosticRedactor.Redact(exception.Message)}"
    };

    private async Task RunConnectionPreflightAsync()
    {
        if (IsConnectionDiagnosticBusy)
        {
            return;
        }

        IsConnectionDiagnosticBusy = true;
        ConnectionDiagnosticMessage = null;
        try
        {
            var report = await Session.RunConnectionPreflightAsync();
            ConnectionDiagnosticMessage = report.Passed
                ? "All remote and disposable local checks passed. One retained-session recovery is now enabled."
                : $"Stopped without changing the real local logbook. {ConnectionRecoveryGuidance(report)}";
        }
        finally
        {
            IsConnectionDiagnosticBusy = false;
        }
    }

    private async Task RecoverConnectionAsync()
    {
        if (!CanRecoverConnection)
        {
            return;
        }

        IsConnectionDiagnosticBusy = true;
        ConnectionDiagnosticMessage = null;
        try
        {
            var report = await Session.RecoverHostedConnectionAsync();
            ConnectionDiagnosticMessage = report.Passed
                ? "Connected. The package key and local state matched after readback."
                : $"Recovery stopped and incomplete local artifacts were removed. {ConnectionRecoveryGuidance(report)}";
        }
        finally
        {
            IsConnectionDiagnosticBusy = false;
        }
    }

    private async Task CopyConnectionDiagnosticsAsync()
    {
        if (Session.LastConnectionDiagnostics is null)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync(
            "electronicLogbookDiagnostics.copy",
            Session.LastConnectionDiagnostics.ToRedactedJson());
        ConnectionDiagnosticMessage = "Redacted diagnostics copied.";
    }

    private static string ConnectionRecoveryGuidance(MobileConnectionDiagnosticReport report) => report.CurrentStage switch
    {
        MobileConnectionStage.CONFIG_LOAD => "Fix only the packaged runtime configuration, then rerun preflight.",
        MobileConnectionStage.CREDENTIAL_LOAD => "Preserve the server device. Restore or inspect only the retained local credential.",
        MobileConnectionStage.ACCESS_TOKEN_VALIDATE or MobileConnectionStage.AUTH_USER_READ => "Do not send email. Inspect the retained session and refresh only if the access token is expired.",
        MobileConnectionStage.ACCOUNT_READ => "Stop recovery and inspect the existing account match read-only.",
        MobileConnectionStage.DEVICE_READ => "Do not register another device. Inspect the existing device match read-only.",
        MobileConnectionStage.ANDROID_KEYSTORE_PROBE => "Fix Android Keystore access; the disposable probe key was cleaned up.",
        MobileConnectionStage.INDEXEDDB_PROBE => "Fix IndexedDB access; the disposable probe value was cleaned up.",
        MobileConnectionStage.LOCAL_PLAN_CREATE => report.Passed
            ? "Preflight is green; recovery may reuse the existing credential and device."
            : "Fix local plan serialization before touching real local state.",
        MobileConnectionStage.PACKAGE_KEY_IMPORT => "Fix package-key import. The credential and server device were retained.",
        MobileConnectionStage.LOCAL_STATE_SAVE or MobileConnectionStage.LOCAL_STATE_READBACK => "Fix local persistence. Incomplete local artifacts were removed or the prior state was restored.",
        MobileConnectionStage.COMPLETE => "The retained connection and local state are verified.",
        _ => "Stop and inspect this exact stage before retrying."
    };

    private static string FormatTimestamp(DateTimeOffset value) => value.ToLocalTime().ToString("dd MMM yyyy, HH:mm");

    private static string FormatOptionalTimestamp(DateTimeOffset? value) => value is { } timestamp
        ? FormatTimestamp(timestamp)
        : "never";

    private static string FormatOperationCount(int count) =>
        $"{count} operation{(count == 1 ? string.Empty : "s")}";

    private async Task SyncNowAsync()
    {
        if (!Session.HasHostedSync || Session.IsStorageBlocked || IsSyncBusy)
        {
            return;
        }

        IsSyncBusy = true;
        SyncMessage = null;
        SyncError = null;
        try
        {
            var result = await Session.SyncHostedNowAsync();
            SyncMessage = result is null
                ? "Hosted sync is not connected."
                : $"{Session.HostedSyncStatusLabel}: {Session.HostedSyncStatusDetail}";
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            SyncError = ex.Message;
        }
        finally
        {
            IsSyncBusy = false;
        }
    }

    private async Task CheckForPreviewUpdateAsync()
    {
        if (!IsPreviewUpdateAvailable || IsPreviewUpdateBusy)
        {
            return;
        }

        IsPreviewUpdateBusy = true;
        PreviewUpdateMessage = "Checking Firebase App Distribution for a newer Preview build…";
        PreviewUpdateError = null;
        try
        {
            var outcome = await JsRuntime.InvokeAsync<string>(
                "electronicLogbookPreviewUpdates.checkAndInstall");
            PreviewUpdateMessage = outcome == "updateStarted"
                ? "The Preview update was downloaded. Follow Android's installation prompt to finish."
                : "This device already has the latest invitation-only Preview build.";
        }
        catch (JSException)
        {
            PreviewUpdateMessage = null;
            PreviewUpdateError = "The Preview update check could not start. Confirm this Google account accepted the Firebase invitation, then try again.";
        }
        finally
        {
            IsPreviewUpdateBusy = false;
        }
    }

    private async Task ExportSupportSummaryAsync()
    {
        if (Session.IsStorageBlocked || IsSupportSummaryBusy)
        {
            return;
        }

        IsSupportSummaryBusy = true;
        SupportSummaryMessage = null;
        SupportSummaryError = null;
        try
        {
            var result = await MobileSupportSummaryExportWorkflow.ExportAsync(
                Session.DocumentV2,
                FileStore,
                DateTimeOffset.UtcNow);
            SupportSummaryMessage = $"Exported {result.FileName}.";
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or JSException)
        {
            SupportSummaryError = ex.Message;
        }
        finally
        {
            IsSupportSummaryBusy = false;
        }
    }

    private async Task ExportDeviceStateAsync()
    {
        if (Session.IsStorageBlocked || IsDeviceStateExportBusy)
        {
            return;
        }

        IsDeviceStateExportBusy = true;
        DeviceStateExportMessage = null;
        DeviceStateExportError = null;
        try
        {
            var result = await MobileDeviceStateExportWorkflow.ExportAsync(
                new BrowserLogbookStateV2(
                    Session.DocumentV2,
                    Session.ImportReceipts,
                    Session.LastSuccessfulExportAt,
                    Session.LastSuccessfulExport,
                    Session.HostedSync,
                    Session.WorkbookMigration),
                FileStore,
                DateTimeOffset.UtcNow);
            DeviceStateExportMessage = result.Transfer.Shared
                ? $"Backup saved for sharing as {result.FileName}. Complete the Android share action before uninstalling."
                : $"Downloaded {result.FileName}.";
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or JSException)
        {
            DeviceStateExportError = ex.Message;
        }
        finally
        {
            IsDeviceStateExportBusy = false;
        }
    }
}
