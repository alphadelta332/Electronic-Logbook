@page "/settings"
@implements IDisposable
@inject MobileLogbookSession Session
@inject MobileUiPreferenceState UiPreferences
@inject BrowserFileStore FileStore
@inject IJSRuntime JsRuntime

<PageTitle>Account and sync</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading settings</span>
    </section>
}
else
{
    <section class="settings-page">
        <header class="entry-header">
            <div>
                <span class="eyebrow">Settings</span>
                <h1>Account and sync</h1>
            </div>
            <span class="draft-pill">@Session.HostedSyncStatusLabel</span>
        </header>

        <section class="notice-panel">
            <MudIcon Icon="@Icons.Material.Filled.SyncLock" />
            <div>
                <strong>Connection status</strong>
                <span>@Session.HostedSyncStatusDetail</span>
                <span>@AttentionGuidance</span>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Appearance</span>
                    <h2>Theme</h2>
                </div>
                <span class="draft-pill">@UiPreferences.ThemeMode</span>
            </div>
            <div class="segmented-control" aria-label="Appearance">
                <button type="button" class="@ThemeButtonClass("System")" @onclick="SetSystemThemeModeAsync">System</button>
                <button type="button" class="@ThemeButtonClass("Light")" @onclick="SetLightThemeModeAsync">Light</button>
                <button type="button" class="@ThemeButtonClass("Dark")" @onclick="SetDarkThemeModeAsync">Dark</button>
            </div>
            <div class="accent-picker" aria-label="Accent colour">
                @foreach (var accent in MobileUiPreferences.AccentOptions)
                {
                    <button type="button"
                            class="@AccentButtonClass(accent)"
                            title="@accent accent"
                            aria-label="@accent accent"
                            aria-pressed="@(UiPreferences.Accent == accent)"
                            data-accent="@accent.ToLowerInvariant()"
                            @onclick="() => SetAccentAsync(accent)">
                        <span aria-hidden="true"></span>
                        <span>@accent</span>
                    </button>
                }
            </div>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Device health</span>
                    <h2>Offline copy and backup</h2>
                </div>
                <span class="draft-pill">@DeviceHealthLabel</span>
            </div>
            <div class="device-health-grid">
                <article class="device-health-item">
                    <span>Local storage</span>
                    <strong>@(Session.IsStorageBlocked ? "Needs attention" : "Ready")</strong>
                    <small>@(Session.IsStorageBlocked ? Session.StorageError : "Workbook-faithful data is available offline on this device.")</small>
                </article>
                <article class="device-health-item">
                    <span>Device encryption</span>
                    <strong>@Session.PackageKeyStatus</strong>
                    <small>@Session.PackageKeyNotice</small>
                </article>
                <article class="device-health-item">
                    <span>Offline changes</span>
                    <strong>@BackupHealthLabel</strong>
                    <small>@BackupHealthDetail</small>
                </article>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Connection</span>
                    <h2>Hosted sync</h2>
                </div>
                <span class="draft-pill">@Session.HostedSyncStatusLabel</span>
            </div>
            <div class="device-health-grid">
                <article class="device-health-item">
                    <span>Account</span>
                    <strong>@(Session.HasHostedSync ? "Connected" : "Not connected")</strong>
                    <small>@Session.HostedSyncStatusDetail</small>
                </article>
                <article class="device-health-item">
                    <span>Workbook pairing</span>
                    <strong>@Session.PackageKeyStatus</strong>
                    <small>@PairingDetail</small>
                </article>
            </div>
            @if (Session.ShouldOfferHostedAuthentication)
            {
                <div class="field-grid">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountCircle" OnClick="SignInWithGoogleAsync" Disabled="@IsAccountBusy">
                        @(Session.HasHostedSync ? "Reauthenticate with Google" : "Sign in with Google")
                    </MudButton>
                    <MudText Typo="Typo.caption">@(Session.HasHostedSync
                        ? "The connection preflight found a retained sign-in or device-access problem. Reauthenticate without deleting the local logbook."
                        : "Returning pilots: use the Google account previously added to your invited account.")</MudText>
                    <MudTextField @bind-Value="HostedEmail" InputType="InputType.Email" Label="Invited email" Disabled="@IsAccountBusy" />
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MarkEmailRead" OnClick="StartHostedSignInAsync" Disabled="@(IsAccountBusy || string.IsNullOrWhiteSpace(HostedEmail))">
                        Send sign-in code
                    </MudButton>
                    <MudTextField @bind-Value="HostedVerificationCode"
                                  InputType="InputType.Text"
                                  Label="Six-digit sign-in code"
                                  HelperText="Enter the code from the latest FlightLogX email. It expires after 10 minutes. Check your junk or spam folder if it does not arrive."
                                  Disabled="@IsAccountBusy" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Password" OnClick="CompleteHostedSignInAsync" Disabled="@(IsAccountBusy || string.IsNullOrWhiteSpace(HostedVerificationCode))">
                        @(Session.HasHostedSync ? "Reauthenticate account" : "Connect account")
                    </MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Restore" OnClick="ResumeHostedSignInAsync" Disabled="@IsAccountBusy">
                        Resume verified sign-in
                    </MudButton>
                    <MudText Typo="Typo.caption">Recovery only: use after support confirms that email verification succeeded but device setup was interrupted.</MudText>
                    <MudTextField @bind-Value="AccountRecoveryCode" InputType="InputType.Password" Label="Recovery code" Disabled="@IsAccountBusy" />
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key" OnClick="RecoverWithCodeAsync" Disabled="@(IsAccountBusy || string.IsNullOrWhiteSpace(AccountRecoveryCode))">
                        Recover with code
                    </MudButton>
                    <MudText Typo="Typo.caption">Fallback only: sign in first, then use the code saved when this logbook was created.</MudText>
                </div>
            }
            else if (Session.HostedSyncStatusLabel != "Needs attention")
            {
                <div class="connection-diagnostic-actions">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddModerator" OnClick="LinkGoogleIdentityAsync" Disabled="@IsAccountBusy">
                        Add Google sign-in
                    </MudButton>
                </div>
                <MudText Typo="Typo.caption">Do this once after accepting the email invitation. It links Google to this existing account; it does not create another logbook.</MudText>
                @if (Session.IsRecoveryCodeConfirmationPending)
                {
                    <section class="notice-panel" role="status" aria-live="polite">
                        <MudIcon Icon="@Icons.Material.Filled.Key" />
                        <div>
                            <strong>Save your recovery code</strong>
                            <span class="recovery-code-value">@Session.PendingRecoveryCode</span>
                            <span>Store it away from this phone. Enter it below to prove the saved copy works.</span>
                        </div>
                    </section>
                    <MudTextField @bind-Value="RecoveryCodeConfirmation" InputType="InputType.Password" Label="Enter saved recovery code" Disabled="@IsAccountBusy" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.VerifiedUser" OnClick="ConfirmRecoveryCodeAsync" Disabled="@(IsAccountBusy || string.IsNullOrWhiteSpace(RecoveryCodeConfirmation))">
                        Confirm recovery code
                    </MudButton>
                }
            }
            @if (!Session.HasHostedSync || Session.HostedSyncStatusLabel == "Needs attention")
            {
                <div class="connection-diagnostic-actions">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="RunConnectionPreflightAsync" Disabled="@IsConnectionDiagnosticBusy">
                        Run connection preflight
                    </MudButton>
                    @if (!Session.HasHostedSync)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Restore" OnClick="RecoverConnectionAsync" Disabled="@(!CanRecoverConnection)">
                            Recover retained connection
                        </MudButton>
                    }
                </div>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync" OnClick="SyncNowAsync" Disabled="@(!Session.HasHostedSync || Session.IsStorageBlocked || IsSyncBusy)">
                Sync now
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(AccountMessage))
            {
                <span class="settings-status-line">@AccountMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(AccountError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@AccountError</span>
            }
            @if (Session.LastConnectionDiagnostics is { } diagnostics)
            {
                <article class="connection-diagnostic-report" role="status">
                    <div>
                        <span>Stage</span>
                        <strong>@diagnostics.CurrentStage</strong>
                    </div>
                    <div>
                        <span>Error code</span>
                        <strong>@diagnostics.ErrorCode</strong>
                    </div>
                    <small>@ConnectionRecoveryGuidance(diagnostics)</small>
                    <details>
                        <summary>Technical details</summary>
                        <pre>@diagnostics.ToRedactedJson()</pre>
                    </details>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyConnectionDiagnosticsAsync">
                        Copy redacted diagnostics
                    </MudButton>
                    @if (!string.IsNullOrWhiteSpace(ConnectionDiagnosticMessage))
                    {
                        <small>@ConnectionDiagnosticMessage</small>
                    }
                </article>
            }
            @if (!string.IsNullOrWhiteSpace(SyncMessage))
            {
                <span class="settings-status-line">@SyncMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(SyncError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@SyncError</span>
            }
            @if (Session.HostedSync is { } hostedSync && Session.HostedSyncDiagnostics is { } syncDiagnostics)
            {
                <details class="sync-diagnostics">
                    <summary>Sync diagnostics</summary>
                    <div class="device-health-grid">
                        <article class="device-health-item">
                            <span>Pending uploads</span>
                            <strong>@syncDiagnostics.PendingUploadCount</strong>
                            <small>Operations created on this device that have not been uploaded.</small>
                        </article>
                        <article class="device-health-item">
                            <span>Hosted position</span>
                            <strong>Revision @hostedSync.LastAcknowledgedHostedRevision</strong>
                            <small>Last attempted @FormatOptionalTimestamp(hostedSync.LastAttemptedAt); last synced @FormatOptionalTimestamp(hostedSync.LastSyncedAt).</small>
                        </article>
                        <article class="device-health-item">
                            <span>Current-device history</span>
                            <strong>@FormatOperationCount(syncDiagnostics.CurrentDeviceOperationCount)</strong>
                            <small>@syncDiagnostics.UploadedCurrentDeviceOperationCount are recorded as uploaded by this device.</small>
                        </article>
                        <article class="device-health-item">
                            <span>Other-device history</span>
                            <strong>@FormatOperationCount(syncDiagnostics.OtherDeviceHistory.Count)</strong>
                            <small>Downloaded or imported history is kept locally but is not part of this device's upload queue.</small>
                        </article>
                    </div>

                    <section class="sync-diagnostic-group">
                        <h3>Pending upload details</h3>
                        @if (syncDiagnostics.PendingUploads.Count == 0)
                        {
                            <small>No operations are waiting to upload.</small>
                        }
                        else
                        {
                            @foreach (var operation in syncDiagnostics.PendingUploads)
                            {
                                <article class="sync-operation-detail">
                                    <strong>@operation.KindLabel · @operation.FlightId</strong>
                                    <span>@FormatTimestamp(operation.CreatedAt)</span>
                                    @if (!string.IsNullOrWhiteSpace(operation.Detail))
                                    {
                                        <span>@operation.Detail</span>
                                    }
                                    <code>Revision @operation.RevisionId</code>
                                    <code>Device @operation.DeviceId</code>
                                </article>
                            }
                        }
                    </section>

                    <section class="sync-diagnostic-group">
                        <h3>Other-device history excluded from uploads</h3>
                        @if (syncDiagnostics.OtherDeviceHistory.Count == 0)
                        {
                            <small>No other-device operations are stored locally.</small>
                        }
                        else
                        {
                            @foreach (var operation in syncDiagnostics.OtherDeviceHistory.Take(10))
                            {
                                <article class="sync-operation-detail">
                                    <strong>@operation.KindLabel · @operation.FlightId</strong>
                                    <span>@FormatTimestamp(operation.CreatedAt)</span>
                                    @if (!string.IsNullOrWhiteSpace(operation.Detail))
                                    {
                                        <span>@operation.Detail</span>
                                    }
                                    <code>Revision @operation.RevisionId</code>
                                    <code>Device @operation.DeviceId</code>
                                </article>
                            }
                            @if (syncDiagnostics.OtherDeviceHistory.Count > 10)
                            {
                                <small>Showing the 10 most recent of @syncDiagnostics.OtherDeviceHistory.Count operations.</small>
                            }
                        }
                    </section>
                </details>
            }
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Advanced recovery</span>
                    <h2>Support and account data</h2>
                </div>
            </div>
            <div class="device-health-grid">
                <article class="device-health-item">
                    <span>Manual Package Exchange</span>
                    <strong>@Session.ImportReceipts.Count import(s)</strong>
                    <small>@ImportHealthDetail</small>
                </article>
                <article class="device-health-item">
                    <span>Account export</span>
                    <strong>Local only</strong>
                    <small>Exports stay on this device until you choose where to store or share them.</small>
                </article>
                <article class="device-health-item">
                    <span>Account deletion</span>
                    <strong>Support assisted</strong>
                    <small>Use the support summary when requesting account deletion or revoked-device recovery.</small>
                </article>
            </div>
            <MudButton Href="/exchange" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Construction">
                Advanced recovery workspace
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportDeviceStateAsync" Disabled="@(Session.IsStorageBlocked || IsDeviceStateExportBusy)">
                Export account backup
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(DeviceStateExportMessage))
            {
                <span class="settings-status-line">@DeviceStateExportMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(DeviceStateExportError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@DeviceStateExportError</span>
            }
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Support</span>
                    <h2>Local summary</h2>
                </div>
            </div>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Summarize" OnClick="ExportSupportSummaryAsync" Disabled="@(Session.IsStorageBlocked || IsSupportSummaryBusy)">
                Support summary
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(SupportSummaryMessage))
            {
                <span class="settings-status-line">@SupportSummaryMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(SupportSummaryError))
            {
                <span class="settings-status-line settings-status-error" role="alert">@SupportSummaryError</span>
            }
        </section>
    </section>
}

@code {
    private bool IsSupportSummaryBusy { get; set; }
    private bool IsDeviceStateExportBusy { get; set; }
    private bool IsSyncBusy { get; set; }
    private bool IsAccountBusy { get; set; }
    private bool IsConnectionDiagnosticBusy { get; set; }
    private string HostedEmail { get; set; } = string.Empty;
    private string HostedVerificationCode { get; set; } = string.Empty;
    private string AccountRecoveryCode { get; set; } = string.Empty;
    private string RecoveryCodeConfirmation { get; set; } = string.Empty;
    private string? SupportSummaryMessage { get; set; }
    private string? SupportSummaryError { get; set; }
    private string? DeviceStateExportMessage { get; set; }
    private string? DeviceStateExportError { get; set; }
    private string? SyncMessage { get; set; }
    private string? SyncError { get; set; }
    private string? AccountMessage { get; set; }
    private string? AccountError { get; set; }
    private string? ConnectionDiagnosticMessage { get; set; }

    private bool CanRecoverConnection =>
        !IsConnectionDiagnosticBusy
        && Session.LastConnectionDiagnostics is { Passed: true, CurrentStage: MobileConnectionStage.LOCAL_PLAN_CREATE };

    protected override async Task OnInitializedAsync()
    {
        Session.HostedSyncChanged += OnHostedSyncChanged;
        await Session.EnsureLoadedWorkbookAsync();
        await UiPreferences.EnsureLoadedAsync();
    }

    public void Dispose() => Session.HostedSyncChanged -= OnHostedSyncChanged;

    private void OnHostedSyncChanged() => _ = InvokeAsync(StateHasChanged);

    private Task SetSystemThemeModeAsync() => UiPreferences.SetThemeModeAsync("System");

    private Task SetLightThemeModeAsync() => UiPreferences.SetThemeModeAsync("Light");

    private Task SetDarkThemeModeAsync() => UiPreferences.SetThemeModeAsync("Dark");

    private Task SetAccentAsync(string accent) => UiPreferences.SetAccentAsync(accent);

    private string ThemeButtonClass(string themeMode) =>
        UiPreferences.ThemeMode == themeMode ? "active" : string.Empty;

    private string AccentButtonClass(string accent) =>
        UiPreferences.Accent == accent ? "accent-option active" : "accent-option";

    private string DeviceHealthLabel => Session.IsStorageBlocked || Session.PackageKeyStatus == "Unavailable"
        ? "Needs attention"
        : Session.ExchangeStatus.HasUnexportedChanges
            ? "Backup due"
            : "Ready";

    private string BackupHealthLabel => Session.ExchangeStatus.HasUnexportedChanges
        ? "Backup due"
        : Session.LastSuccessfulExportAt is null
            ? "No export yet"
            : "Up to date";

    private string BackupHealthDetail => Session.ExchangeStatus.HasUnexportedChanges
        ? $"{Session.ExchangeStatus.PendingOperationCount} operation(s) are ready to export."
        : Session.LastSuccessfulExportAt is DateTimeOffset exportedAt
            ? $"Last exported {FormatTimestamp(exportedAt)}."
            : "Local edits are saved on this device first and will sync after account connection.";

    private string ImportHealthDetail => Session.ExchangeStatus.LastSuccessfulImportAt is DateTimeOffset importedAt
        ? $"Last imported {FormatTimestamp(importedAt)}."
        : "No manual workbook package has been imported on this device yet.";

    private string PairingDetail => Session.HasHostedSync
        ? "This device is paired to the hosted account; workbook pairing happens through the updater."
        : "Connect an invited account before pairing a workbook.";

    private string AttentionGuidance => Session.HostedSyncStatusLabel switch
    {
        "Needs attention" => "Resolve conflicts, reauthenticate, restore a lost key, or recover a revoked device from Advanced recovery/support.",
        "Signing in" => "Finish sign-in with the six-digit code sent to the invited email. Check your junk or spam folder if it does not arrive.",
        "Offline" => "You can keep working; queued edits sync when the network returns.",
        _ => "Daily sync stays automatic. Package tools are only for Advanced recovery/support."
    };

    private async Task StartHostedSignInAsync()
    {
        if (IsAccountBusy || string.IsNullOrWhiteSpace(HostedEmail))
        {
            return;
        }

        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            var signIn = await Session.StartHostedInviteAcceptanceAsync(HostedEmail);
            AccountMessage = $"Sign-in code sent to {signIn.DeliveryHint}. It expires after 10 minutes. Check your junk or spam folder if it does not arrive.";
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task CompleteHostedSignInAsync()
    {
        if (IsAccountBusy || string.IsNullOrWhiteSpace(HostedVerificationCode))
        {
            return;
        }

        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            await Session.CompleteHostedInviteAcceptanceAsync(HostedVerificationCode);
            HostedVerificationCode = string.Empty;
            AccountMessage = Session.LastActionMessage ?? "Account connected.";
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task ResumeHostedSignInAsync()
    {
        if (IsAccountBusy)
        {
            return;
        }

        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            await Session.ResumeHostedInviteAcceptanceAsync();
            HostedVerificationCode = string.Empty;
            AccountMessage = Session.LastActionMessage ?? "Account connected.";
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task SignInWithGoogleAsync()
    {
        if (IsAccountBusy)
        {
            return;
        }

        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            await Session.SignInWithGoogleAsync();
            AccountMessage = Session.LastActionMessage ?? "Account connected with Google.";
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task LinkGoogleIdentityAsync()
    {
        if (IsAccountBusy)
        {
            return;
        }

        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            await Session.LinkGoogleIdentityAsync();
            AccountMessage = Session.LastActionMessage ?? "Google sign-in added.";
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task ConfirmRecoveryCodeAsync()
    {
        if (IsAccountBusy || string.IsNullOrWhiteSpace(RecoveryCodeConfirmation))
        {
            return;
        }
        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            if (!await Session.ConfirmRecoveryCodeAsync(RecoveryCodeConfirmation))
            {
                AccountError = "That recovery code did not unlock the test envelope. Check the saved code and try again.";
                return;
            }
            RecoveryCodeConfirmation = string.Empty;
            AccountMessage = Session.LastActionMessage;
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private async Task RecoverWithCodeAsync()
    {
        if (IsAccountBusy || string.IsNullOrWhiteSpace(AccountRecoveryCode))
        {
            return;
        }
        IsAccountBusy = true;
        AccountMessage = null;
        AccountError = null;
        try
        {
            await Session.RecoverReplacementDeviceWithCodeAsync(AccountRecoveryCode);
            AccountRecoveryCode = string.Empty;
            AccountMessage = Session.LastActionMessage;
        }
        catch (Exception ex)
        {
            AccountError = AccountFailureMessage(ex);
        }
        finally
        {
            IsAccountBusy = false;
        }
    }

    private static string AccountFailureMessage(Exception exception) => exception switch
    {
        InvalidOperationException or HostedSignInException or JSException => exception.Message,
        HostedLedgerException =>
            "Account verification reached hosted sync, but device registration could not be completed. Do not request another email; report this message for recovery.",
        HttpRequestException =>
            "Hosted sync could not be reached. Check the connection and try again; do not request another email.",
        _ => $"UNEXPECTED_{exception.GetType().Name}: {MobileDiagnosticRedactor.Redact(exception.Message)}"
    };

    private async Task RunConnectionPreflightAsync()
    {
        if (IsConnectionDiagnosticBusy)
        {
            return;
        }

        IsConnectionDiagnosticBusy = true;
        ConnectionDiagnosticMessage = null;
        try
        {
            var report = await Session.RunConnectionPreflightAsync();
            ConnectionDiagnosticMessage = report.Passed
                ? "All remote and disposable local checks passed. One retained-session recovery is now enabled."
                : $"Stopped without changing the real local logbook. {ConnectionRecoveryGuidance(report)}";
        }
        finally
        {
            IsConnectionDiagnosticBusy = false;
        }
    }

    private async Task RecoverConnectionAsync()
    {
        if (!CanRecoverConnection)
        {
            return;
        }

        IsConnectionDiagnosticBusy = true;
        ConnectionDiagnosticMessage = null;
        try
        {
            var report = await Session.RecoverHostedConnectionAsync();
            ConnectionDiagnosticMessage = report.Passed
                ? "Connected. The package key and local state matched after readback."
                : $"Recovery stopped and incomplete local artifacts were removed. {ConnectionRecoveryGuidance(report)}";
        }
        finally
        {
            IsConnectionDiagnosticBusy = false;
        }
    }

    private async Task CopyConnectionDiagnosticsAsync()
    {
        if (Session.LastConnectionDiagnostics is null)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync(
            "electronicLogbookDiagnostics.copy",
            Session.LastConnectionDiagnostics.ToRedactedJson());
        ConnectionDiagnosticMessage = "Redacted diagnostics copied.";
    }

    private static string ConnectionRecoveryGuidance(MobileConnectionDiagnosticReport report) => report.CurrentStage switch
    {
        MobileConnectionStage.CONFIG_LOAD => "Fix only the packaged runtime configuration, then rerun preflight.",
        MobileConnectionStage.CREDENTIAL_LOAD => "Preserve the server device. Restore or inspect only the retained local credential.",
        MobileConnectionStage.ACCESS_TOKEN_VALIDATE or MobileConnectionStage.AUTH_USER_READ => "Do not send email. Inspect the retained session and refresh only if the access token is expired.",
        MobileConnectionStage.ACCOUNT_READ => "Stop recovery and inspect the existing account match read-only.",
        MobileConnectionStage.DEVICE_READ => "Do not register another device. Inspect the existing device match read-only.",
        MobileConnectionStage.ANDROID_KEYSTORE_PROBE => "Fix Android Keystore access; the disposable probe key was cleaned up.",
        MobileConnectionStage.INDEXEDDB_PROBE => "Fix IndexedDB access; the disposable probe value was cleaned up.",
        MobileConnectionStage.LOCAL_PLAN_CREATE => report.Passed
            ? "Preflight is green; recovery may reuse the existing credential and device."
            : "Fix local plan serialization before touching real local state.",
        MobileConnectionStage.PACKAGE_KEY_IMPORT => "Fix package-key import. The credential and server device were retained.",
        MobileConnectionStage.LOCAL_STATE_SAVE or MobileConnectionStage.LOCAL_STATE_READBACK => "Fix local persistence. Incomplete local artifacts were removed or the prior state was restored.",
        MobileConnectionStage.COMPLETE => "The retained connection and local state are verified.",
        _ => "Stop and inspect this exact stage before retrying."
    };

    private static string FormatTimestamp(DateTimeOffset value) => value.ToLocalTime().ToString("dd MMM yyyy, HH:mm");

    private static string FormatOptionalTimestamp(DateTimeOffset? value) => value is { } timestamp
        ? FormatTimestamp(timestamp)
        : "never";

    private static string FormatOperationCount(int count) =>
        $"{count} operation{(count == 1 ? string.Empty : "s")}";

    private async Task SyncNowAsync()
    {
        if (!Session.HasHostedSync || Session.IsStorageBlocked || IsSyncBusy)
        {
            return;
        }

        IsSyncBusy = true;
        SyncMessage = null;
        SyncError = null;
        try
        {
            var result = await Session.SyncHostedNowAsync();
            SyncMessage = result is null
                ? "Hosted sync is not connected."
                : $"{Session.HostedSyncStatusLabel}: {Session.HostedSyncStatusDetail}";
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            SyncError = ex.Message;
        }
        finally
        {
            IsSyncBusy = false;
        }
    }

    private async Task ExportSupportSummaryAsync()
    {
        if (Session.IsStorageBlocked || IsSupportSummaryBusy)
        {
            return;
        }

        IsSupportSummaryBusy = true;
        SupportSummaryMessage = null;
        SupportSummaryError = null;
        try
        {
            var result = await MobileSupportSummaryExportWorkflow.ExportAsync(
                Session.DocumentV2,
                FileStore,
                DateTimeOffset.UtcNow);
            SupportSummaryMessage = $"Exported {result.FileName}.";
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or JSException)
        {
            SupportSummaryError = ex.Message;
        }
        finally
        {
            IsSupportSummaryBusy = false;
        }
    }

    private async Task ExportDeviceStateAsync()
    {
        if (Session.IsStorageBlocked || IsDeviceStateExportBusy)
        {
            return;
        }

        IsDeviceStateExportBusy = true;
        DeviceStateExportMessage = null;
        DeviceStateExportError = null;
        try
        {
            var result = await MobileDeviceStateExportWorkflow.ExportAsync(
                new BrowserLogbookStateV2(
                    Session.DocumentV2,
                    Session.ImportReceipts,
                    Session.LastSuccessfulExportAt,
                    Session.LastSuccessfulExport,
                    Session.HostedSync),
                FileStore,
                DateTimeOffset.UtcNow);
            DeviceStateExportMessage = result.Transfer.Shared
                ? $"Backup saved for sharing as {result.FileName}. Complete the Android share action before uninstalling."
                : $"Downloaded {result.FileName}.";
        }
        catch (Exception ex) when (ex is BrowserFileStoreException or JSException)
        {
            DeviceStateExportError = ex.Message;
        }
        finally
        {
            IsDeviceStateExportBusy = false;
        }
    }
}
