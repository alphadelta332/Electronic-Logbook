@page "/flights/new"
@page "/flights/{EntryId}/edit"
@inject MobileLogbookSession Session
@inject NavigationManager Navigation

<PageTitle>@(Session.EditingEntryId is null ? "New Flight" : "Edit Flight")</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading flight draft</span>
    </section>
}
else
{
    <section class="flight-entry-page">
        @if (ShowSaveConfirmation)
        {
            <section class="save-confirmation" role="status" aria-live="assertive">
                <span class="save-confirmation-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Check" />
                </span>
                <strong>@SaveConfirmationMessage</strong>
            </section>
        }

        <header class="entry-header">
            <div>
                <span class="eyebrow">@Session.DraftModeLabel</span>
                <h1>@Session.WorkbookDraft.Date.ToString("dd MMM yyyy")</h1>
            </div>
            <span class="draft-pill">@(Session.HasEditedDraft ? "Draft edited" : "Ready")</span>
        </header>

        @if (Session.ShouldShowLastActionMessage(MobileActionMessageSurface.Draft))
        {
            <section class="state-banner" role="status">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                <span>@Session.LastActionMessage</span>
            </section>
        }

        @if (Session.ShouldShowWorkbookDraftErrors)
        {
            <section class="state-banner state-banner-error" role="alert" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
                <div>
                    @foreach (var error in Session.WorkbookDraftErrors)
                    {
                        <span>@error</span>
                    }
                </div>
            </section>
        }

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Flight</span>
                    <h2>Identity</h2>
                </div>
            </div>
            <div class="field-grid">
                <label>Date <input type="date" max="@TodayIso" @bind="Session.WorkbookDraft.Date" /></label>
                <label>Type <input @bind="Session.WorkbookDraft.Type" list="aircraft-types" autocapitalize="characters" spellcheck="false" /></label>
                <label>Reg <input @bind="Session.WorkbookDraft.Reg" list="registrations" autocapitalize="characters" spellcheck="false" /></label>
                <label>Flight ID <input @bind="Session.WorkbookDraft.FlightId" list="flight-numbers" autocapitalize="characters" spellcheck="false" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Crew and route</span>
                    <h2>Pilots and remarks</h2>
                </div>
            </div>
            <div class="field-grid">
                <label>PIC <input @bind="Session.WorkbookDraft.Pic" autocapitalize="words" /></label>
                <label>Other pilot or crew <input @bind="Session.WorkbookDraft.OtherPilotOrCrew" autocapitalize="words" /></label>
                <label>From <input @bind="Session.WorkbookDraft.From" list="airports" autocapitalize="characters" spellcheck="false" /></label>
                <label>To <input @bind="Session.WorkbookDraft.To" list="airports" autocapitalize="characters" spellcheck="false" /></label>
                <label class="field-span">Via <input @bind="Session.WorkbookDraft.Via" list="routes" autocapitalize="characters" spellcheck="false" /></label>
            </div>
            <label class="field-wide">Remarks <textarea @bind="Session.WorkbookDraft.Remarks"></textarea></label>
            <select class="recent-select" @onchange="UseRecentRemark" disabled="@Session.IsStorageBlocked">
                <option value="">Recent remarks</option>
                @foreach (var value in Session.RecentWorkbookValues(entry => entry.Remarks))
                {
                    <option value="@value">@value</option>
                }
            </select>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Checks and fields</span>
                    <h2>FR, IPC, OPC, and custom fields</h2>
                </div>
            </div>
            <div class="field-grid">
                <label><input type="checkbox" @bind="Session.WorkbookDraft.FlightReview" /> Flight review</label>
                <label><input type="checkbox" @bind="Session.WorkbookDraft.InstrumentProficiencyCheck" /> IPC</label>
                <label><input type="checkbox" @bind="Session.WorkbookDraft.OperatorProficiencyCheck" /> OPC</label>
            </div>
            <div class="field-grid custom-field-grid">
                @foreach (var field in Session.WorkbookCustomFields)
                {
                    <label>@field.Label <input @bind="Session.WorkbookDraft.CustomValues[field.Id]" /></label>
                }
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Times</span>
                    <h2>Operating capacity</h2>
                </div>
            </div>
            <div class="field-grid numeric-grid">
                <label>SE ICUS day <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.SeIcusDay" /></label>
                <label>SE ICUS night <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.SeIcusNight" /></label>
                <label>SE dual day <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.SeDualDay" /></label>
                <label>SE dual night <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.SeDualNight" /></label>
                <label>SE command day <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.SeCommandDay" /></label>
                <label>SE command night <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.SeCommandNight" /></label>
                <label>ME ICUS day <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.MeIcusDay" /></label>
                <label>ME ICUS night <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.MeIcusNight" /></label>
                <label>ME dual day <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.MeDualDay" /></label>
                <label>ME dual night <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.MeDualNight" /></label>
                <label>ME command day <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.MeCommandDay" /></label>
                <label>ME command night <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.MeCommandNight" /></label>
                <label>Copilot day <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.CopilotDay" /></label>
                <label>Copilot night <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.CopilotNight" /></label>
                <label>IFR IF <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.IfrIf" /></label>
                <label>IFR sim <input type="number" step="0.1" min="0" inputmode="decimal" @bind="Session.WorkbookDraft.IfrSim" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Currency</span>
                    <h2>Landings</h2>
                </div>
            </div>
            <div class="field-grid numeric-grid">
                <label>Landings day <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.LandingsDay" /></label>
                <label>Landings night <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.LandingsNight" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Currency</span>
                    <h2>Approach types</h2>
                </div>
            </div>
            <div class="field-grid numeric-grid">
                <label>ILS <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Ils" /></label>
                <label>VOR <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Vor" /></label>
                <label>RNP <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Rnp" /></label>
                <label>NDB <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Ndb" /></label>
                <label>DGA (CDI) <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.DgaCdi" /></label>
                <label>DGA (Azi) <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.DgaAzi" /></label>
                <label>Circling <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Circling" /></label>
            </div>
        </section>

        <datalist id="aircraft-types">
            @foreach (var value in Session.RecentWorkbookValues(entry => entry.Type))
            {
                <option value="@value"></option>
            }
        </datalist>
        <datalist id="registrations">
            @foreach (var value in Session.RecentWorkbookValues(entry => entry.Reg))
            {
                <option value="@value"></option>
            }
        </datalist>
        <datalist id="airports">
            @foreach (var value in Session.RecentWorkbookAirportValues())
            {
                <option value="@value"></option>
            }
        </datalist>
        <datalist id="flight-numbers">
            @foreach (var value in Session.RecentWorkbookValues(entry => entry.FlightId))
            {
                <option value="@value"></option>
            }
        </datalist>
        <datalist id="routes">
            @foreach (var value in Session.RecentWorkbookValues(entry => entry.Via))
            {
                <option value="@value"></option>
            }
        </datalist>

        <aside class="persistent-action-bar">
            <div class="entry-totals" aria-label="Draft totals">
                <span><strong>@MobileLogbookSession.FormatHours(Session.WorkbookDraft.TotalHours + Session.WorkbookDraft.IfrSim)</strong> hr</span>
                <span><strong>@Session.WorkbookDraft.TotalLandings</strong> ldg</span>
                <span><strong>@Session.WorkbookDraft.TotalApproaches</strong> app</span>
            </div>
            <div class="action-buttons">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Session.ResetWorkbookDraft" Disabled="@Session.IsStorageBlocked" aria-label="Clear draft" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Session.IsStorageBlocked" StartIcon="@Icons.Material.Filled.Done">
                    @Session.SaveLabel
                </MudButton>
            </div>
        </aside>
    </section>
}

@code {
    [Parameter]
    public string? EntryId { get; set; }

    private static string TodayIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private bool ShowSaveConfirmation { get; set; }
    private string SaveConfirmationMessage { get; set; } = "Saved";
    private string? LoadedEditEntryId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
        LoadEditRoute();
    }

    protected override void OnParametersSet()
    {
        if (Session.IsLoaded)
        {
            LoadEditRoute();
        }
    }

    private async Task SaveAsync()
    {
        var confirmationMessage = Session.EditingEntryId is null ? "Flight added" : "Correction saved";
        await Session.SaveWorkbookEntryAsync();
        if (!Session.ShouldShowWorkbookDraftErrors)
        {
            SaveConfirmationMessage = confirmationMessage;
            ShowSaveConfirmation = true;
            await Task.Delay(650);
            Navigation.NavigateTo("/");
        }
    }

    private void UseRecentRemark(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(value))
        {
            Session.WorkbookDraft.Remarks = value;
            Session.MarkDraftEdited();
        }
    }

    private void LoadEditRoute()
    {
        if (string.IsNullOrWhiteSpace(EntryId) || LoadedEditEntryId == EntryId)
        {
            return;
        }

        var entry = Session.FindCurrentEntryV2(EntryId);
        if (entry is null)
        {
            Navigation.NavigateTo("/flights");
            return;
        }

        Session.EditWorkbookEntry(entry);
        LoadedEditEntryId = EntryId;
    }
}
