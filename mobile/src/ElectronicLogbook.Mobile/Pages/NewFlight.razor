@page "/flights/new"
@page "/flights/{EntryId}/edit"
@inject MobileLogbookSession Session
@inject NavigationManager Navigation
@inject BrowserLogbookStore Store

<PageTitle>@(Session.EditingEntryId is null ? "New Flight" : "Edit Flight")</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading flight draft</span>
    </section>
}
else
{
    <section class="flight-entry-page">
        <a class="page-back-link"
           href="/"
           @onclick="RequestCancel"
           @onclick:preventDefault="true"
           aria-label="Back to dashboard">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />
            <span>Back to dashboard</span>
        </a>

        @if (PendingAction is not null)
        {
            <div class="entry-action-dialog-backdrop" @onclick="DismissPendingAction">
                <section class="entry-action-dialog"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="entry-action-dialog-title"
                         @onclick:stopPropagation="true">
                    @if (PendingAction == DraftAction.ReviewSave)
                    {
                        <header class="entry-action-dialog-header">
                            <span class="entry-action-dialog-icon entry-action-dialog-icon-review">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck" />
                            </span>
                            <div>
                                <span class="eyebrow">Review before saving</span>
                                <h2 id="entry-action-dialog-title">@(Session.EditingEntryId is null ? "Add this flight?" : "Save this correction?")</h2>
                            </div>
                        </header>
                        <div class="entry-review-values" tabindex="0" aria-label="Flight values to save">
                            @if (ReviewWarnings.Count > 0)
                            {
                                <section class="entry-review-warnings" role="alert" aria-label="Entry warnings">
                                    <header>
                                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                                        <strong>@ReviewWarningCountLabel</strong>
                                    </header>
                                    <div class="entry-review-warning-list">
                                        @foreach (var warning in ReviewWarnings)
                                        {
                                            <p>@warning.Message</p>
                                        }
                                    </div>
                                </section>
                            }
                            @foreach (var group in ReviewDetails.GroupBy(detail => detail.Group))
                            {
                                <section class="entry-review-group">
                                    <h3>@ReviewGroupLabel(group.Key)</h3>
                                    <dl>
                                        @foreach (var detail in group)
                                        {
                                            <div>
                                                <dt>@detail.Label</dt>
                                                <dd>
                                                    <span>@detail.Value</span>
                                                    @if (HasReviewWarning(detail.Field))
                                                    {
                                                        <MudIcon Class="entry-review-field-warning" Icon="@Icons.Material.Filled.WarningAmber" aria-label="Warning" />
                                                    }
                                                </dd>
                                            </div>
                                        }
                                    </dl>
                                </section>
                            }
                        </div>
                        <footer class="entry-action-dialog-actions">
                            <MudButton Variant="Variant.Text" OnClick="DismissPendingAction" Disabled="@IsActionPending">
                                Keep editing
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmSaveAsync" Disabled="@IsActionPending" StartIcon="@(ReviewWarnings.Count > 0 ? Icons.Material.Filled.WarningAmber : Icons.Material.Filled.Done)">
                                @(ReviewWarnings.Count > 0 ? "Save anyway" : Session.SaveLabel)
                            </MudButton>
                        </footer>
                    }
                    else
                    {
                        <header class="entry-action-dialog-header">
                            <span class="entry-action-dialog-icon entry-action-dialog-icon-warning">
                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                            </span>
                            <div>
                                <span class="eyebrow">Unsaved changes</span>
                                <h2 id="entry-action-dialog-title">@(PendingAction == DraftAction.Clear ? "Clear this form?" : "Discard this draft?")</h2>
                                <p>@(PendingAction == DraftAction.Clear
                                    ? "Every value in the form will be cleared. This cannot be undone."
                                    : "Your changes will not be saved before returning to the dashboard.")</p>
                            </div>
                        </header>
                        <footer class="entry-action-dialog-actions">
                            <MudButton Variant="Variant.Text" OnClick="DismissPendingAction">
                                Keep editing
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDestructiveAction" StartIcon="@Icons.Material.Filled.DeleteOutline">
                                @(PendingAction == DraftAction.Clear ? "Clear" : "Discard draft")
                            </MudButton>
                        </footer>
                    }
                </section>
            </div>
        }

        <header class="entry-header entry-action-header">
            <div class="entry-action-context">
                <h1>@Session.DraftModeLabel</h1>
                <span class="entry-draft-status">
                    <span class="entry-draft-status-dot" aria-hidden="true"></span>
                    @(Session.HasEditedDraft ? "Draft edited" : "Ready")
                </span>
            </div>
            <div class="entry-header-actions" role="group" aria-label="Flight form actions">
                <MudButton Class="entry-clear-action" Variant="Variant.Filled" Color="Color.Default" OnClick="RequestClear" Disabled="@Session.IsStorageBlocked" aria-label="Clear form" title="Clear form">
                    Clear
                </MudButton>
                <MudButton Class="entry-save-action" Variant="Variant.Filled" Color="Color.Primary" OnClick="ReviewSave" Disabled="@Session.IsStorageBlocked" aria-label="@Session.SaveLabel" title="@Session.SaveLabel">
                    @Session.SaveLabel
                </MudButton>
            </div>
        </header>

        @if (Session.ShouldShowLastActionMessage(MobileActionMessageSurface.Draft))
        {
            <section class="state-banner" role="status">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                <span>@Session.LastActionMessage</span>
            </section>
        }

        @if (Session.ShouldShowWorkbookDraftErrors)
        {
            <section @ref="ValidationSummary"
                     id="workbook-draft-errors"
                     class="state-banner state-banner-error"
                     role="region"
                     aria-labelledby="workbook-draft-errors-title"
                     tabindex="-1">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
                <div>
                    <strong id="workbook-draft-errors-title">Fix these problems</strong>
                    @foreach (var error in Session.WorkbookDraftErrors)
                    {
                        <span>@error</span>
                    }
                </div>
            </section>
        }

        @if (ShowValidationFeedback && Session.ShouldShowWorkbookDraftErrors)
        {
            <section @key="ValidationFeedbackVersion"
                     class="action-feedback-message entry-validation-feedback action-feedback-message-enter"
                     role="alert"
                     aria-live="assertive"
                     aria-atomic="true">
                <div class="action-feedback-content">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
                    <span class="action-feedback-copy">@ValidationFeedbackMessage</span>
                </div>
                <MudButton Variant="Variant.Text" OnClick="ReviewErrorsAsync">
                    Review errors
                </MudButton>
            </section>
        }

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <h2>Flight Details</h2>
            </div>
            <div class="field-grid">
                <label>Date <input type="date" max="@TodayIso" @bind="Session.WorkbookDraft.Date" /></label>
                <label>Type <input @bind="Session.WorkbookDraft.Type" autocapitalize="characters" spellcheck="false" /></label>
                <label>Registration <input @bind="Session.WorkbookDraft.Reg" autocapitalize="characters" spellcheck="false" /></label>
                <label>Flight ID <input @bind="Session.WorkbookDraft.FlightId" autocapitalize="characters" spellcheck="false" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <h2>Crew</h2>
            </div>
            <div class="field-grid">
                <label>PIC <input @bind="Session.WorkbookDraft.Pic" autocapitalize="words" /></label>
                <label>Other Pilot or crew <input @bind="Session.WorkbookDraft.OtherPilotOrCrew" autocapitalize="words" /></label>
            </div>
            <div class="field-grid check-grid crew-checks">
                <label class="check-option"><input type="checkbox" @bind="Session.WorkbookDraft.FlightReview" /> Flight Review (FR)</label>
                <label class="check-option"><input type="checkbox" @bind="Session.WorkbookDraft.InstrumentProficiencyCheck" /> Instrument Proficiency Check (IPC)</label>
                <label class="check-option"><input type="checkbox" @bind="Session.WorkbookDraft.OperatorProficiencyCheck" /> Operator Proficiency Check (OPC)</label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <h2>Route</h2>
            </div>
            <div class="field-grid">
                <AirportField Label="From" @bind-Value="Session.WorkbookDraft.From" LoadSuggestions="LoadAirportSuggestionsAsync" Edited="Session.MarkDraftEdited" />
                <AirportField Label="To" @bind-Value="Session.WorkbookDraft.To" LoadSuggestions="LoadAirportSuggestionsAsync" Edited="Session.MarkDraftEdited" />
                <div class="field-span"><AirportField Label="Via" Multiple="true" @bind-Value="Session.WorkbookDraft.Via" LoadSuggestions="LoadAirportSuggestionsAsync" Edited="Session.MarkDraftEdited" /></div>
            </div>
            @if (AirportBasesError is not null)
            {
                <p role="status">@AirportBasesError</p>
                <MudButton Variant="Variant.Text" OnClick="LoadAirportBasesAsync">Retry bases</MudButton>
            }
            <label class="field-wide">Remarks <textarea @bind="Session.WorkbookDraft.Remarks"></textarea></label>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <h2>Hours</h2>
            </div>
            <EntryHourTable Title="Single engine">
                <div class="totals-table-row" role="row">
                    <strong role="rowheader">ICUS</strong>
                    <div role="cell"><label><span class="visually-hidden">SE ICUS Day</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeIcusDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeIcusDay = value)" /></label></div>
                    <div role="cell"><label><span class="visually-hidden">SE ICUS Night</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeIcusNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeIcusNight = value)" /></label></div>
                </div>
                <div class="totals-table-row" role="row">
                    <strong role="rowheader">Dual</strong>
                    <div role="cell"><label><span class="visually-hidden">SE Dual Day</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeDualDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeDualDay = value)" /></label></div>
                    <div role="cell"><label><span class="visually-hidden">SE Dual Night</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeDualNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeDualNight = value)" /></label></div>
                </div>
                <div class="totals-table-row" role="row">
                    <strong role="rowheader">Command</strong>
                    <div role="cell"><label><span class="visually-hidden">SE Command Day</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeCommandDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeCommandDay = value)" /></label></div>
                    <div role="cell"><label><span class="visually-hidden">SE Command Night</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeCommandNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeCommandNight = value)" /></label></div>
                </div>
            </EntryHourTable>
            <EntryHourTable Title="Multi engine">
                <div class="totals-table-row" role="row">
                    <strong role="rowheader">ICUS</strong>
                    <div role="cell"><label><span class="visually-hidden">ME ICUS Day</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeIcusDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeIcusDay = value)" /></label></div>
                    <div role="cell"><label><span class="visually-hidden">ME ICUS Night</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeIcusNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeIcusNight = value)" /></label></div>
                </div>
                <div class="totals-table-row" role="row">
                    <strong role="rowheader">Dual</strong>
                    <div role="cell"><label><span class="visually-hidden">ME Dual Day</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeDualDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeDualDay = value)" /></label></div>
                    <div role="cell"><label><span class="visually-hidden">ME Dual Night</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeDualNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeDualNight = value)" /></label></div>
                </div>
                <div class="totals-table-row" role="row">
                    <strong role="rowheader">Command</strong>
                    <div role="cell"><label><span class="visually-hidden">ME Command Day</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeCommandDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeCommandDay = value)" /></label></div>
                    <div role="cell"><label><span class="visually-hidden">ME Command Night</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeCommandNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeCommandNight = value)" /></label></div>
                </div>
            </EntryHourTable>
            <EntryHourTable Title="Copilot">
                <div class="totals-table-row" role="row">
                    <strong role="rowheader">Copilot</strong>
                    <div role="cell"><label><span class="visually-hidden">Copilot Day</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.CopilotDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.CopilotDay = value)" /></label></div>
                    <div role="cell"><label><span class="visually-hidden">Copilot Night</span><input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.CopilotNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.CopilotNight = value)" /></label></div>
                </div>
            </EntryHourTable>
            <div class="entry-hour-group">
                <h4>IFR</h4>
                <div class="field-grid">
                    <label>IFR IF <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.IfrIf)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.IfrIf = value)" /></label>
                    <label>IFR Sim <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.IfrSim)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.IfrSim = value)" /></label>
                </div>
            </div>
            @if (Session.WorkbookCustomFields.Count > 0)
            {
                <div class="entry-hour-group">
                    <h4>Custom fields</h4>
                    <div class="field-grid custom-field-grid">
                        @foreach (var field in Session.WorkbookCustomFields)
                        {
                            <label>@field.Label <input @bind="Session.WorkbookDraft.CustomValues[field.Id]" /></label>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <h2>Landings</h2>
            </div>
            <div class="field-grid numeric-grid">
                <label>Landings Day <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.LandingsDay" /></label>
                <label>Landings Night <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.LandingsNight" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <h2>Instrument Approaches</h2>
            </div>
            <div class="field-grid numeric-grid">
                <label>ILS <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Ils" /></label>
                <label>VOR <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Vor" /></label>
                <label>RNP <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Rnp" /></label>
                <label>NDB <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Ndb" /></label>
                <label>DGA (CDI) <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.DgaCdi" /></label>
                <label>DGA (Azi) <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.DgaAzi" /></label>
                <label>Circling <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Circling" /></label>
            </div>
        </section>

    </section>
}

@code {
    [Parameter]
    public string? EntryId { get; set; }

    private static string TodayIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private string? LoadedEditEntryId { get; set; }
    private DraftAction? PendingAction { get; set; }
    private IReadOnlyList<EntryDetail> ReviewDetails { get; set; } = [];
    private IReadOnlyList<MobileWorkbookEntryIssue> ReviewWarnings { get; set; } = [];
    private bool IsActionPending { get; set; }
    private bool ShowValidationFeedback { get; set; }
    private int ValidationFeedbackVersion { get; set; }
    private ElementReference ValidationSummary { get; set; }
    private string? AirportBasesError { get; set; }
    private string[] AirportBases { get; set; } = [];

    private async Task LoadAirportBasesAsync()
    {
        var logbookId = Session.DocumentV2.LogbookId;
        string[] bases = [];
        AirportBasesError = null;
        try
        {
            bases = await Store.LoadBaseAirportsAsync(logbookId);
        }
        catch (Exception ex) when (ex is JSException or System.Text.Json.JsonException or FormatException)
        {
            AirportBasesError = "Saved bases could not be loaded. Airport search and flight-history suggestions are still available.";
        }
        if (Session.DocumentV2.LogbookId == logbookId) AirportBases = bases;
    }

    private Task<IReadOnlyList<string>> LoadAirportSuggestionsAsync(string? query) => Task.FromResult(
        MobileAirportSuggestions.Ranked(Session.CurrentEntriesV2, AirportBases,
            DateOnly.FromDateTime(DateTime.Today), MobileAirportCatalog.Default, query));
    private string ReviewWarningCountLabel => $"{ReviewWarnings.Count} {(ReviewWarnings.Count == 1 ? "Warning" : "Warnings")}";
    private string ValidationFeedbackMessage => Session.WorkbookDraftErrors.Count == 1
        ? "Can't continue. 1 problem needs attention."
        : $"Can't continue. {Session.WorkbookDraftErrors.Count} problems need attention.";

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
        LoadEditRoute();
        await LoadAirportBasesAsync();
    }

    protected override void OnParametersSet()
    {
        if (Session.IsLoaded)
        {
            LoadEditRoute();
        }
    }

    private void ReviewSave()
    {
        if (!Session.PrepareWorkbookDraftForReview())
        {
            ShowValidationFailure();
            return;
        }

        ShowValidationFeedback = false;
        ReviewDetails = Session
            .EntryDetails(Session.WorkbookDraft.ToEntry(Session.WorkbookCustomFields))
            .ToArray();
        ReviewWarnings = Session.WorkbookDraftWarnings;
        PendingAction = DraftAction.ReviewSave;
    }

    private async Task ConfirmSaveAsync()
    {
        if (IsActionPending)
        {
            return;
        }

        IsActionPending = true;
        try
        {
            await Session.SaveWorkbookEntryAsync();
            if (Session.ShouldShowWorkbookDraftErrors)
            {
                PendingAction = null;
                ReviewWarnings = [];
                ShowValidationFailure();
            }
            else
            {
                PendingAction = null;
                ReviewWarnings = [];
                Navigation.NavigateTo("/");
            }
        }
        finally
        {
            IsActionPending = false;
        }
    }

    private void RequestClear()
    {
        PendingAction = DraftAction.Clear;
    }

    private void RequestCancel()
    {
        if (Session.HasEditedDraft)
        {
            PendingAction = DraftAction.Cancel;
            return;
        }

        ReturnToDashboard();
    }

    private void ConfirmDestructiveAction()
    {
        var action = PendingAction;
        PendingAction = null;
        if (action == DraftAction.Clear)
        {
            ShowValidationFeedback = false;
            Session.ResetWorkbookDraft();
            return;
        }

        if (action == DraftAction.Cancel)
        {
            ReturnToDashboard();
        }
    }

    private void DismissPendingAction()
    {
        if (!IsActionPending)
        {
            PendingAction = null;
            ReviewWarnings = [];
        }
    }

    private static void UpdateHour(ChangeEventArgs args, Action<decimal?> setValue)
    {
        setValue(MobileHourField.Parse(args.Value?.ToString()));
    }

    private void ShowValidationFailure()
    {
        ShowValidationFeedback = true;
        ValidationFeedbackVersion++;
    }

    private async Task ReviewErrorsAsync()
    {
        ShowValidationFeedback = false;
        await InvokeAsync(StateHasChanged);
        await ValidationSummary.FocusAsync();
    }

    private void ReturnToDashboard()
    {
        Navigation.NavigateTo("/", replace: true);
    }

    private static string ReviewGroupLabel(EntryDetailGroup group) => group switch
    {
        EntryDetailGroup.Flight => "Flight Details",
        EntryDetailGroup.Crew => "Crew",
        EntryDetailGroup.Route => "Route",
        EntryDetailGroup.LoggedTime => "Hours",
        EntryDetailGroup.CustomFields => "Custom fields",
        EntryDetailGroup.Landings => "Landings",
        EntryDetailGroup.InstrumentApproaches => "Instrument Approaches",
        _ => "Other"
    };

    private bool HasReviewWarning(string? field) =>
        field is not null && ReviewWarnings.Any(warning =>
            string.Equals(warning.AffectedField, field, StringComparison.Ordinal));

    private void LoadEditRoute()
    {
        if (string.IsNullOrWhiteSpace(EntryId) || LoadedEditEntryId == EntryId)
        {
            return;
        }

        var entry = Session.FindCurrentEntryV2(EntryId);
        if (entry is null)
        {
            Navigation.NavigateTo("/flights");
            return;
        }

        Session.EditWorkbookEntry(entry);
        LoadedEditEntryId = EntryId;
    }

    private enum DraftAction
    {
        ReviewSave,
        Clear,
        Cancel
    }
}
