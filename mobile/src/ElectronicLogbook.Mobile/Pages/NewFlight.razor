@page "/flights/new"
@page "/flights/{EntryId}/edit"
@inject MobileLogbookSession Session
@inject NavigationManager Navigation

<PageTitle>@(Session.EditingEntryId is null ? "New Flight" : "Edit Flight")</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading flight draft</span>
    </section>
}
else
{
    <section class="flight-entry-page">
        <a class="page-back-link"
           href="/"
           @onclick="RequestCancel"
           @onclick:preventDefault="true"
           aria-label="Back to dashboard">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />
            <span>Back to dashboard</span>
        </a>

        @if (PendingAction is not null)
        {
            <div class="entry-action-dialog-backdrop" @onclick="DismissPendingAction">
                <section class="entry-action-dialog"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="entry-action-dialog-title"
                         @onclick:stopPropagation="true">
                    @if (PendingAction == DraftAction.ReviewSave)
                    {
                        <header class="entry-action-dialog-header">
                            <span class="entry-action-dialog-icon entry-action-dialog-icon-review">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck" />
                            </span>
                            <div>
                                <span class="eyebrow">Review before saving</span>
                                <h2 id="entry-action-dialog-title">@(Session.EditingEntryId is null ? "Add this flight?" : "Save this correction?")</h2>
                            </div>
                        </header>
                        <div class="entry-review-values" tabindex="0" aria-label="Flight values to save">
                            @foreach (var group in ReviewDetails.GroupBy(detail => detail.Group))
                            {
                                <section class="entry-review-group">
                                    <h3>@ReviewGroupLabel(group.Key)</h3>
                                    <dl>
                                        @foreach (var detail in group)
                                        {
                                            <div>
                                                <dt>@detail.Label</dt>
                                                <dd>@detail.Value</dd>
                                            </div>
                                        }
                                    </dl>
                                </section>
                            }
                        </div>
                        <footer class="entry-action-dialog-actions">
                            <MudButton Variant="Variant.Text" OnClick="DismissPendingAction" Disabled="@IsActionPending">
                                Keep editing
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmSaveAsync" Disabled="@IsActionPending" StartIcon="@Icons.Material.Filled.Done">
                                @Session.SaveLabel
                            </MudButton>
                        </footer>
                    }
                    else
                    {
                        <header class="entry-action-dialog-header">
                            <span class="entry-action-dialog-icon entry-action-dialog-icon-warning">
                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                            </span>
                            <div>
                                <span class="eyebrow">Unsaved changes</span>
                                <h2 id="entry-action-dialog-title">@(PendingAction == DraftAction.Clear ? "Clear this form?" : "Discard this draft?")</h2>
                                <p>@(PendingAction == DraftAction.Clear
                                    ? "Every value in the form will be cleared. This cannot be undone."
                                    : "Your changes will not be saved before returning to the dashboard.")</p>
                            </div>
                        </header>
                        <footer class="entry-action-dialog-actions">
                            <MudButton Variant="Variant.Text" OnClick="DismissPendingAction">
                                Keep editing
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDestructiveAction" StartIcon="@Icons.Material.Filled.DeleteOutline">
                                @(PendingAction == DraftAction.Clear ? "Clear form" : "Discard draft")
                            </MudButton>
                        </footer>
                    }
                </section>
            </div>
        }

        <header class="entry-header entry-action-header">
            <div class="entry-action-context">
                <h1>@Session.DraftModeLabel</h1>
                <span class="entry-draft-status">
                    <span class="entry-draft-status-dot" aria-hidden="true"></span>
                    @(Session.HasEditedDraft ? "Draft edited" : "Ready")
                </span>
            </div>
            <div class="entry-header-actions" role="group" aria-label="Flight form actions">
                <MudButton Class="entry-clear-action" Variant="Variant.Filled" Color="Color.Default" OnClick="RequestClear" Disabled="@Session.IsStorageBlocked" aria-label="Clear form" title="Clear form">
                    Clear form
                </MudButton>
                <MudButton Class="entry-save-action" Variant="Variant.Filled" Color="Color.Primary" OnClick="ReviewSave" Disabled="@Session.IsStorageBlocked" aria-label="@Session.SaveLabel" title="@Session.SaveLabel">
                    @Session.SaveLabel
                </MudButton>
            </div>
        </header>

        @if (Session.ShouldShowLastActionMessage(MobileActionMessageSurface.Draft))
        {
            <section class="state-banner" role="status">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                <span>@Session.LastActionMessage</span>
            </section>
        }

        @if (Session.ShouldShowWorkbookDraftErrors)
        {
            <section class="state-banner state-banner-error" role="alert" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
                <div>
                    @foreach (var error in Session.WorkbookDraftErrors)
                    {
                        <span>@error</span>
                    }
                </div>
            </section>
        }

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Flight</span>
                    <h2>Identity</h2>
                </div>
            </div>
            <div class="field-grid">
                <label>Date <input type="date" max="@TodayIso" @bind="Session.WorkbookDraft.Date" /></label>
                <label>Type <input @bind="Session.WorkbookDraft.Type" autocapitalize="characters" spellcheck="false" /></label>
                <label>Reg <input @bind="Session.WorkbookDraft.Reg" autocapitalize="characters" spellcheck="false" /></label>
                <label>Flight ID <input @bind="Session.WorkbookDraft.FlightId" autocapitalize="characters" spellcheck="false" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Crew and route</span>
                    <h2>Pilots and remarks</h2>
                </div>
            </div>
            <div class="field-grid">
                <label>PIC <input @bind="Session.WorkbookDraft.Pic" autocapitalize="words" /></label>
                <label>Other pilot or crew <input @bind="Session.WorkbookDraft.OtherPilotOrCrew" autocapitalize="words" /></label>
                <label>From <input @bind="Session.WorkbookDraft.From" autocapitalize="characters" spellcheck="false" /></label>
                <label>To <input @bind="Session.WorkbookDraft.To" autocapitalize="characters" spellcheck="false" /></label>
                <label class="field-span">Via <input @bind="Session.WorkbookDraft.Via" autocapitalize="characters" spellcheck="false" /></label>
            </div>
            <label class="field-wide">Remarks <textarea @bind="Session.WorkbookDraft.Remarks"></textarea></label>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Checks and fields</span>
                    <h2>FR, IPC, OPC, and custom fields</h2>
                </div>
            </div>
            <div class="field-grid check-grid">
                <label class="check-option"><input type="checkbox" @bind="Session.WorkbookDraft.FlightReview" /> Flight review</label>
                <label class="check-option"><input type="checkbox" @bind="Session.WorkbookDraft.InstrumentProficiencyCheck" /> IPC</label>
                <label class="check-option"><input type="checkbox" @bind="Session.WorkbookDraft.OperatorProficiencyCheck" /> OPC</label>
            </div>
            <div class="field-grid custom-field-grid">
                @foreach (var field in Session.WorkbookCustomFields)
                {
                    <label>@field.Label <input @bind="Session.WorkbookDraft.CustomValues[field.Id]" /></label>
                }
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Times</span>
                    <h2>Operating capacity</h2>
                </div>
            </div>
            <div class="field-grid numeric-grid">
                <label>SE ICUS day <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeIcusDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeIcusDay = value)" /></label>
                <label>SE ICUS night <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeIcusNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeIcusNight = value)" /></label>
                <label>SE dual day <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeDualDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeDualDay = value)" /></label>
                <label>SE dual night <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeDualNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeDualNight = value)" /></label>
                <label>SE command day <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeCommandDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeCommandDay = value)" /></label>
                <label>SE command night <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.SeCommandNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeCommandNight = value)" /></label>
                <label>ME ICUS day <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeIcusDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeIcusDay = value)" /></label>
                <label>ME ICUS night <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeIcusNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeIcusNight = value)" /></label>
                <label>ME dual day <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeDualDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeDualDay = value)" /></label>
                <label>ME dual night <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeDualNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeDualNight = value)" /></label>
                <label>ME command day <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeCommandDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeCommandDay = value)" /></label>
                <label>ME command night <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.MeCommandNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeCommandNight = value)" /></label>
                <label>Copilot day <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.CopilotDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.CopilotDay = value)" /></label>
                <label>Copilot night <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.CopilotNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.CopilotNight = value)" /></label>
                <label>IFR IF <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.IfrIf)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.IfrIf = value)" /></label>
                <label>IFR sim <input type="number" step="0.1" min="0" inputmode="decimal" value="@MobileHourField.Format(Session.WorkbookDraft.IfrSim)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.IfrSim = value)" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Currency</span>
                    <h2>Landings</h2>
                </div>
            </div>
            <div class="field-grid numeric-grid">
                <label>Landings day <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.LandingsDay" /></label>
                <label>Landings night <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.LandingsNight" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Currency</span>
                    <h2>Approach types</h2>
                </div>
            </div>
            <div class="field-grid numeric-grid">
                <label>ILS <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Ils" /></label>
                <label>VOR <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Vor" /></label>
                <label>RNP <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Rnp" /></label>
                <label>NDB <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Ndb" /></label>
                <label>DGA (CDI) <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.DgaCdi" /></label>
                <label>DGA (Azi) <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.DgaAzi" /></label>
                <label>Circling <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Circling" /></label>
            </div>
        </section>

    </section>
}

@code {
    [Parameter]
    public string? EntryId { get; set; }

    private static string TodayIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private string? LoadedEditEntryId { get; set; }
    private DraftAction? PendingAction { get; set; }
    private IReadOnlyList<EntryDetail> ReviewDetails { get; set; } = [];
    private bool IsActionPending { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
        LoadEditRoute();
    }

    protected override void OnParametersSet()
    {
        if (Session.IsLoaded)
        {
            LoadEditRoute();
        }
    }

    private void ReviewSave()
    {
        if (!Session.PrepareWorkbookDraftForReview())
        {
            return;
        }

        ReviewDetails = Session
            .EntryDetails(Session.WorkbookDraft.ToEntry(Session.WorkbookCustomFields))
            .ToArray();
        PendingAction = DraftAction.ReviewSave;
    }

    private async Task ConfirmSaveAsync()
    {
        if (IsActionPending)
        {
            return;
        }

        IsActionPending = true;
        try
        {
            await Session.SaveWorkbookEntryAsync();
            if (!Session.ShouldShowWorkbookDraftErrors)
            {
                PendingAction = null;
                Navigation.NavigateTo("/");
            }
        }
        finally
        {
            IsActionPending = false;
        }
    }

    private void RequestClear()
    {
        PendingAction = DraftAction.Clear;
    }

    private void RequestCancel()
    {
        if (Session.HasEditedDraft)
        {
            PendingAction = DraftAction.Cancel;
            return;
        }

        ReturnToDashboard();
    }

    private void ConfirmDestructiveAction()
    {
        var action = PendingAction;
        PendingAction = null;
        if (action == DraftAction.Clear)
        {
            Session.ResetWorkbookDraft();
            return;
        }

        if (action == DraftAction.Cancel)
        {
            ReturnToDashboard();
        }
    }

    private void DismissPendingAction()
    {
        if (!IsActionPending)
        {
            PendingAction = null;
        }
    }

    private static void UpdateHour(ChangeEventArgs args, Action<decimal?> setValue)
    {
        setValue(MobileHourField.Parse(args.Value?.ToString()));
    }

    private void ReturnToDashboard()
    {
        Navigation.NavigateTo("/", replace: true);
    }

    private static string ReviewGroupLabel(EntryDetailGroup group) => group switch
    {
        EntryDetailGroup.Flight => "Flight",
        EntryDetailGroup.CrewAndRoute => "Crew and route",
        EntryDetailGroup.Checks => "Checks",
        EntryDetailGroup.LoggedTime => "Logged time",
        EntryDetailGroup.CustomFields => "Custom fields",
        EntryDetailGroup.LandingsAndApproaches => "Landings and approaches",
        _ => "Other"
    };

    private void LoadEditRoute()
    {
        if (string.IsNullOrWhiteSpace(EntryId) || LoadedEditEntryId == EntryId)
        {
            return;
        }

        var entry = Session.FindCurrentEntryV2(EntryId);
        if (entry is null)
        {
            Navigation.NavigateTo("/flights");
            return;
        }

        Session.EditWorkbookEntry(entry);
        LoadedEditEntryId = EntryId;
    }

    private enum DraftAction
    {
        ReviewSave,
        Clear,
        Cancel
    }
}
