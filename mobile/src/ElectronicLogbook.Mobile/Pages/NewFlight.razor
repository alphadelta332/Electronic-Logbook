@page "/flights/new"
@page "/flights/{EntryId}/edit"
@inject MobileLogbookSession Session
@inject NavigationManager Navigation

<PageTitle>@(Session.EditingEntryId is null ? "New Flight" : "Edit Flight")</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading flight draft</span>
    </section>
}
else
{
    <section class="flight-entry-page">
        @if (ShowSaveConfirmation)
        {
            <section class="save-confirmation" role="status" aria-live="assertive">
                <span class="save-confirmation-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Check" />
                </span>
                <strong>@SaveConfirmationMessage</strong>
            </section>
        }

        <header class="entry-header">
            <div>
                <span class="eyebrow">@Session.DraftModeLabel</span>
                <h1>@Session.WorkbookDraft.Date.ToString("dd MMM yyyy")</h1>
            </div>
            <span class="draft-pill">@(Session.HasEditedDraft ? "Draft edited" : "Ready")</span>
        </header>

        @if (Session.ShouldShowLastActionMessage(MobileActionMessageSurface.Draft))
        {
            <section class="state-banner" role="status">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                <span>@Session.LastActionMessage</span>
            </section>
        }

        @if (Session.ShouldShowWorkbookDraftErrors)
        {
            <section class="state-banner state-banner-error" role="alert" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
                <div>
                    @foreach (var error in Session.WorkbookDraftErrors)
                    {
                        <span>@error</span>
                    }
                </div>
            </section>
        }

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Flight</span>
                    <h2>Identity</h2>
                </div>
            </div>
            <div class="field-grid">
                <label>Date <input type="date" max="@TodayIso" @bind="Session.WorkbookDraft.Date" /></label>
                <label>Type <input @bind="Session.WorkbookDraft.Type" autocapitalize="characters" spellcheck="false" /></label>
                <label>Reg <input @bind="Session.WorkbookDraft.Reg" autocapitalize="characters" spellcheck="false" /></label>
                <label>Flight ID <input @bind="Session.WorkbookDraft.FlightId" autocapitalize="characters" spellcheck="false" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Crew and route</span>
                    <h2>Pilots and remarks</h2>
                </div>
            </div>
            <div class="field-grid">
                <label>PIC <input @bind="Session.WorkbookDraft.Pic" autocapitalize="words" /></label>
                <label>Other pilot or crew <input @bind="Session.WorkbookDraft.OtherPilotOrCrew" autocapitalize="words" /></label>
                <label>From <input @bind="Session.WorkbookDraft.From" autocapitalize="characters" spellcheck="false" /></label>
                <label>To <input @bind="Session.WorkbookDraft.To" autocapitalize="characters" spellcheck="false" /></label>
                <label class="field-span">Via <input @bind="Session.WorkbookDraft.Via" autocapitalize="characters" spellcheck="false" /></label>
            </div>
            <label class="field-wide">Remarks <textarea @bind="Session.WorkbookDraft.Remarks"></textarea></label>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Checks and fields</span>
                    <h2>FR, IPC, OPC, and custom fields</h2>
                </div>
            </div>
            <div class="field-grid check-grid">
                <label class="check-option"><input type="checkbox" @bind="Session.WorkbookDraft.FlightReview" /> Flight review</label>
                <label class="check-option"><input type="checkbox" @bind="Session.WorkbookDraft.InstrumentProficiencyCheck" /> IPC</label>
                <label class="check-option"><input type="checkbox" @bind="Session.WorkbookDraft.OperatorProficiencyCheck" /> OPC</label>
            </div>
            <div class="field-grid custom-field-grid">
                @foreach (var field in Session.WorkbookCustomFields)
                {
                    <label>@field.Label <input @bind="Session.WorkbookDraft.CustomValues[field.Id]" /></label>
                }
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Times</span>
                    <h2>Operating capacity</h2>
                </div>
            </div>
            <div class="field-grid numeric-grid">
                <label>SE ICUS day <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.SeIcusDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeIcusDay = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.SeIcusDay, value => Session.WorkbookDraft.SeIcusDay = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.SeIcusDay, value => Session.WorkbookDraft.SeIcusDay = value)" /></label>
                <label>SE ICUS night <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.SeIcusNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeIcusNight = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.SeIcusNight, value => Session.WorkbookDraft.SeIcusNight = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.SeIcusNight, value => Session.WorkbookDraft.SeIcusNight = value)" /></label>
                <label>SE dual day <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.SeDualDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeDualDay = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.SeDualDay, value => Session.WorkbookDraft.SeDualDay = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.SeDualDay, value => Session.WorkbookDraft.SeDualDay = value)" /></label>
                <label>SE dual night <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.SeDualNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeDualNight = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.SeDualNight, value => Session.WorkbookDraft.SeDualNight = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.SeDualNight, value => Session.WorkbookDraft.SeDualNight = value)" /></label>
                <label>SE command day <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.SeCommandDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeCommandDay = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.SeCommandDay, value => Session.WorkbookDraft.SeCommandDay = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.SeCommandDay, value => Session.WorkbookDraft.SeCommandDay = value)" /></label>
                <label>SE command night <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.SeCommandNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.SeCommandNight = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.SeCommandNight, value => Session.WorkbookDraft.SeCommandNight = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.SeCommandNight, value => Session.WorkbookDraft.SeCommandNight = value)" /></label>
                <label>ME ICUS day <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.MeIcusDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeIcusDay = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.MeIcusDay, value => Session.WorkbookDraft.MeIcusDay = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.MeIcusDay, value => Session.WorkbookDraft.MeIcusDay = value)" /></label>
                <label>ME ICUS night <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.MeIcusNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeIcusNight = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.MeIcusNight, value => Session.WorkbookDraft.MeIcusNight = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.MeIcusNight, value => Session.WorkbookDraft.MeIcusNight = value)" /></label>
                <label>ME dual day <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.MeDualDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeDualDay = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.MeDualDay, value => Session.WorkbookDraft.MeDualDay = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.MeDualDay, value => Session.WorkbookDraft.MeDualDay = value)" /></label>
                <label>ME dual night <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.MeDualNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeDualNight = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.MeDualNight, value => Session.WorkbookDraft.MeDualNight = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.MeDualNight, value => Session.WorkbookDraft.MeDualNight = value)" /></label>
                <label>ME command day <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.MeCommandDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeCommandDay = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.MeCommandDay, value => Session.WorkbookDraft.MeCommandDay = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.MeCommandDay, value => Session.WorkbookDraft.MeCommandDay = value)" /></label>
                <label>ME command night <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.MeCommandNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.MeCommandNight = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.MeCommandNight, value => Session.WorkbookDraft.MeCommandNight = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.MeCommandNight, value => Session.WorkbookDraft.MeCommandNight = value)" /></label>
                <label>Copilot day <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.CopilotDay)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.CopilotDay = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.CopilotDay, value => Session.WorkbookDraft.CopilotDay = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.CopilotDay, value => Session.WorkbookDraft.CopilotDay = value)" /></label>
                <label>Copilot night <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.CopilotNight)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.CopilotNight = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.CopilotNight, value => Session.WorkbookDraft.CopilotNight = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.CopilotNight, value => Session.WorkbookDraft.CopilotNight = value)" /></label>
                <label>IFR IF <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.IfrIf)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.IfrIf = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.IfrIf, value => Session.WorkbookDraft.IfrIf = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.IfrIf, value => Session.WorkbookDraft.IfrIf = value)" /></label>
                <label>IFR sim <input type="number" step="0.1" min="0" inputmode="decimal" value="@FormatHour(Session.WorkbookDraft.IfrSim)" @onchange="args => UpdateHour(args, value => Session.WorkbookDraft.IfrSim = value)" @onfocus="() => ShowHourDefault(() => Session.WorkbookDraft.IfrSim, value => Session.WorkbookDraft.IfrSim = value)" @onblur="() => ClearUntouchedHour(() => Session.WorkbookDraft.IfrSim, value => Session.WorkbookDraft.IfrSim = value)" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Currency</span>
                    <h2>Landings</h2>
                </div>
            </div>
            <div class="field-grid numeric-grid">
                <label>Landings day <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.LandingsDay" /></label>
                <label>Landings night <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.LandingsNight" /></label>
            </div>
        </section>

        <section class="form-section" @oninput="Session.MarkDraftEdited" @onchange="Session.MarkDraftEdited">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">Currency</span>
                    <h2>Approach types</h2>
                </div>
            </div>
            <div class="field-grid numeric-grid">
                <label>ILS <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Ils" /></label>
                <label>VOR <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Vor" /></label>
                <label>RNP <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Rnp" /></label>
                <label>NDB <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Ndb" /></label>
                <label>DGA (CDI) <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.DgaCdi" /></label>
                <label>DGA (Azi) <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.DgaAzi" /></label>
                <label>Circling <input type="number" min="0" inputmode="numeric" @bind="Session.WorkbookDraft.Circling" /></label>
            </div>
        </section>

        <aside class="persistent-action-bar">
            <div class="action-buttons">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Session.ResetWorkbookDraft" Disabled="@Session.IsStorageBlocked" aria-label="Clear draft" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Session.IsStorageBlocked" StartIcon="@Icons.Material.Filled.Done">
                    @Session.SaveLabel
                </MudButton>
            </div>
        </aside>
    </section>
}

@code {
    [Parameter]
    public string? EntryId { get; set; }

    private static string TodayIso => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private bool ShowSaveConfirmation { get; set; }
    private string SaveConfirmationMessage { get; set; } = "Saved";
    private string? LoadedEditEntryId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
        LoadEditRoute();
    }

    protected override void OnParametersSet()
    {
        if (Session.IsLoaded)
        {
            LoadEditRoute();
        }
    }

    private async Task SaveAsync()
    {
        var confirmationMessage = Session.EditingEntryId is null ? "Flight added" : "Correction saved";
        await Session.SaveWorkbookEntryAsync();
        if (!Session.ShouldShowWorkbookDraftErrors)
        {
            SaveConfirmationMessage = confirmationMessage;
            ShowSaveConfirmation = true;
            await Task.Delay(650);
            Navigation.NavigateTo("/");
        }
    }

    private static void ShowHourDefault(Func<decimal?> getValue, Action<decimal?> setValue)
    {
        if (!getValue().HasValue)
        {
            setValue(0m);
        }
    }

    private static string FormatHour(decimal? value) => value?.ToString("0.0") ?? string.Empty;

    private static void UpdateHour(ChangeEventArgs args, Action<decimal?> setValue)
    {
        if (decimal.TryParse(args.Value?.ToString(), out var value))
        {
            setValue(value);
            return;
        }

        setValue(null);
    }

    private static void ClearUntouchedHour(Func<decimal?> getValue, Action<decimal?> setValue)
    {
        if (getValue().GetValueOrDefault() == 0m)
        {
            setValue(null);
        }
    }

    private void LoadEditRoute()
    {
        if (string.IsNullOrWhiteSpace(EntryId) || LoadedEditEntryId == EntryId)
        {
            return;
        }

        var entry = Session.FindCurrentEntryV2(EntryId);
        if (entry is null)
        {
            Navigation.NavigateTo("/flights");
            return;
        }

        Session.EditWorkbookEntry(entry);
        LoadedEditEntryId = EntryId;
    }
}
