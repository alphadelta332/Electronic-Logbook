@page "/exchange"
@inject MobileLogbookSession Session
@inject BrowserPackageKeyStore PackageKeyStore
@inject BrowserFileStore FileStore

<PageTitle>Advanced recovery</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading advanced recovery</span>
    </section>
}
else
{
    <section class="settings-page package-exchange-page">
        <header class="entry-header">
            <div>
                <span class="eyebrow">Advanced recovery</span>
                <h1>Manual Package Exchange</h1>
            </div>
            <span class="draft-pill">@Session.PackageKeyStatus</span>
        </header>

        <section class="notice-panel">
            <MudIcon Icon="@Icons.Material.Filled.SyncLock" />
            <div>
                <strong>Support workflow</strong>
                <span>Use this only for recovery, account export, key loss, conflict support, or moving data when hosted sync cannot be used.</span>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">1. Inspect</span>
                    <h2>Recovery package</h2>
                </div>
            </div>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="PreviewPackageAsync" Disabled="@IsBusy">Inspect recovery package</MudButton>
            @if (ImportPlan is not null)
            {
                <span class="settings-status-line package-file-summary">@ImportPlan.FileName · schema @ImportPlan.SchemaVersion · @ImportPlan.OperationCount operation(s) · created @FormatTimestamp(ImportPlan.PackageCreatedAt)</span>
            }
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">2. Verify</span>
                    <h2>Recovery code</h2>
                </div>
            </div>
            <MudTextField @bind-Value="RecoveryCode" InputType="InputType.Password" Label="Recovery code" Disabled="@(IsBusy || ImportPlan is null)" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key" OnClick="RestoreKeyAsync" Disabled="@(IsBusy || ImportPlan is null || string.IsNullOrWhiteSpace(RecoveryCode))">Verify recovery code</MudButton>
        </section>

        <section class="form-section">
            <div class="section-title-row">
                <div>
                    <span class="eyebrow">3. Recover or export</span>
                    <h2>Encrypted support package</h2>
                </div>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ImportPackageAsync" Disabled="@(!CanImport)">Recover from package</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.IosShare" OnClick="ExportPackageAsync" Disabled="@(!CanExport)">Export support package</MudButton>
        </section>

        @if (ImportExchangePlan?.Status == PortableLogbookImportPlanStatus.RequiresCustomFieldResolution)
        {
            <section class="form-section custom-field-resolution" aria-labelledby="custom-field-resolution-heading">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Resolve labels</span>
                        <h2 id="custom-field-resolution-heading">Custom field differences</h2>
                    </div>
                </div>
                <span class="settings-status-line">Choose which labels this device should keep. Flight values and immutable history are preserved.</span>
                @foreach (var conflict in ImportExchangePlan.Preview.CustomFieldDefinitions.Conflicts)
                {
                    <article class="custom-field-resolution-row">
                        <strong>@conflict.Id.Value</strong>
                        <span>On this device: @conflict.LocalDefinition.Label</span>
                        <span>In package: @conflict.IncomingDefinition.Label</span>
                    </article>
                }
                <div class="row-actions">
                    <MudButton Variant="Variant.Outlined" OnClick="() => ResolveCustomFieldsAsync(PortableLogbookCustomFieldDefinitionChoice.KeepLocal)" Disabled="@(!CanResolveCustomFields)">Keep device labels</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ResolveCustomFieldsAsync(PortableLogbookCustomFieldDefinitionChoice.UseIncoming)" Disabled="@(!CanResolveCustomFields)">Use package labels</MudButton>
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Message) || !string.IsNullOrWhiteSpace(Error))
        {
            <section class="state-banner package-exchange-feedback @(string.IsNullOrWhiteSpace(Error) ? null : "state-banner-error")" role="@(string.IsNullOrWhiteSpace(Error) ? "status" : "alert")" aria-live="polite">
                <MudIcon Icon="@(string.IsNullOrWhiteSpace(Error) ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ErrorOutline)" />
                <div>
                    <strong>@(string.IsNullOrWhiteSpace(Error) ? "Recovery ready" : "Recovery needs attention")</strong>
                    <span>@(Error ?? Message)</span>
                </div>
            </section>
        }
    </section>
}

@code {
    private BrowserFile? PendingImportFile { get; set; }
    private MobilePackageImportPlanResult? ImportPlan { get; set; }
    private PortableLogbookImportPlanV2? ImportExchangePlan { get; set; }
    private string RecoveryCode { get; set; } = string.Empty;
    private bool IsBusy { get; set; }
    private string? Message { get; set; }
    private string? Error { get; set; }

    private bool CanImport =>
        !Session.IsStorageBlocked &&
        !IsBusy &&
        PendingImportFile is not null &&
        ImportPlan is not null &&
        ImportPlan.SchemaVersion == PortableLogbookDocumentV2.CurrentSchemaVersion &&
        ImportPlan.LogbookId == Session.DocumentV2.LogbookId &&
        Session.PackageKeyStatus == "Ready";

    private bool CanExport => !Session.IsStorageBlocked && !IsBusy && Session.PackageKeyStatus == "Ready";

    private bool CanResolveCustomFields => CanImport &&
        ImportExchangePlan?.Status == PortableLogbookImportPlanStatus.RequiresCustomFieldResolution;

    protected override async Task OnInitializedAsync() => await Session.EnsureLoadedWorkbookAsync();

    private async Task PreviewPackageAsync()
    {
        await RunExchangeAsync(async () =>
        {
            var file = await FileStore.PickElogbookAsync();
            if (file is null)
            {
                return;
            }

            var plan = MobilePackageImportPlan.Inspect(file);
            if (plan.SchemaVersion != PortableLogbookDocumentV2.CurrentSchemaVersion)
            {
                throw new InvalidOperationException("This package is not schema v2. Re-export it from the authoritative workbook.");
            }

            if (plan.LogbookId != Session.DocumentV2.LogbookId &&
                (Session.DocumentV2.Operations.Count > 0 || Session.ImportReceipts.Count > 0))
            {
                throw new InvalidOperationException("This device copy already contains another logbook. Export it before importing a different workbook package.");
            }

            PendingImportFile = file;
            ImportPlan = plan;
            ImportExchangePlan = null;
            RecoveryCode = string.Empty;
            Message = "Package manifest previewed. Restore the matching workbook recovery key before importing.";
        });
    }

    private async Task RestoreKeyAsync()
    {
        await RunExchangeAsync(async () =>
        {
            var plan = ImportPlan ?? throw new InvalidOperationException("Preview a schema-v2 package before restoring its key.");
            var file = PendingImportFile ?? throw new InvalidOperationException("Select the package again before restoring its key.");
            if (!await Session.RestoreWorkbookPackageKeyAsync(plan.LogbookId, RecoveryCode))
            {
                throw new InvalidOperationException("The browser could not retain the restored package key.");
            }

            var validationDocument = PortableLogbookDocumentV2.CreateAustraliaFirst(
                plan.LogbookId,
                Session.WorkbookCustomFields,
                PortableLogbookCurrencyOverrideDates.Empty,
                []);
            try
            {
                _ = await MobilePackageImportWorkflow.ReadV2Async(validationDocument, file, PackageKeyStore);
            }
            catch (MobilePackageImportWorkflowException ex)
            {
                await PackageKeyStore.DeletePackageKeyAsync(plan.LogbookId);
                throw new InvalidOperationException(
                    "Recovery code does not decrypt the selected package. Confirm the recovery code and .elogbook file came from the same workbook export.",
                    ex);
            }

            await Session.AdoptWorkbookLogbookAsync(plan.LogbookId);
            RecoveryCode = string.Empty;
            Message = "Package key restored and verified against the selected schema-v2 package.";
        });
    }

    private async Task ImportPackageAsync()
    {
        await RunExchangeAsync(async () =>
        {
            var file = PendingImportFile ?? throw new InvalidOperationException("Preview the package before importing it.");
            var result = await Session.ApplyWorkbookPackageAsync(file, DateTimeOffset.UtcNow);
            ImportExchangePlan = result.Plan;
            if (result.Status == MobilePackageImportApplyStatus.RequiresResolution)
            {
                Error = "Choose which custom-field labels to keep before importing this package.";
                return;
            }

            Message = FormatImportResult(result.Status);
        });
    }

    private async Task ResolveCustomFieldsAsync(PortableLogbookCustomFieldDefinitionChoice choice)
    {
        await RunExchangeAsync(async () =>
        {
            var file = PendingImportFile ?? throw new InvalidOperationException("Preview the package before resolving custom-field labels.");
            var plan = ImportExchangePlan ?? throw new InvalidOperationException("Import the package once to inspect its custom-field differences.");
            var resolutions = plan.Preview.CustomFieldDefinitions.Conflicts
                .Select(conflict => new PortableLogbookCustomFieldDefinitionResolution(conflict.Id, choice))
                .ToArray();
            var result = await Session.ApplyWorkbookPackageWithCustomFieldResolutionsAsync(
                file,
                resolutions,
                DateTimeOffset.UtcNow);
            ImportExchangePlan = result.Plan;
            Message = FormatImportResult(result.Status);
        });
    }

    private async Task ExportPackageAsync()
    {
        await RunExchangeAsync(async () =>
        {
            var result = await Session.ExportWorkbookPackageAsync(FileStore, DateTimeOffset.UtcNow);
            Message = $"Exported {result.FileName}.";
        });
    }

    private async Task RunExchangeAsync(Func<Task> action)
    {
        if (IsBusy || Session.IsStorageBlocked)
        {
            return;
        }

        IsBusy = true;
        Message = null;
        Error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or BrowserFileStoreException or MobilePackageImportWorkflowException or PortableLogbookPackageException or JSException)
        {
            Error = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static string FormatImportResult(MobilePackageImportApplyStatus status) => status switch
    {
        MobilePackageImportApplyStatus.PackageReplay => "This package was already imported.",
        MobilePackageImportApplyStatus.DuplicateOperationsRecorded => "Duplicate operations were recorded safely.",
        MobilePackageImportApplyStatus.AppliedWithConflicts => "Package imported; entry conflicts need resolution in the logbook.",
        _ => "Package imported successfully."
    };

    private static string FormatTimestamp(DateTimeOffset value) => value.ToLocalTime().ToString("dd MMM yyyy, HH:mm");
}
