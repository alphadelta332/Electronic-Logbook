@page "/flights"
@implements IDisposable
@inject MobileLogbookSession Session
@inject NavigationManager Navigation

<PageTitle>Logbook</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading logbook</span>
    </section>
}
else
{
    <section class="logbook-page">
        <header class="entry-header">
            <div>
                <span class="eyebrow">Logbook</span>
                <h1>Flight record</h1>
            </div>
            <span class="draft-pill">@(Session.CurrentEntriesV2.Count == 1 ? "1 entry" : $"{Session.CurrentEntriesV2.Count} entries")</span>
        </header>

        @if (Session.ShouldShowLastActionMessage(MobileActionMessageSurface.Logbook))
        {
            <section class="state-banner" role="status">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                <span>@Session.LastActionMessage</span>
            </section>
        }

        <div class="segmented-control" role="group" aria-label="Logbook view">
            <button type="button" class="@EntriesTabClass" aria-pressed="@(ActiveView == LogbookView.Entries)" @onclick="() => SelectView(LogbookView.Entries)">Entries</button>
            <button type="button" class="@TotalsTabClass" aria-pressed="@(ActiveView == LogbookView.Totals)" @onclick="() => SelectView(LogbookView.Totals)">Totals</button>
            <button type="button" class="@DeletedTabClass" aria-pressed="@(ActiveView == LogbookView.Deleted)" @onclick="() => SelectView(LogbookView.Deleted)">Deleted</button>
        </div>

        @if (ActiveView == LogbookView.Entries)
        {
            <section class="form-section">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Entries</span>
                        <h2>Current record</h2>
                    </div>
                    <MudButton class="logbook-filter-button" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList" OnClick="@(() => ShowFilters = !ShowFilters)">
                        Filters
                    </MudButton>
                </div>

                <label class="search-field">
                    Search
                    <input @bind="SearchText" @bind:event="oninput" placeholder="Rego, route, type, remarks" />
                </label>

                @if (ShowFilters)
                {
                    <section class="filter-sheet" aria-label="Logbook filters">
                        <label>
                            <input type="checkbox" @bind="FilterRecentOnly" />
                            Last 90 days
                        </label>
                        <label>
                            <input type="checkbox" @bind="FilterFlightsWithApproachesOnly" />
                            Approaches logged
                        </label>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearFilters">Clear</MudButton>
                    </section>
                }

                @if (FilteredEntries.Count == 0)
                {
                    <section class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.Flight" />
                        <strong>No matching flights</strong>
                        <span>Import a package, add a flight from Dashboard, or clear search.</span>
                    </section>
                }
                else
                {
                    <div class="flight-row-list">
                        @foreach (var entry in FilteredEntries)
                        {
                            <LogbookFlightRow Entry="@entry" />
                        }
                    </div>
                }
            </section>
        }
        else if (ActiveView == LogbookView.Totals)
        {
            <section class="form-section logbook-totals">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Totals</span>
                        <h2>Flying totals</h2>
                    </div>
                    <MudButton class="logbook-filter-button" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList" OnClick="@(() => ShowTotalsFilters = !ShowTotalsFilters)">
                        @TotalsFilterButtonLabel
                    </MudButton>
                </div>

                <p class="totals-filter-count" role="status">@TotalsEntryCountLabel</p>

                @if (ShowTotalsFilters)
                {
                    <section class="totals-filter-sheet" aria-label="Totals filters">
                        <div class="totals-filter-explanation">
                            <strong>Filter the flights included in these totals</strong>
                            <span>Choose values from any logbook column. Values in one column use “or”; different columns use “and”.</span>
                        </div>

                        @if (TotalsFilterCount > 0)
                        {
                            <div class="totals-active-filters" aria-label="Active totals filters">
                                @if (HasTotalsDateRange)
                                {
                                    <div class="totals-active-filter">
                                        <span>
                                            <strong>Date</strong>
                                            <small>@TotalsDateRangeSummary</small>
                                        </span>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="ClearTotalsDateRange" aria-label="Clear Date filter" />
                                    </div>
                                }
                                @foreach (var selection in ActiveTotalsFilterSelections)
                                {
                                    var field = TotalsFilterFields.Single(filterField => filterField.Id == selection.Key);
                                    <div class="totals-active-filter">
                                        <span>
                                            <strong>@field.Label</strong>
                                            <small>@TotalsFilterSelectionSummary(field, selection.Value)</small>
                                        </span>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => ClearTotalsFilter(field.Id))" aria-label="@($"Clear {field.Label} filter")" />
                                    </div>
                                }
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearAllTotalsFilters">Clear all filters</MudButton>
                            </div>
                        }

                        <label class="totals-filter-field">
                            Logbook column
                            <select value="@SelectedTotalsFilterFieldId" @onchange="OnTotalsFilterFieldChanged">
                                @foreach (var field in TotalsFilterFields)
                                {
                                    <option value="@field.Id">@(TotalsFilterSelections.ContainsKey(field.Id) ? $"{field.Label} (filtered)" : field.Label)</option>
                                }
                            </select>
                        </label>

                        @if (SelectedTotalsFilterField.Kind == MobileLogbookTotalsFilterFieldKind.Date)
                        {
                            <div class="totals-filter-date-range">
                                <label>Start date <input type="date" value="@TotalsStartDateText" max="@TotalsEndDateText" @onchange="OnTotalsStartDateChanged" /></label>
                                <label>End date <input type="date" value="@TotalsEndDateText" min="@TotalsStartDateText" @onchange="OnTotalsEndDateChanged" /></label>
                            </div>
                            <small class="totals-filter-hint">The date range includes both selected dates. Leave either end blank for an open range.</small>
                        }
                        else
                        {
                            <label class="totals-filter-search">
                                Find a value
                                <input @bind="TotalsFilterValueSearchText" @bind:event="oninput" placeholder="Search values in this column" />
                            </label>

                            <div class="totals-filter-value-actions">
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SelectAllTotalsFilterValues">Select all</MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SelectNoTotalsFilterValues">Select none</MudButton>
                            </div>

                            @if (VisibleTotalsFilterValues.Count == 0)
                            {
                                <p class="totals-filter-empty">No column values match that search.</p>
                            }
                            else
                            {
                                <div class="totals-filter-values" role="group" aria-label="@($"Values for {SelectedTotalsFilterField.Label}")">
                                    @foreach (var value in VisibleTotalsFilterValues)
                                    {
                                        <label>
                                            <input type="checkbox" checked="@IsTotalsFilterValueSelected(value.Key)" @onchange="@(args => ToggleTotalsFilterValue(value.Key, args))" />
                                            <span>@value.Label</span>
                                            <small>@value.EntryCount</small>
                                        </label>
                                    }
                                </div>
                            }
                        }
                    </section>
                }

                @if (TotalsEntries.Count == 0 && Session.CurrentEntriesV2.Count > 0)
                {
                    <section class="totals-filter-no-match" role="alert">
                        <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" aria-hidden="true" />
                        <span>No flights match these filters. The totals below are zero.</span>
                    </section>
                }

                <section class="totals-group" aria-labelledby="single-engine-totals-heading">
                    <div class="totals-group-heading">
                        <h3 id="single-engine-totals-heading">Single engine</h3>
                    </div>
                    <div class="totals-table" role="table" aria-label="Single engine flying totals">
                        <div class="totals-table-row totals-table-header" role="row">
                            <span role="columnheader">Capacity</span>
                            <span class="totals-time-header" role="columnheader">
                                <MudIcon Icon="@Icons.Material.Filled.LightMode" aria-hidden="true" />
                                <span>Day</span>
                            </span>
                            <span class="totals-time-header" role="columnheader">
                                <MudIcon Icon="@Icons.Material.Filled.DarkMode" aria-hidden="true" />
                                <span>Night</span>
                            </span>
                        </div>
                        <div class="totals-table-row" role="row">
                            <strong role="rowheader">ICUS</strong>
                            <span role="cell">@FormatHoursTotal(entry => entry.SeIcusDay)</span>
                            <span role="cell">@FormatHoursTotal(entry => entry.SeIcusNight)</span>
                        </div>
                        <div class="totals-table-row" role="row">
                            <strong role="rowheader">Dual</strong>
                            <span role="cell">@FormatHoursTotal(entry => entry.SeDualDay)</span>
                            <span role="cell">@FormatHoursTotal(entry => entry.SeDualNight)</span>
                        </div>
                        <div class="totals-table-row" role="row">
                            <strong role="rowheader">Command</strong>
                            <span role="cell">@FormatHoursTotal(entry => entry.SeCommandDay)</span>
                            <span role="cell">@FormatHoursTotal(entry => entry.SeCommandNight)</span>
                        </div>
                    </div>
                </section>

                <section class="totals-group" aria-labelledby="multi-engine-totals-heading">
                    <div class="totals-group-heading">
                        <h3 id="multi-engine-totals-heading">Multi engine</h3>
                    </div>
                    <div class="totals-table" role="table" aria-label="Multi engine flying totals">
                        <div class="totals-table-row totals-table-header" role="row">
                            <span role="columnheader">Capacity</span>
                            <span class="totals-time-header" role="columnheader">
                                <MudIcon Icon="@Icons.Material.Filled.LightMode" aria-hidden="true" />
                                <span>Day</span>
                            </span>
                            <span class="totals-time-header" role="columnheader">
                                <MudIcon Icon="@Icons.Material.Filled.DarkMode" aria-hidden="true" />
                                <span>Night</span>
                            </span>
                        </div>
                        <div class="totals-table-row" role="row">
                            <strong role="rowheader">ICUS</strong>
                            <span role="cell">@FormatHoursTotal(entry => entry.MeIcusDay)</span>
                            <span role="cell">@FormatHoursTotal(entry => entry.MeIcusNight)</span>
                        </div>
                        <div class="totals-table-row" role="row">
                            <strong role="rowheader">Dual</strong>
                            <span role="cell">@FormatHoursTotal(entry => entry.MeDualDay)</span>
                            <span role="cell">@FormatHoursTotal(entry => entry.MeDualNight)</span>
                        </div>
                        <div class="totals-table-row" role="row">
                            <strong role="rowheader">Command</strong>
                            <span role="cell">@FormatHoursTotal(entry => entry.MeCommandDay)</span>
                            <span role="cell">@FormatHoursTotal(entry => entry.MeCommandNight)</span>
                        </div>
                    </div>
                </section>

                <section class="totals-group" aria-labelledby="other-time-totals-heading">
                    <div class="totals-group-heading">
                        <h3 id="other-time-totals-heading">Other time</h3>
                    </div>
                    <div class="totals-pair-list">
                        <div class="totals-pair-row">
                            <strong>Copilot</strong>
                            <span><small>Day</small> @FormatHoursTotal(entry => entry.CopilotDay)</span>
                            <span><small>Night</small> @FormatHoursTotal(entry => entry.CopilotNight)</span>
                        </div>
                        <div class="totals-pair-row">
                            <strong>Instrument</strong>
                            <span><small>Actual</small> @FormatHoursTotal(entry => entry.IfrIf)</span>
                            <span><small>Simulator</small> @FormatHoursTotal(entry => entry.IfrSim)</span>
                        </div>
                    </div>
                </section>

                <section class="totals-group" aria-labelledby="custom-field-totals-heading">
                    <div class="totals-group-heading">
                        <h3 id="custom-field-totals-heading">Custom fields</h3>
                    </div>
                    <div class="totals-count-grid">
                        @foreach (var total in CustomFieldTotals)
                        {
                            <StatusMetric Label="@total.Definition.Label" Value="@total.FormattedTotal" />
                        }
                    </div>
                </section>

                <section class="totals-group" aria-labelledby="movement-totals-heading">
                    <div class="totals-group-heading">
                        <h3 id="movement-totals-heading">Landings</h3>
                    </div>
                    <div class="totals-count-grid">
                        <StatusMetric Label="Day" Value="@(FormatCountTotal(entry => entry.LandingsDay))" />
                        <StatusMetric Label="Night" Value="@(FormatCountTotal(entry => entry.LandingsNight))" />
                    </div>
                </section>

                <section class="totals-group" aria-labelledby="approach-totals-heading">
                    <div class="totals-group-heading">
                        <h3 id="approach-totals-heading">Approaches</h3>
                    </div>
                    <div class="totals-count-grid totals-approach-grid">
                        <StatusMetric Label="ILS" Value="@(FormatCountTotal(entry => entry.Ils))" />
                        <StatusMetric Label="VOR" Value="@(FormatCountTotal(entry => entry.Vor))" />
                        <StatusMetric Label="RNP" Value="@(FormatCountTotal(entry => entry.Rnp))" />
                        <StatusMetric Label="NDB" Value="@(FormatCountTotal(entry => entry.Ndb))" />
                        <StatusMetric Label="DGA CDI" Value="@(FormatCountTotal(entry => entry.DgaCdi))" />
                        <StatusMetric Label="DGA AZI" Value="@(FormatCountTotal(entry => entry.DgaAzi))" />
                        <StatusMetric Label="Circling" Value="@(FormatCountTotal(entry => entry.Circling))" />
                    </div>
                </section>
            </section>
        }
        else
        {
            <section class="form-section deleted-entries-view">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Deletion history</span>
                        <h2>Deleted flights</h2>
                    </div>
                    <span class="draft-pill">@Session.DeletedEntriesV2.Count deleted</span>
                </div>
                <p class="totals-intro">Deleted flights remain available here. Open a flight to review its details or restore it to the active logbook.</p>

                @if (Session.DeletedEntriesV2.Count == 0)
                {
                    <section class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.RestoreFromTrash" />
                        <strong>No deleted flights</strong>
                        <span>Flights removed from the active logbook will appear here.</span>
                    </section>
                }
                else
                {
                    <div class="deleted-entry-list">
                        @foreach (var entry in Session.DeletedEntriesV2)
                        {
                            var flight = Session.FindLatestWorkbookEntryPayload(entry);
                            <NavLink class="deleted-entry-row" href="@($"/flights/{entry.EntryId.Value}")">
                                <span class="deleted-entry-summary">
                                    <strong>@(flight is null ? "Deleted flight" : Session.FormatRoute(flight))</strong>
                                    <span>@(flight is null ? "Flight details unavailable" : $"{MobileLogbookSession.FormatDate(flight.Date)} · {Session.FormatAircraft(flight)} · {Session.FormatRegistration(flight)}")</span>
                                </span>
                                <span class="deleted-entry-time">Deleted @MobileLogbookSession.FormatTimestamp(Session.FindOperationV2(entry.CurrentRevisionId).CreatedAt)</span>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" aria-hidden="true" />
                            </NavLink>
                        }
                    </div>
                }
            </section>
        }

        @if (Session.MergeResultV2.Conflicts.Count > 0)
        {
            <section class="form-section" role="alert">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Conflicts</span>
                        <h2>Needs review</h2>
                    </div>
                    <span class="draft-pill">@Session.MergeResultV2.Conflicts.Count unresolved</span>
                </div>
                @foreach (var conflict in Session.MergeResultV2.Conflicts)
                {
                    <div class="history-row">
                        <strong>Unresolved flight</strong>
                        <span>@string.Join(", ", conflict.HeadRevisionIds.Select(revision => revision.Value))</span>
                    </div>
                    <div class="flight-row-list">
                        @foreach (var revisionId in conflict.HeadRevisionIds)
                        {
                            var operation = Session.FindOperationV2(revisionId);
                            <article class="flight-row">
                                <div>
                                    <strong>@operation.Kind</strong>
                                    <span>@revisionId.Value</span>
                                </div>
                                <div>
                                    <strong>@(operation.Entry is null ? "Deleted entry" : Session.FormatRoute(operation.Entry))</strong>
                                    <span>@(operation.Entry is null ? "No active payload" : Session.FormatAircraft(operation.Entry))</span>
                                </div>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Session.ResolveWorkbookConflictAsync(conflict, revisionId))" Disabled="@Session.IsStorageBlocked">
                                    Keep
                                </MudButton>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    private LogbookView ActiveView { get; set; } = LogbookView.Entries;
    private string SearchText { get; set; } = string.Empty;
    private bool ShowFilters { get; set; }
    private bool FilterRecentOnly { get; set; }
    private bool FilterFlightsWithApproachesOnly { get; set; }
    private bool ShowTotalsFilters { get; set; }
    private string SelectedTotalsFilterFieldId { get; set; } = "date";
    private string TotalsFilterValueSearchText { get; set; } = string.Empty;
    private string? TotalsStartDateText { get; set; }
    private string? TotalsEndDateText { get; set; }
    private Dictionary<string, HashSet<string>> TotalsFilterSelections { get; } = new(StringComparer.Ordinal);
    private IReadOnlyList<MobileLogbookTotalsFilterField> totalsFilterFields = [];
    private IReadOnlyList<PortableLogbookMaterializedEntryV2> totalsEntries = [];
    private string EntriesTabClass => ActiveView == LogbookView.Entries ? "active" : string.Empty;
    private string TotalsTabClass => ActiveView == LogbookView.Totals ? "active" : string.Empty;
    private string DeletedTabClass => ActiveView == LogbookView.Deleted ? "active" : string.Empty;
    private string EntryCountLabel => Session.CurrentEntriesV2.Count == 1
        ? "1 active entry"
        : $"{Session.CurrentEntriesV2.Count} active entries";

    private IReadOnlyList<PortableLogbookMaterializedEntryV2> FilteredEntries =>
        Session.CurrentEntriesV2
            .Where(MatchesSearch)
            .Where(MatchesActiveFilters)
            .ToArray();

    private IReadOnlyList<MobileLogbookTotalsFilterField> TotalsFilterFields =>
        totalsFilterFields;

    private MobileLogbookTotalsFilterField SelectedTotalsFilterField =>
        TotalsFilterFields.FirstOrDefault(filterField => filterField.Id == SelectedTotalsFilterFieldId) ?? TotalsFilterFields[0];

    private IReadOnlyList<MobileLogbookTotalsFilterValue> SelectedTotalsFilterValues =>
        MobileLogbookTotalsFilters.Values(
            SelectedTotalsFilterField,
            Session.CurrentEntriesV2.Select(entry => entry.Entry!));

    private IReadOnlyList<MobileLogbookTotalsFilterValue> VisibleTotalsFilterValues =>
        SelectedTotalsFilterValues
            .Where(value => string.IsNullOrWhiteSpace(TotalsFilterValueSearchText) ||
                            value.Label.Contains(TotalsFilterValueSearchText, StringComparison.OrdinalIgnoreCase))
            .ToArray();

    private IReadOnlyList<PortableLogbookMaterializedEntryV2> TotalsEntries =>
        totalsEntries;

    private IReadOnlyList<KeyValuePair<string, HashSet<string>>> ActiveTotalsFilterSelections =>
        TotalsFilterSelections
            .Where(selection => TotalsFilterFields.Any(filterField => filterField.Id == selection.Key))
            .ToArray();

    private DateOnly? TotalsStartDate => ParseTotalsDate(TotalsStartDateText);
    private DateOnly? TotalsEndDate => ParseTotalsDate(TotalsEndDateText);
    private bool HasTotalsDateRange => TotalsStartDate is not null || TotalsEndDate is not null;
    private int TotalsFilterCount => ActiveTotalsFilterSelections.Count + (HasTotalsDateRange ? 1 : 0);

    private string TotalsFilterButtonLabel => TotalsFilterCount == 0
        ? "Filter totals"
        : $"Filters ({TotalsFilterCount})";

    private string TotalsEntryCountLabel => TotalsFilterCount == 0
        ? EntryCountLabel
        : $"{TotalsEntries.Count} of {Session.CurrentEntriesV2.Count} active entries included";

    private string TotalsDateRangeSummary => (TotalsStartDate, TotalsEndDate) switch
    {
        ({ } start, { } end) => $"{FormatFilterDate(start)} to {FormatFilterDate(end)}",
        ({ } start, null) => $"From {FormatFilterDate(start)}",
        (null, { } end) => $"Up to {FormatFilterDate(end)}",
        _ => "All dates"
    };

    private IReadOnlyList<MobileCustomFieldTotal> CustomFieldTotals =>
        MobileCustomFieldTotals.Calculate(
            Session.WorkbookCustomFields,
            TotalsEntries.Select(entry => entry.Entry!));

    private string FormatHoursTotal(Func<PortableLogbookWorkbookEntry, decimal?> column) =>
        MobileLogbookSession.FormatHours(TotalsEntries.Sum(entry => column(entry.Entry!).GetValueOrDefault()));

    private string FormatCountTotal(Func<PortableLogbookWorkbookEntry, int?> column) =>
        TotalsEntries.Sum(entry => column(entry.Entry!).GetValueOrDefault()).ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        Session.WorkbookStateChanged += OnWorkbookStateChanged;
        await Session.EnsureLoadedWorkbookAsync();
        RefreshTotalsProjection();
    }

    private void OnWorkbookStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshTotalsProjection();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Session.WorkbookStateChanged -= OnWorkbookStateChanged;
    }

    protected override void OnParametersSet()
    {
        ActiveView = View?.ToLowerInvariant() switch
        {
            "totals" => LogbookView.Totals,
            "deleted" => LogbookView.Deleted,
            _ => LogbookView.Entries
        };
    }

    private void SelectView(LogbookView view)
    {
        if (ActiveView == view)
        {
            return;
        }

        ActiveView = view;
        var queryValue = view switch
        {
            LogbookView.Totals => "totals",
            LogbookView.Deleted => "deleted",
            _ => "entries"
        };
        Navigation.NavigateTo($"/flights?view={queryValue}");
    }

    private bool MatchesSearch(PortableLogbookMaterializedEntryV2 materialized)
    {
        if (string.IsNullOrWhiteSpace(SearchText) || materialized.Entry is null)
        {
            return true;
        }

        var entry = materialized.Entry;
        var haystack = string.Join(" ", entry.Reg, entry.From, entry.To, entry.Via, entry.Type, entry.Remarks);
        return haystack.Contains(SearchText, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesActiveFilters(PortableLogbookMaterializedEntryV2 materialized)
    {
        if (materialized.Entry is null)
        {
            return false;
        }

        if (FilterRecentOnly && materialized.Entry.Date < DateOnly.FromDateTime(DateTime.Today.AddDays(-90)))
        {
            return false;
        }

        return !FilterFlightsWithApproachesOnly || CountApproaches(materialized.Entry) > 0;
    }

    private void ClearFilters()
    {
        FilterRecentOnly = false;
        FilterFlightsWithApproachesOnly = false;
    }

    private void OnTotalsFilterFieldChanged(ChangeEventArgs args)
    {
        SelectedTotalsFilterFieldId = args.Value?.ToString() ?? TotalsFilterFields[0].Id;
        TotalsFilterValueSearchText = string.Empty;
    }

    private void OnTotalsStartDateChanged(ChangeEventArgs args)
    {
        TotalsStartDateText = args.Value?.ToString();
        RefreshTotalsProjection();
    }

    private void OnTotalsEndDateChanged(ChangeEventArgs args)
    {
        TotalsEndDateText = args.Value?.ToString();
        RefreshTotalsProjection();
    }

    private bool IsTotalsFilterValueSelected(string valueKey) =>
        !TotalsFilterSelections.TryGetValue(SelectedTotalsFilterField.Id, out var selectedValues) ||
        selectedValues.Contains(valueKey);

    private void ToggleTotalsFilterValue(string valueKey, ChangeEventArgs args)
    {
        var fieldId = SelectedTotalsFilterField.Id;
        if (!TotalsFilterSelections.TryGetValue(fieldId, out var selectedValues))
        {
            selectedValues = SelectedTotalsFilterValues
                .Select(value => value.Key)
                .ToHashSet(StringComparer.Ordinal);
            TotalsFilterSelections[fieldId] = selectedValues;
        }

        if (args.Value is true)
        {
            selectedValues.Add(valueKey);
        }
        else
        {
            selectedValues.Remove(valueKey);
        }

        var allValueKeys = SelectedTotalsFilterValues.Select(value => value.Key).ToHashSet(StringComparer.Ordinal);
        if (selectedValues.SetEquals(allValueKeys))
        {
            TotalsFilterSelections.Remove(fieldId);
        }

        RefreshTotalsProjection();
    }

    private void SelectAllTotalsFilterValues()
    {
        TotalsFilterSelections.Remove(SelectedTotalsFilterField.Id);
        RefreshTotalsProjection();
    }

    private void SelectNoTotalsFilterValues()
    {
        TotalsFilterSelections[SelectedTotalsFilterField.Id] = new HashSet<string>(StringComparer.Ordinal);
        RefreshTotalsProjection();
    }

    private void ClearTotalsFilter(string fieldId)
    {
        TotalsFilterSelections.Remove(fieldId);
        RefreshTotalsProjection();
    }

    private void ClearAllTotalsFilters()
    {
        TotalsFilterSelections.Clear();
        TotalsStartDateText = null;
        TotalsEndDateText = null;
        RefreshTotalsProjection();
    }

    private void ClearTotalsDateRange()
    {
        TotalsStartDateText = null;
        TotalsEndDateText = null;
        RefreshTotalsProjection();
    }

    private string TotalsFilterSelectionSummary(
        MobileLogbookTotalsFilterField field,
        HashSet<string> selectedValues)
    {
        var labels = MobileLogbookTotalsFilters.Values(
                field,
                Session.CurrentEntriesV2.Select(entry => entry.Entry!))
            .Where(value => selectedValues.Contains(value.Key))
            .Select(value => value.Label)
            .ToArray();

        return labels.Length switch
        {
            0 => "No values selected",
            <= 2 => string.Join(" or ", labels),
            _ => $"{labels.Length} values selected"
        };
    }

    private void RefreshTotalsProjection()
    {
        totalsFilterFields = MobileLogbookTotalsFilters.CreateFields(Session.WorkbookCustomFields);
        var validFieldIds = totalsFilterFields.Select(filterField => filterField.Id).ToHashSet(StringComparer.Ordinal);
        foreach (var staleFieldId in TotalsFilterSelections.Keys.Where(fieldId => !validFieldIds.Contains(fieldId)).ToArray())
        {
            TotalsFilterSelections.Remove(staleFieldId);
        }

        if (!validFieldIds.Contains(SelectedTotalsFilterFieldId))
        {
            SelectedTotalsFilterFieldId = totalsFilterFields[0].Id;
            TotalsFilterValueSearchText = string.Empty;
        }

        totalsEntries = Session.CurrentEntriesV2
            .Where(materialized => materialized.Entry is not null &&
                                   MobileLogbookTotalsFilters.Matches(
                                       materialized.Entry,
                                       TotalsFilterSelections,
                                       totalsFilterFields,
                                       TotalsStartDate,
                                       TotalsEndDate))
            .ToArray();
    }

    private static DateOnly? ParseTotalsDate(string? value) =>
        DateOnly.TryParseExact(
            value,
            "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out var date)
                ? date
                : null;

    private static string FormatFilterDate(DateOnly date) =>
        date.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    private static int CountApproaches(PortableLogbookWorkbookEntry entry) =>
        MobileLogbookSession.WorkbookApproaches(entry);

    private enum LogbookView
    {
        Entries,
        Totals,
        Deleted
    }
}
