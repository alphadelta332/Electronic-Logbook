@page "/flights"
@inject MobileLogbookSession Session
@inject NavigationManager Navigation

<PageTitle>Logbook</PageTitle>

@if (!Session.IsLoaded)
{
    <section class="ui-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <span>Loading logbook</span>
    </section>
}
else
{
    <section class="logbook-page">
        <header class="entry-header">
            <div>
                <span class="eyebrow">Logbook</span>
                <h1>Flight record</h1>
            </div>
            <span class="draft-pill">@(Session.CurrentEntriesV2.Count == 1 ? "1 entry" : $"{Session.CurrentEntriesV2.Count} entries")</span>
        </header>

        @if (Session.ShouldShowLastActionMessage(MobileActionMessageSurface.Logbook))
        {
            <section class="state-banner" role="status">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" />
                <span>@Session.LastActionMessage</span>
            </section>
        }

        <div class="segmented-control" role="tablist" aria-label="Logbook view">
            <button type="button" class="@EntriesTabClass" @onclick="() => SelectViewAsync(LogbookView.Entries)">Entries</button>
            <button type="button" class="@TotalsTabClass" @onclick="() => SelectViewAsync(LogbookView.Totals)">Totals</button>
        </div>

        @if (IsViewSwitchPending)
        {
            <section class="view-progress" role="status" aria-live="polite">
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <span>Opening @PendingViewLabel</span>
            </section>
        }

        @if (ActiveView == LogbookView.Entries)
        {
            <section class="form-section">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Entries</span>
                        <h2>Current record</h2>
                    </div>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList" OnClick="@(() => ShowFilters = !ShowFilters)">
                        Filters
                    </MudButton>
                </div>

                <label class="search-field">
                    Search
                    <input @bind="SearchText" @bind:event="oninput" placeholder="Rego, route, type, remarks" />
                </label>

                @if (ShowFilters)
                {
                    <section class="filter-sheet" aria-label="Logbook filters">
                        <label>
                            <input type="checkbox" @bind="FilterRecentOnly" />
                            Last 90 days
                        </label>
                        <label>
                            <input type="checkbox" @bind="FilterFlightsWithApproachesOnly" />
                            Approaches logged
                        </label>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearFilters">Clear</MudButton>
                    </section>
                }

                @if (FilteredEntries.Count == 0)
                {
                    <section class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.Flight" />
                        <strong>No matching flights</strong>
                        <span>Import a package, add a flight from Dashboard, or clear search.</span>
                    </section>
                }
                else
                {
                    <div class="flight-row-list">
                        @foreach (var entry in FilteredEntries)
                        {
                            <LogbookFlightRow Entry="@entry" />
                        }
                    </div>
                }
            </section>
        }
        else
        {
            <section class="form-section">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Totals</span>
                        <h2>Logged columns</h2>
                    </div>
                </div>
                <h3>Single engine</h3>
                <section class="totals-subgroup" aria-label="Single engine ICUS totals">
                    <h4>ICUS</h4>
                    <div class="totals-grid">
                        <StatusMetric Label="Day" Value="@(FormatHoursTotal(entry => entry.SeIcusDay))" />
                        <StatusMetric Label="Night" Value="@(FormatHoursTotal(entry => entry.SeIcusNight))" />
                    </div>
                </section>
                <section class="totals-subgroup" aria-label="Single engine dual totals">
                    <h4>Dual</h4>
                    <div class="totals-grid">
                        <StatusMetric Label="Day" Value="@(FormatHoursTotal(entry => entry.SeDualDay))" />
                        <StatusMetric Label="Night" Value="@(FormatHoursTotal(entry => entry.SeDualNight))" />
                    </div>
                </section>
                <section class="totals-subgroup" aria-label="Single engine command totals">
                    <h4>Command</h4>
                    <div class="totals-grid">
                        <StatusMetric Label="Day" Value="@(FormatHoursTotal(entry => entry.SeCommandDay))" />
                        <StatusMetric Label="Night" Value="@(FormatHoursTotal(entry => entry.SeCommandNight))" />
                    </div>
                </section>
                <h3>Multi engine</h3>
                <section class="totals-subgroup" aria-label="Multi engine ICUS totals">
                    <h4>ICUS</h4>
                    <div class="totals-grid">
                        <StatusMetric Label="Day" Value="@(FormatHoursTotal(entry => entry.MeIcusDay))" />
                        <StatusMetric Label="Night" Value="@(FormatHoursTotal(entry => entry.MeIcusNight))" />
                    </div>
                </section>
                <section class="totals-subgroup" aria-label="Multi engine dual totals">
                    <h4>Dual</h4>
                    <div class="totals-grid">
                        <StatusMetric Label="Day" Value="@(FormatHoursTotal(entry => entry.MeDualDay))" />
                        <StatusMetric Label="Night" Value="@(FormatHoursTotal(entry => entry.MeDualNight))" />
                    </div>
                </section>
                <section class="totals-subgroup" aria-label="Multi engine command totals">
                    <h4>Command</h4>
                    <div class="totals-grid">
                        <StatusMetric Label="Day" Value="@(FormatHoursTotal(entry => entry.MeCommandDay))" />
                        <StatusMetric Label="Night" Value="@(FormatHoursTotal(entry => entry.MeCommandNight))" />
                    </div>
                </section>
                <h3>Other time</h3>
                <div class="totals-grid">
                    <StatusMetric Label="Copilot day" Value="@(FormatHoursTotal(entry => entry.CopilotDay))" Detail="hours" />
                    <StatusMetric Label="Copilot night" Value="@(FormatHoursTotal(entry => entry.CopilotNight))" Detail="hours" />
                    <StatusMetric Label="IFR actual" Value="@(FormatHoursTotal(entry => entry.IfrIf))" Detail="hours" />
                    <StatusMetric Label="IFR sim" Value="@(FormatHoursTotal(entry => entry.IfrSim))" Detail="hours" />
                    <StatusMetric Label="Day landings" Value="@(FormatCountTotal(entry => entry.LandingsDay))" Detail="count" />
                    <StatusMetric Label="Night landings" Value="@(FormatCountTotal(entry => entry.LandingsNight))" Detail="count" />
                </div>
                <h3>Approach types</h3>
                <div class="totals-grid">
                    <StatusMetric Label="ILS" Value="@(FormatCountTotal(entry => entry.Ils))" Detail="approaches" />
                    <StatusMetric Label="VOR" Value="@(FormatCountTotal(entry => entry.Vor))" Detail="approaches" />
                    <StatusMetric Label="RNP" Value="@(FormatCountTotal(entry => entry.Rnp))" Detail="approaches" />
                    <StatusMetric Label="NDB" Value="@(FormatCountTotal(entry => entry.Ndb))" Detail="approaches" />
                    <StatusMetric Label="DGA CDI" Value="@(FormatCountTotal(entry => entry.DgaCdi))" Detail="approaches" />
                    <StatusMetric Label="DGA AZI" Value="@(FormatCountTotal(entry => entry.DgaAzi))" Detail="approaches" />
                    <StatusMetric Label="Circling" Value="@(FormatCountTotal(entry => entry.Circling))" Detail="approaches" />
                </div>
                @if (Session.DeletedEntriesV2.Count > 0)
                {
                    <section class="history-panel">
                        <div class="section-title-row">
                            <div>
                                <span class="eyebrow">Deletion history</span>
                                <h2>Removed entries</h2>
                            </div>
                            <span class="draft-pill">@Session.DeletedEntriesV2.Count deleted</span>
                        </div>
                        @foreach (var entry in Session.DeletedEntriesV2)
                        {
                            <NavLink class="history-row" href="@($"/flights/{entry.EntryId.Value}")">
                                <strong>Deleted flight</strong>
                                <span>@MobileLogbookSession.FormatTimestamp(Session.FindOperationV2(entry.CurrentRevisionId).CreatedAt)</span>
                            </NavLink>
                        }
                    </section>
                }
            </section>
        }

        @if (Session.MergeResultV2.Conflicts.Count > 0)
        {
            <section class="form-section" role="alert">
                <div class="section-title-row">
                    <div>
                        <span class="eyebrow">Conflicts</span>
                        <h2>Needs review</h2>
                    </div>
                    <span class="draft-pill">@Session.MergeResultV2.Conflicts.Count unresolved</span>
                </div>
                @foreach (var conflict in Session.MergeResultV2.Conflicts)
                {
                    <div class="history-row">
                        <strong>Unresolved flight</strong>
                        <span>@string.Join(", ", conflict.HeadRevisionIds.Select(revision => revision.Value))</span>
                    </div>
                    <div class="flight-row-list">
                        @foreach (var revisionId in conflict.HeadRevisionIds)
                        {
                            var operation = Session.FindOperationV2(revisionId);
                            <article class="flight-row">
                                <div>
                                    <strong>@operation.Kind</strong>
                                    <span>@revisionId.Value</span>
                                </div>
                                <div>
                                    <strong>@(operation.Entry is null ? "Deleted entry" : Session.FormatRoute(operation.Entry))</strong>
                                    <span>@(operation.Entry is null ? "No active payload" : Session.FormatAircraft(operation.Entry))</span>
                                </div>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Session.ResolveWorkbookConflictAsync(conflict, revisionId))" Disabled="@Session.IsStorageBlocked">
                                    Keep
                                </MudButton>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    private LogbookView ActiveView { get; set; } = LogbookView.Entries;
    private string SearchText { get; set; } = string.Empty;
    private bool ShowFilters { get; set; }
    private bool FilterRecentOnly { get; set; }
    private bool FilterFlightsWithApproachesOnly { get; set; }
    private bool IsViewSwitchPending { get; set; }
    private string PendingViewLabel { get; set; } = "view";

    private string EntriesTabClass => ActiveView == LogbookView.Entries ? "active" : string.Empty;
    private string TotalsTabClass => ActiveView == LogbookView.Totals ? "active" : string.Empty;

    private IReadOnlyList<PortableLogbookMaterializedEntryV2> FilteredEntries =>
        Session.CurrentEntriesV2
            .Where(MatchesSearch)
            .Where(MatchesActiveFilters)
            .ToArray();

    private string FormatHoursTotal(Func<PortableLogbookWorkbookEntry, decimal?> column) =>
        MobileLogbookSession.FormatHours(Session.CurrentEntriesV2.Sum(entry => column(entry.Entry!).GetValueOrDefault()));

    private string FormatCountTotal(Func<PortableLogbookWorkbookEntry, int?> column) =>
        Session.CurrentEntriesV2.Sum(entry => column(entry.Entry!).GetValueOrDefault()).ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedWorkbookAsync();
    }

    protected override void OnParametersSet()
    {
        ActiveView = string.Equals(View, "totals", StringComparison.OrdinalIgnoreCase)
            ? LogbookView.Totals
            : LogbookView.Entries;
    }

    private async Task SelectViewAsync(LogbookView view)
    {
        if (ActiveView == view)
        {
            return;
        }

        PendingViewLabel = view == LogbookView.Totals ? "Totals" : "Entries";
        IsViewSwitchPending = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        ActiveView = view;
        IsViewSwitchPending = false;
        Navigation.NavigateTo($"/flights?view={(view == LogbookView.Totals ? "totals" : "entries")}");
    }

    private bool MatchesSearch(PortableLogbookMaterializedEntryV2 materialized)
    {
        if (string.IsNullOrWhiteSpace(SearchText) || materialized.Entry is null)
        {
            return true;
        }

        var entry = materialized.Entry;
        var haystack = string.Join(" ", entry.Reg, entry.From, entry.To, entry.Via, entry.Type, entry.Remarks);
        return haystack.Contains(SearchText, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesActiveFilters(PortableLogbookMaterializedEntryV2 materialized)
    {
        if (materialized.Entry is null)
        {
            return false;
        }

        if (FilterRecentOnly && materialized.Entry.Date < DateOnly.FromDateTime(DateTime.Today.AddDays(-90)))
        {
            return false;
        }

        return !FilterFlightsWithApproachesOnly || CountApproaches(materialized.Entry) > 0;
    }

    private void ClearFilters()
    {
        FilterRecentOnly = false;
        FilterFlightsWithApproachesOnly = false;
    }

    private static int CountApproaches(PortableLogbookWorkbookEntry entry) =>
        MobileLogbookSession.WorkbookApproaches(entry);

    private enum LogbookView
    {
        Entries,
        Totals
    }
}
