<div class="entry-fields-layout">
    @foreach (var group in Groups)
    {
        <section class="entry-category" aria-label="@group.Title">
            <h2>@group.Title</h2>
            <ResponsiveHours Class="entry-subsections">
                @foreach (var section in group.Sections)
                {
                    @if (section.Key != Subsection.Custom || ShowCustom)
                    {
                        <section class="entry-field-card" aria-label="@section.Title">
                            <header class="entry-field-card-heading">
                                <MudIcon Icon="@section.Icon" Class="entry-field-card-icon" aria-hidden="true" />
                                <h3>@section.Title</h3>
                            </header>
                            <div class="entry-field-card-content">@ChildContent(section.Key)</div>
                        </section>
                    }
                }
            </ResponsiveHours>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment<Subsection> ChildContent { get; set; } = default!;
    [Parameter] public bool ShowCustom { get; set; } = true;

    public enum Subsection { Details, Crew, Route, SingleEngine, MultiEngine, OtherTime, Custom, Landings, InstrumentApproaches }

    private sealed record EntryGroup(string Title, (Subsection Key, string Title, string Icon)[] Sections);

    private static readonly EntryGroup[] Groups =
    [
        new("Flight", [(Subsection.Details, "Details", Icons.Material.Filled.Flight),
            (Subsection.Crew, "Crew", Icons.Material.Filled.People), (Subsection.Route, "Route", Icons.Material.Filled.Route)]),
        new("Hours", [(Subsection.SingleEngine, "Single Engine", MobileAircraftIcons.SingleEngine),
            (Subsection.MultiEngine, "Multi Engine", MobileAircraftIcons.MultiEngine),
            (Subsection.OtherTime, "Other time", Icons.Material.Filled.AvTimer), (Subsection.Custom, "Custom", Icons.Material.Filled.DashboardCustomize)]),
        new("Recency", [(Subsection.Landings, "Landings", Icons.Material.Filled.FlightLand),
            (Subsection.InstrumentApproaches, "Instrument Approaches", Icons.Material.Filled.GpsFixed)])
    ];
}
