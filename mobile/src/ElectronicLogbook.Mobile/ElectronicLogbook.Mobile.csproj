<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <VersionManifestPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\versions.properties'))</VersionManifestPath>
    <VersionManifestText>$([System.IO.File]::ReadAllText('$(VersionManifestPath)'))</VersionManifestText>
    <AppVersionFromManifest>$([System.Text.RegularExpressions.Regex]::Match('$(VersionManifestText)', '(?m)^app_version=(\d+\.\d+\.\d+)\s*$').Groups[1].Value)</AppVersionFromManifest>
    <Version>$(AppVersionFromManifest)</Version>
  </PropertyGroup>

  <Target Name="ValidateAppVersionManifest" BeforeTargets="GenerateAssemblyInfo">
    <Error Condition="'$(AppVersionFromManifest)' == ''"
           Text="versions.properties must contain app_version in numeric major.minor.patch form." />
  </Target>

  <Target Name="ValidateChartDependency" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\..\node_modules\echarts\dist\echarts.common.min.js')"
           Text="Mobile chart assets are missing. Run npm.cmd ci from mobile/ before building." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\updater\src\ElectronicLogbook.Portable\ElectronicLogbook.Portable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
    <Content Include="..\..\node_modules\echarts\dist\echarts.common.min.js" Link="wwwroot\js\vendor\echarts.min.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\node_modules\echarts\LICENSE" Link="wwwroot\js\vendor\echarts-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\node_modules\echarts\NOTICE" Link="wwwroot\js\vendor\echarts-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\node_modules\zrender\LICENSE" Link="wwwroot\js\vendor\zrender-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\airports.json.gz" LogicalName="ElectronicLogbook.Mobile.Data.airports.json.gz" />
    <EmbeddedResource Include="Templates\LogbookExportCompact.xlsx" LogicalName="ElectronicLogbook.Mobile.Templates.LogbookExportCompact.xlsx" />
    <EmbeddedResource Include="Templates\LogbookExportFull.xlsx" LogicalName="ElectronicLogbook.Mobile.Templates.LogbookExportFull.xlsx" />
  </ItemGroup>

</Project>
