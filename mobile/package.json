{
  "name": "electronic-logbook-mobile-shell",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "generate:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Generate-AppIcons.ps1",
    "publish:pwa": "dotnet publish src/ElectronicLogbook.Mobile/ElectronicLogbook.Mobile.csproj -c Release -o artifacts/pages",
    "prepare:android-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Prepare-CapacitorAssets.ps1",
    "sync:android": "npm run generate:icons && npm run publish:pwa && npm run prepare:android-assets && capacitor sync android",
    "build:android": "npm run sync:android && cd android && gradlew.bat assembleDebug",
    "build:android:acceptance": "npm run sync:android && cd android && gradlew.bat assembleAcceptance",
    "build:android:pilot": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-AndroidPilot.ps1",
    "install:visual-browser": "playwright install chromium",
    "capture:visual": "npm run publish:pwa && node scripts/capture-pwa-visual-audit.mjs",
    "install:android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-AndroidDebugBuild.ps1",
    "install:android:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-AndroidAcceptanceBuild.ps1",
    "test:acceptance-prep": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-MobileAcceptancePrep.ps1",
    "test:acceptance-package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-MobileAcceptancePackage.ps1",
    "receive:android-export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Receive-AndroidExport.ps1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/network": "8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "8.5.0",
    "playwright": "1.55.1"
  }
}
