{
  "name": "electronic-logbook-mobile-shell",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "publish:pwa": "dotnet publish src/ElectronicLogbook.Mobile/ElectronicLogbook.Mobile.csproj -c Release -o artifacts/pages",
    "prepare:android-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Prepare-CapacitorAssets.ps1",
    "sync:android": "npm run publish:pwa && npm run prepare:android-assets && capacitor sync android",
    "build:android": "npm run sync:android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2"
  }
}
